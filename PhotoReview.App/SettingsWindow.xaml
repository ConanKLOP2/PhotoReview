<Window x:Class="PhotoReview.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photo Review - Settings" Width="520" Height="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#202020" Foreground="#EEEEEE">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Cài đặt" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Folder chuyển tới (loại 2)" Margin="0,7,10,7"/>
            <TextBox x:Name="Folder2Text" Grid.Column="1" Padding="6" Margin="0,3,0,5"/>
            <TextBlock Text="Phím ảnh tiếp theo" Grid.Row="1" Margin="0,7,10,7"/>
            <TextBox x:Name="NextText" Grid.Row="1" Grid.Column="1" Padding="6" Margin="0,3,0,5"/>
            <TextBlock Text="Phím ảnh trước" Grid.Row="2" Margin="0,7,10,7"/>
            <TextBox x:Name="PreviousText" Grid.Row="2" Grid.Column="1" Padding="6" Margin="0,3,0,5"/>
            <TextBlock Text="Phím chuyển loại 2" Grid.Row="3" Margin="0,7,10,7"/>
            <TextBox x:Name="MoveText" Grid.Row="3" Grid.Column="1" Padding="6" Margin="0,3,0,5"/>
            <TextBlock Text="Phím đưa vào thùng rác" Grid.Row="4" Margin="0,7,10,7"/>
            <TextBox x:Name="RecycleText" Grid.Row="4" Grid.Column="1" Padding="6" Margin="0,3,0,5"/>
            <TextBlock Text="Chế độ mở ảnh" Grid.Row="5" Margin="0,7,10,7"/>
            <ComboBox x:Name="ViewModeCombo" Grid.Row="5" Grid.Column="1" Padding="6" Margin="0,3,0,5">
                <ComboBoxItem Content="Fit"/>
                <ComboBoxItem Content="100%"/>
                <ComboBoxItem Content="200%"/>
                <ComboBoxItem Content="400%"/>
            </ComboBox>
            <TextBlock Text="Chế độ tải ảnh" Grid.Row="6" Margin="0,7,10,7"/>
            <ComboBox x:Name="LoadingModeCombo" Grid.Row="6" Grid.Column="1" Padding="6" Margin="0,3,0,5">
                <ComboBoxItem Content="Fast"/>
                <ComboBoxItem Content="Preview"/>
            </ComboBox>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Khôi phục mặc định" Click="Defaults_Click" Padding="12,7" Margin="0,0,8,0"/>
            <Button Content="Hủy" IsCancel="True" Padding="16,7" Margin="0,0,8,0"/>
            <Button Content="Lưu" IsDefault="True" Click="Save_Click" Padding="18,7"/>
        </StackPanel>
    </Grid>
</Window>
