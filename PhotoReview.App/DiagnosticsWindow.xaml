<Window x:Class="PhotoReview.App.DiagnosticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Diagnostics" Width="520" Height="360" WindowStartupLocation="CenterOwner" Background="#171717" Foreground="#F5F5F5">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Performance diagnostics" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Số liệu chỉ tồn tại trong phiên hiện tại; không gửi ra ngoài." Foreground="#AAAAAA" Margin="0,6,0,16"/></StackPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="Cache hits"/><TextBlock x:Name="CacheHitsText" Grid.Column="1"/>
            <TextBlock Text="Cache misses" Grid.Row="1"/><TextBlock x:Name="CacheMissesText" Grid.Row="1" Grid.Column="1"/>
            <TextBlock Text="Cache hit rate" Grid.Row="2"/><TextBlock x:Name="HitRateText" Grid.Row="2" Grid.Column="1"/>
            <TextBlock Text="Source bytes read" Grid.Row="3"/><TextBlock x:Name="SourceBytesText" Grid.Row="3" Grid.Column="1"/>
            <TextBlock Text="Decode time" Grid.Row="4"/><TextBlock x:Name="DecodeTimeText" Grid.Row="4" Grid.Column="1"/>
        </Grid><Button Grid.Row="2" Content="Đóng" IsCancel="True" HorizontalAlignment="Right" Padding="18,8" Margin="0,16,0,0"/>
    </Grid>
</Window>
