{
  "stryker-config": {
    "test-case-filter": "Category!=Manual&Category!=Native&Category!=Slow",
    "reporters": ["json", "html", "progress"],
    "thresholds": { "high": 80, "low": 60, "break": 0 },
    "ignore-methods": ["*Log.*", "*Logger.*", "ILog.*", "*.Dispose", "*.ToString"],
    "ignore-mutations": ["string", "regex"],
    "mutation-level": "Basic",
    "configuration": "Release"
  }
}