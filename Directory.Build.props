<Project>

  <!-- Centralized settings shared by all projects in the solution.
       Only properties with identical values across every .csproj are placed
       here; per-project settings (OutputType, UseWPF, UseWindowsForms,
       RuntimeIdentifiers, Platforms, etc.) remain in their own project files. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
