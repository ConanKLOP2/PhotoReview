<Project>

  <!-- Centralized settings shared by all projects in the solution.
       Includes global compiler, code style, and analyzer settings.
       Per-project settings (OutputType, UseWPF, UseWindowsForms,
       RuntimeIdentifiers, Platforms, etc.) remain in their own .csproj files. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- AR12b: Release is the shipped configuration, so a new warning there must fail the build
       rather than slip into a release silently. Debug stays warning-only so the IDE inner loop
       is not blocked by a warning mid-edit. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
