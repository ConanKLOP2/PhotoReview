<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>AnyCPU;x64</Platforms>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PhotoReview.App\PhotoReview.App.csproj" />
    <ProjectReference Include="..\..\src\PhotoReview.Core\PhotoReview.Core.csproj" />
    <ProjectReference Include="..\..\src\PhotoReview.Imaging\PhotoReview.Imaging.csproj" />
    <!-- D11: PerfAnalyze (perf-analyze CLI) lives in PhotoReview.Tests (the CLI test runner)
         rather than duplicating it here. PhotoReview.Tests is an Exe project, but referencing it
         works the same as any other ProjectReference: this project gets its public types
         (PerfAnalyze, PerfAnalyzeNavBuilder, PerfRules, ...) without pulling in its top-level Main. -->
    <ProjectReference Include="..\PhotoReview.Tests\PhotoReview.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="PhotoReview.Core.Settings" />
    <Using Include="PhotoReview.Core.FileActions" />
    <Using Include="PhotoReview.Core.Session" />
    <Using Include="PhotoReview.Imaging" />
    <Using Include="PhotoReview.Imaging.Caching" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
