<Window x:Class="PhotoReview.App.RecoveryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PhotoReview.App.Localization" Title="{loc:Tr recovery.title}" Width="820" Height="520" MinWidth="600" MinHeight="380" WindowStartupLocation="CenterOwner" Background="#171717" Foreground="#F5F5F5">
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{loc:Tr recovery.header}" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="SummaryText" Foreground="#BBBBBB" Margin="0,6,0,14"/></StackPanel>
        <ListBox x:Name="EntriesList" Grid.Row="1" Background="#252525" Foreground="#FFFFFF"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RetryButton" Content="{loc:Tr recovery.retry}" AutomationProperties.Name="{loc:Tr recovery.retry.automationName}" Click="Retry_Click" Padding="14,8" Margin="0,0,8,0" IsEnabled="False"/>
            <Button Content="{loc:Tr common.close}" IsCancel="True" Padding="18,8"/>
        </StackPanel>
    </Grid>
</Window>
