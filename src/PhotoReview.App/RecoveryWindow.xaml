<Window x:Class="PhotoReview.App.RecoveryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PhotoReview.App.Localization" xmlns:local="clr-namespace:PhotoReview.App" Title="{loc:Tr recovery.title}" Width="1120" Height="700" MinWidth="820" MinHeight="480" WindowStartupLocation="CenterOwner" Background="{DynamicResource Dark.Window}" Foreground="{DynamicResource Dark.WindowText}">
    <Window.Resources><ResourceDictionary Source="/PhotoReview.App;component/Themes/DarkControls.xaml"/></Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{loc:Tr recovery.header}" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="SummaryText" Foreground="{DynamicResource Dark.TextSecondary}" Margin="0,6,0,10" TextWrapping="Wrap"/></StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock Text="{loc:Tr recovery.filter.label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="FilterCombo" Width="170" SelectedIndex="0" AutomationProperties.Name="{loc:Tr recovery.filter.automationName}" SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="{loc:Tr recovery.filter.all}"/>
                <ComboBoxItem Content="{loc:Tr recovery.filter.canRetry}"/>
                <ComboBoxItem Content="{loc:Tr recovery.filter.alreadyDone}"/>
                <ComboBoxItem Content="{loc:Tr recovery.filter.problems}"/>
            </ComboBox>
            <Button x:Name="RecheckButton" Content="{loc:Tr recovery.check.recheck}" AutomationProperties.Name="{loc:Tr recovery.check.recheck.automationName}" Click="Recheck_Click" Padding="14,5" Margin="12,0,0,0"/>
            <TextBlock x:Name="CheckStatusText" Foreground="{DynamicResource Dark.TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
            <Grid>
                <ListBox x:Name="EntriesList" Background="{DynamicResource Dark.Input}" Foreground="{DynamicResource Dark.TextStrong}" SelectionMode="Extended" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:RecoveryRow}">
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Dark.TextMuted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="1" BorderBrush="{Binding BadgeBrush}" BorderThickness="1" CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Dark.Panel}">
                                    <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeBrush}" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="FilterEmptyText" Text="{loc:Tr recovery.filter.empty}" Foreground="{DynamicResource Dark.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <Grid Grid.Column="2">
                <TextBlock x:Name="DetailsEmptyText" Text="{loc:Tr recovery.detail.empty}" Foreground="{DynamicResource Dark.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="0,0,6,0">
                        <Border Background="{DynamicResource Dark.Panel}" BorderBrush="{DynamicResource Dark.Border}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Tr recovery.detail.verdict}" Foreground="{DynamicResource Dark.TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border x:Name="VerdictBadge" BorderThickness="1" CornerRadius="9" Padding="10,2" Background="{DynamicResource Dark.Panel}"><TextBlock x:Name="VerdictText" FontWeight="SemiBold"/></Border>
                                </StackPanel>
                                <TextBlock x:Name="ExplainText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{loc:Tr recovery.detail.action}" Foreground="{DynamicResource Dark.TextMuted}" Margin="0,10,0,0"/>
                                <TextBlock x:Name="ActionText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Dark.ErrorText}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <local:RecoveryPathPanel x:Name="SourcePanel"/>
                        <local:RecoveryPathPanel x:Name="DestinationPanel"/>
                        <TextBlock x:Name="NoDestinationText" Text="{loc:Tr recovery.detail.noDestination}" Foreground="{DynamicResource Dark.TextMuted}" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ClearSelectedButton" Content="{loc:Tr recovery.clearSelected}" AutomationProperties.Name="{loc:Tr recovery.clearSelected.automationName}" Click="ClearSelected_Click" Padding="14,8" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="ClearAllButton" Content="{loc:Tr recovery.clearAll}" AutomationProperties.Name="{loc:Tr recovery.clearAll.automationName}" Click="ClearAll_Click" Padding="14,8" Margin="0,0,24,0" IsEnabled="False"/>
            <Button x:Name="RetryButton" Content="{loc:Tr recovery.retry}" AutomationProperties.Name="{loc:Tr recovery.retry.automationName}" Click="Retry_Click" Padding="14,8" Margin="0,0,8,0" IsEnabled="False"/>
            <Button Content="{loc:Tr common.close}" IsCancel="True" Padding="18,8"/>
        </StackPanel>
    </Grid>
</Window>
