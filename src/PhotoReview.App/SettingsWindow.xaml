<Window x:Class="PhotoReview.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PhotoReview.App.Localization"
        Title="{loc:Tr settings.window.title}" Width="900" Height="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="760" MinHeight="560" Background="{DynamicResource Dark.Window}" Foreground="{DynamicResource Dark.WindowText}" Loaded="SettingsWindow_Loaded" PreviewKeyDown="SettingsWindow_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PhotoReview.App;component/Themes/DarkControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.Resources>
            <!-- Local tweaks live one level below the Window so BasedOn={StaticResource {x:Type ...}} resolves to the
                 dark theme styles merged into Window.Resources (inside the same dictionary it resolved to the system style). -->
            <!-- Form spacing: label column vertically centred on its input. -->
            <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,10"/>
            </Style>
            <Style x:Key="HelpText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{DynamicResource Dark.TextMuted}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style x:Key="PageHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Dark.TextStrong}"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>
            <Style x:Key="SectionCard" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,0,0,10"/></Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,0,0,10"/></Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0,2,0,10"/></Style>
            <Style x:Key="ShortcutBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Width" Value="110"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="ShortcutLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,8"/>
            </Style>
            <Style x:Key="ClearShortcutButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Margin" Value="4,0,0,8"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Left navigation -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="{loc:Tr settings.header}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Dark.TextStrong}" Margin="0,0,0,12"/>
                <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Foreground="{DynamicResource Dark.TextFaint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <ListBox x:Name="NavList" DockPanel.Dock="Top" BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="{loc:Tr settings.nav.automationName}"
                         KeyboardNavigation.TabNavigation="Once" SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem x:Name="NavGeneral" Tag="General" Content="{loc:Tr settings.nav.general}"/>
                    <ListBoxItem x:Name="NavDisplay" Tag="Display" Content="{loc:Tr settings.nav.display}"/>
                    <ListBoxItem x:Name="NavMouse" Tag="Mouse" Content="{loc:Tr settings.nav.mouse}"/>
                    <ListBoxItem x:Name="NavPerformance" Tag="Performance" Content="{loc:Tr settings.nav.performance}"/>
                    <ListBoxItem x:Name="NavShortcuts" Tag="Shortcuts" Content="{loc:Tr settings.nav.shortcuts}"/>
                    <ListBoxItem x:Name="NavFiles" Tag="Files" Content="{loc:Tr settings.nav.files}"/>
                    <ListBoxItem x:Name="NavDiagnostics" Tag="Diagnostics" Content="{loc:Tr settings.nav.diagnostics}"/>
                </ListBox>
            </DockPanel>

            <!-- Right content -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="PageTitleText" Grid.Row="0" Style="{StaticResource PageHeading}"/>

                <!-- ============ Chung / General ============ -->
                <ScrollViewer x:Name="GeneralScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False">
                    <StackPanel x:Name="GeneralPage" KeyboardNavigation.TabNavigation="Local">
                        <GroupBox x:Name="LanguageGroup" Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.language}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{loc:Tr settings.language.label}" Grid.Row="0" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="LanguageCombo" Grid.Row="0" Grid.Column="1" DisplayMemberPath="DisplayName" AutomationProperties.Name="{loc:Tr settings.language.automationName}"/>
                            <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                <Button Content="{loc:Tr settings.language.openFolder}" Click="OpenLanguagesFolder_Click" Margin="0,0,8,4"/>
                                <Button Content="{loc:Tr settings.language.reload}" Click="ReloadTranslations_Click" Margin="0,0,8,4"/>
                                <Button Content="{loc:Tr settings.language.export}" ToolTip="{loc:Tr settings.language.export.toolTip}" Click="ExportTranslation_Click" Margin="0,0,0,4"/>
                            </WrapPanel>
                            <TextBlock Text="{loc:Tr settings.language.hint}" Grid.Row="2" Grid.Column="1" Style="{StaticResource HelpText}"/>
                        </Grid></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.nav.general}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="SortModeLabel" Text="{loc:Tr settings.sortMode.label}" Grid.Row="0" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="SortModeCombo" AutomationProperties.LabeledBy="{Binding ElementName=SortModeLabel}" Grid.Row="0" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.imageSortMode.name}" Tag="Name"/><ComboBoxItem Content="{loc:Tr enum.imageSortMode.nameAscending}" Tag="NameAscending"/><ComboBoxItem Content="{loc:Tr enum.imageSortMode.nameDescending}" Tag="NameDescending"/><ComboBoxItem Content="{loc:Tr enum.imageSortMode.sizeDescending}" Tag="SizeDescending"/><ComboBoxItem Content="{loc:Tr enum.imageSortMode.sizeAscending}" Tag="SizeAscending"/><ComboBoxItem Content="{loc:Tr enum.imageSortMode.default}" Tag="Default"/></ComboBox>
                            <TextBlock Text="{loc:Tr settings.sortMode.hint}" Grid.Row="1" Grid.Column="1" Style="{StaticResource HelpText}"/>
                            <TextBlock x:Name="ViewModeLabel" Text="{loc:Tr settings.viewMode.label}" Grid.Row="2" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="ViewModeCombo" AutomationProperties.LabeledBy="{Binding ElementName=ViewModeLabel}" Grid.Row="2" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.initialViewMode.fit}"/><ComboBoxItem Content="{loc:Tr enum.initialViewMode.fitWidth}"/><ComboBoxItem Content="{loc:Tr enum.initialViewMode.fitHeight}"/><ComboBoxItem Content="{loc:Tr enum.initialViewMode.clickZoomLevel}"/><ComboBoxItem Content="100%"/><ComboBoxItem Content="200%"/></ComboBox>
                            <TextBlock x:Name="InstanceModeLabel" Text="{loc:Tr settings.instanceMode.label}" Grid.Row="3" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="InstanceModeCombo" AutomationProperties.LabeledBy="{Binding ElementName=InstanceModeLabel}" Grid.Row="3" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.instanceMode.singleWindow}"/><ComboBoxItem Content="{loc:Tr enum.instanceMode.perFolder}"/></ComboBox>
                            <TextBlock Text="{loc:Tr settings.instanceMode.hint}" Grid.Row="4" Grid.Column="1" Style="{StaticResource HelpText}"/>
                        </Grid></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr update.section.title}"><StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckUpdateButton" Content="{loc:Tr update.check.button}" AutomationProperties.Name="{loc:Tr update.check.button}" Click="CheckUpdate_Click" Margin="0,0,8,0"/>
                                <Button x:Name="OpenUpdatePageButton" Content="{loc:Tr update.openPage.button}" AutomationProperties.Name="{loc:Tr update.openPage.button}" Click="OpenUpdatePage_Click" Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="{loc:Tr update.hint}" Style="{StaticResource HelpText}" Margin="0,8,0,0"/>
                        </StackPanel></GroupBox>

                        <!-- Explorer integration: "Browse with PhotoReview" on folders (per user, HKCU); applies immediately, not on Save. -->
                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.shell.group}"><StackPanel>
                            <TextBlock x:Name="ShellStatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="ShellAddButton" Content="{loc:Tr settings.shell.add}" AutomationProperties.Name="{loc:Tr settings.shell.add}" Click="ShellAdd_Click" Margin="0,0,8,0"/>
                                <Button x:Name="ShellRemoveButton" Content="{loc:Tr settings.shell.remove}" AutomationProperties.Name="{loc:Tr settings.shell.remove}" Click="ShellRemove_Click"/>
                            </StackPanel>
                            <TextBlock Text="{loc:Tr settings.shell.hint}" Style="{StaticResource HelpText}" Margin="0,8,0,0"/>
                        </StackPanel></GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Hiển thị / Display ============ -->
                <ScrollViewer x:Name="DisplayScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False" Visibility="Collapsed">
                    <StackPanel x:Name="DisplayPage" KeyboardNavigation.TabNavigation="Local">
                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.nav.display}"><StackPanel>
                            <CheckBox x:Name="ShowInfoOverlayCheck" Content="{loc:Tr settings.showInfoOverlay.label}" Checked="ShowInfoOverlayCheck_CheckedChanged" Unchecked="ShowInfoOverlayCheck_CheckedChanged"/>
                            <StackPanel Margin="20,0,0,0">
                                <CheckBox x:Name="ShowFileInfoCheck" Content="{loc:Tr settings.showFileInfo.label}"/>
                                <CheckBox x:Name="ShowFolderInfoCheck" Content="{loc:Tr settings.showFolderInfo.label}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="20,8,0,0">
                                <TextBlock x:Name="InfoOverlayFontSizeLabel" Text="{loc:Tr settings.infoOverlayFontSize.label}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox x:Name="InfoOverlayFontSizeBox" Width="70" AutomationProperties.LabeledBy="{Binding ElementName=InfoOverlayFontSizeLabel}" AutomationProperties.Name="{loc:Tr settings.infoOverlayFontSize.automationName}" Margin="0"/>
                            </StackPanel>
                            <CheckBox x:Name="ShowZoomIndicatorCheck" Content="{loc:Tr settings.showZoomIndicator.label}"/>
                        </StackPanel></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.toolbar}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <CheckBox x:Name="ToolbarAutoHideCheck" Grid.Row="0" Grid.ColumnSpan="2" Content="{loc:Tr settings.toolbarAutoHide.label}" Checked="ToolbarAutoHideCheck_CheckedChanged" Unchecked="ToolbarAutoHideCheck_CheckedChanged"/>
                            <TextBlock x:Name="ToolbarAutoHideDelayLabel" Text="{loc:Tr settings.toolbarAutoHideDelay.label}" Grid.Row="1" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="ToolbarAutoHideDelayBox" AutomationProperties.LabeledBy="{Binding ElementName=ToolbarAutoHideDelayLabel}" AutomationProperties.Name="{loc:Tr settings.toolbarAutoHideDelay.automationName}" Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource HelpText}" Text="{loc:Tr settings.toolbarAutoHide.hint}"/>
                            <!-- Q-R34: toolbar opacity while visible, [MinToolbarOpacityPercent, 100]; applies on Save. -->
                            <TextBlock x:Name="ToolbarOpacityLabel" Text="{loc:Tr settings.toolbarOpacity.label}" Grid.Row="3" Style="{StaticResource FormLabel}" Margin="0,10,12,10"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,10">
                                <Slider x:Name="ToolbarOpacitySlider" Width="260" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"
                                        AutomationProperties.Name="{loc:Tr settings.toolbarOpacity.automationName}" ValueChanged="ToolbarOpacitySlider_ValueChanged"/>
                                <TextBlock x:Name="ToolbarOpacityValueText" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                            <TextBlock x:Name="ToolbarOpacityHint" Grid.Row="4" Grid.Column="1" Style="{StaticResource HelpText}"/>
                        </Grid></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.infoOverlay}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <CheckBox x:Name="InfoOverlayAutoHideCheck" Grid.Row="0" Grid.ColumnSpan="2" Content="{loc:Tr settings.infoOverlayAutoHide.label}" AutomationProperties.Name="{loc:Tr settings.infoOverlayAutoHide.automationName}" Checked="InfoOverlayAutoHideCheck_CheckedChanged" Unchecked="InfoOverlayAutoHideCheck_CheckedChanged"/>
                            <TextBlock x:Name="InfoOverlayAutoHideDelayLabel" Text="{loc:Tr settings.infoOverlayAutoHideDelay.label}" Grid.Row="1" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="InfoOverlayAutoHideDelayBox" AutomationProperties.LabeledBy="{Binding ElementName=InfoOverlayAutoHideDelayLabel}" AutomationProperties.Name="{loc:Tr settings.infoOverlayAutoHideDelay.automationName}" Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource HelpText}" Text="{loc:Tr settings.infoOverlayAutoHide.hint}"/>
                        </Grid></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.displayPerformance}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="LoadingModeLabel" Text="{loc:Tr settings.loadingMode.label}" Grid.Row="0" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="LoadingModeCombo" AutomationProperties.LabeledBy="{Binding ElementName=LoadingModeLabel}" Grid.Row="0" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.loadingMode.fast}"/><ComboBoxItem Content="{loc:Tr enum.loadingMode.preview}"/><ComboBoxItem Content="{loc:Tr settings.loadingMode.originalWithHint}" Tag="Original"/></ComboBox>
                            <TextBlock Text="{loc:Tr settings.scalingQuality.label}" Grid.Row="1" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="ScalingQualityCombo" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="{loc:Tr settings.scalingQuality.automationName}" Margin="0,0,0,0"><ComboBoxItem Content="{loc:Tr enum.scalingQuality.highQuality}"/><ComboBoxItem Content="{loc:Tr enum.scalingQuality.linear}"/></ComboBox>
                        </Grid></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.exif}"><StackPanel x:Name="ExifSettingsHost">
                            <CheckBox x:Name="ShowExifInfoCheck" Content="{loc:Tr settings.showExifInfo.label}" Checked="ShowExifInfoCheck_CheckedChanged" Unchecked="ShowExifInfoCheck_CheckedChanged"/>
                            <TextBlock Text="{loc:Tr settings.group.exif.hint}" Style="{StaticResource HelpText}" Margin="20,0,0,8"/>
                            <WrapPanel Margin="20,0,0,0">
                                <CheckBox x:Name="ExifFieldFileNameCheck" Content="{loc:Tr settings.exifField.fileName}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldDateTakenCheck" Content="{loc:Tr settings.exifField.dateTaken}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldModifiedDateCheck" Content="{loc:Tr settings.exifField.modifiedDate}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldDimensionsCheck" Content="{loc:Tr settings.exifField.dimensions}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldCameraCheck" Content="{loc:Tr settings.exifField.camera}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldLensCheck" Content="{loc:Tr settings.exifField.lens}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldIsoCheck" Content="{loc:Tr settings.exifField.iso}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldFocalLengthCheck" Content="{loc:Tr settings.exifField.focalLength}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldApertureCheck" Content="{loc:Tr settings.exifField.aperture}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldShutterSpeedCheck" Content="{loc:Tr settings.exifField.shutterSpeed}" Margin="0,2,16,10"/>
                            </WrapPanel>
                        </StackPanel></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.titleBar}"><StackPanel>
                            <TextBlock Text="{loc:Tr settings.group.titleBar.hint}" Style="{StaticResource HelpText}" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <CheckBox x:Name="TitleBarFieldFolderNameCheck" Content="{loc:Tr settings.titleBarField.folderName}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldFolderPathCheck" Content="{loc:Tr settings.titleBarField.folderPath}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldIndexCountCheck" Content="{loc:Tr settings.titleBarField.indexCount}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldFileNameCheck" Content="{loc:Tr settings.exifField.fileName}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldFileSizeCheck" Content="{loc:Tr settings.titleBarField.fileSize}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldDimensionsCheck" Content="{loc:Tr settings.exifField.dimensions}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldModifiedDateCheck" Content="{loc:Tr settings.exifField.modifiedDate}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldDateTakenCheck" Content="{loc:Tr settings.exifField.dateTaken}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldCameraCheck" Content="{loc:Tr settings.exifField.camera}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldLensCheck" Content="{loc:Tr settings.exifField.lens}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldIsoCheck" Content="{loc:Tr settings.exifField.iso}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldFocalLengthCheck" Content="{loc:Tr settings.exifField.focalLength}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldApertureCheck" Content="{loc:Tr settings.exifField.aperture}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldShutterSpeedCheck" Content="{loc:Tr settings.exifField.shutterSpeed}" Margin="0,2,16,10"/>
                            </WrapPanel>
                        </StackPanel></GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Chuột & Zoom / Mouse & zoom ============ -->
                <ScrollViewer x:Name="MouseScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False" Visibility="Collapsed">
                    <StackPanel x:Name="MousePage" KeyboardNavigation.TabNavigation="Local">
                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.zoom}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="ClickZoomPercentLabel" Text="{loc:Tr settings.clickZoomPercent.label}" Grid.Row="0" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="ClickZoomPercentBox" AutomationProperties.LabeledBy="{Binding ElementName=ClickZoomPercentLabel}" AutomationProperties.Name="{loc:Tr settings.clickZoomPercent.automationName}" Grid.Row="0" Grid.Column="1" Width="90" HorizontalAlignment="Left"/>
                            <TextBlock Text="{loc:Tr settings.clickZoomPercent.hint}" Grid.Row="1" Grid.Column="1" Style="{StaticResource HelpText}"/>
                            <CheckBox x:Name="ClickToZoomCheck" Grid.Row="2" Grid.Column="1" Content="{loc:Tr settings.clickToZoom.label}"/>
                            <TextBlock x:Name="ArrowPanStepLabel" Text="{loc:Tr settings.arrowPanStepPercent.label}" Grid.Row="3" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="ArrowPanStepBox" AutomationProperties.LabeledBy="{Binding ElementName=ArrowPanStepLabel}" AutomationProperties.Name="{loc:Tr settings.arrowPanStepPercent.automationName}" Grid.Row="3" Grid.Column="1" Width="90" HorizontalAlignment="Left"/>
                            <TextBlock Text="{loc:Tr settings.arrowPanStepPercent.hint}" Grid.Row="4" Grid.Column="1" Style="{StaticResource HelpText}"/>
                            <TextBlock x:Name="KeyboardZoomAnchorLabel" Text="{loc:Tr settings.keyboardZoomAnchor.label}" Grid.Row="5" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="KeyboardZoomAnchorCombo" AutomationProperties.LabeledBy="{Binding ElementName=KeyboardZoomAnchorLabel}" AutomationProperties.Name="{loc:Tr settings.keyboardZoomAnchor.automationName}" Grid.Row="5" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.keyboardZoomAnchor.pointer}"/><ComboBoxItem Content="{loc:Tr enum.keyboardZoomAnchor.viewportCentre}"/></ComboBox>
                            <TextBlock Text="{loc:Tr settings.keyboardZoomAnchor.hint}" Grid.Row="6" Grid.Column="1" Style="{StaticResource HelpText}"/>
                            <TextBlock Text="{loc:Tr settings.zoomShortcuts.title}" Grid.Row="7" Style="{StaticResource FormLabel}"/>
                            <TextBlock x:Name="ZoomShortcutsSummary" Grid.Row="7" Grid.Column="1" TextWrapping="Wrap" AutomationProperties.Name="{loc:Tr settings.zoomShortcuts.automationName}"/>
                            <TextBlock Text="{loc:Tr settings.zoomShortcuts.hint}" Grid.Row="8" Grid.Column="1" Style="{StaticResource HelpText}"/>
                            <TextBlock x:Name="FitWidthAnchorLabel" Text="{loc:Tr settings.fitWidthAnchor.label}" Grid.Row="9" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="FitWidthAnchorCombo" AutomationProperties.LabeledBy="{Binding ElementName=FitWidthAnchorLabel}" AutomationProperties.Name="{loc:Tr settings.fitWidthAnchor.automationName}" Grid.Row="9" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.fitWidthAnchor.centre}"/><ComboBoxItem Content="{loc:Tr enum.fitWidthAnchor.topThird}"/><ComboBoxItem Content="{loc:Tr enum.fitWidthAnchor.bottomThird}"/></ComboBox>
                            <TextBlock Text="{loc:Tr settings.fitWidthAnchor.hint}" Grid.Row="10" Grid.Column="1" Style="{StaticResource HelpText}"/>
                            <CheckBox x:Name="KeepZoomAcrossImagesCheck" Grid.Row="11" Grid.Column="1" Content="{loc:Tr settings.keepZoomAcrossImages.label}" AutomationProperties.Name="{loc:Tr settings.keepZoomAcrossImages.automationName}"/>
                            <TextBlock Text="{loc:Tr settings.keepZoomAcrossImages.hint}" Grid.Row="12" Grid.Column="1" Style="{StaticResource HelpText}"/>
                            <TextBlock x:Name="KeyboardZoomStepPercentLabel" Text="{loc:Tr settings.keyboardZoomStepPercent.label}" Grid.Row="13" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="KeyboardZoomStepPercentBox" AutomationProperties.LabeledBy="{Binding ElementName=KeyboardZoomStepPercentLabel}" AutomationProperties.Name="{loc:Tr settings.keyboardZoomStepPercent.automationName}" Grid.Row="13" Grid.Column="1" Width="90" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="KeyboardZoomStepPercentHint" Grid.Row="14" Grid.Column="1" Style="{StaticResource HelpText}"/>
                            <TextBlock x:Name="FitWidthAnchor2Label" Text="{loc:Tr settings.fitWidthAnchor2.label}" Grid.Row="15" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="FitWidthAnchor2Combo" AutomationProperties.LabeledBy="{Binding ElementName=FitWidthAnchor2Label}" AutomationProperties.Name="{loc:Tr settings.fitWidthAnchor2.automationName}" Grid.Row="15" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.fitWidthAnchor.centre}"/><ComboBoxItem Content="{loc:Tr enum.fitWidthAnchor.topThird}"/><ComboBoxItem Content="{loc:Tr enum.fitWidthAnchor.bottomThird}"/></ComboBox>
