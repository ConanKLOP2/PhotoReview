                            <TextBlock Text="{loc:Tr settings.middleClickAction.hint}" Grid.Row="18" Grid.Column="1" Style="{StaticResource HelpText}"/>
                            <CheckBox x:Name="ClickZoomKeyTogglesFitCheck" Grid.Row="19" Grid.Column="1" Content="{loc:Tr settings.clickZoomKeyTogglesFit.label}" AutomationProperties.Name="{loc:Tr settings.clickZoomKeyTogglesFit.automationName}"/>
                            <TextBlock Text="{loc:Tr settings.clickZoomKeyTogglesFit.hint}" Grid.Row="20" Grid.Column="1" Style="{StaticResource HelpText}"/>
                        </Grid></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.mouseZoom}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="MouseWheelActionLabel" Text="{loc:Tr settings.mouseWheelAction.label}" Grid.Row="0" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="MouseWheelActionCombo" AutomationProperties.LabeledBy="{Binding ElementName=MouseWheelActionLabel}" AutomationProperties.Name="{loc:Tr settings.mouseWheelAction.automationName}" Grid.Row="0" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.mouseWheelAction.zoom}"/><ComboBoxItem Content="{loc:Tr enum.mouseWheelAction.navigate}"/></ComboBox>
                            <TextBlock Text="{loc:Tr settings.mouseWheelAction.hint}" Grid.Row="1" Grid.Column="1" Style="{StaticResource HelpText}"/>
                            <CheckBox x:Name="KineticPanCheck" Grid.Row="2" Grid.Column="1" Content="{loc:Tr settings.kineticPan.label}"/>
                            <TextBlock x:Name="KineticGlideSmoothingLabel" Text="{loc:Tr settings.kineticGlideSmoothing.label}" Grid.Row="3" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="KineticGlideSmoothingCombo" AutomationProperties.LabeledBy="{Binding ElementName=KineticGlideSmoothingLabel}" AutomationProperties.Name="{loc:Tr settings.kineticGlideSmoothing.automationName}" Grid.Row="3" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.kineticGlideSmoothing.off}"/><ComboBoxItem Content="{loc:Tr enum.kineticGlideSmoothing.predict}"/></ComboBox>
                            <TextBlock Text="{loc:Tr settings.kineticGlideSmoothing.hint}" Grid.Row="4" Grid.Column="1" Style="{StaticResource HelpText}"/>
                            <CheckBox x:Name="ArrowKeyNavigatesAtZoomEdgeCheck" AutomationProperties.Name="{loc:Tr settings.arrowKeyNavigatesAtZoomEdge.automationName}" Grid.Row="5" Grid.Column="1" Content="{loc:Tr settings.arrowKeyNavigatesAtZoomEdge.label}"/>
                            <TextBlock Text="{loc:Tr settings.arrowKeyNavigatesAtZoomEdge.hint}" Grid.Row="6" Grid.Column="1" Style="{StaticResource HelpText}"/>
                            <!-- feat/image-crossfade: optional fade when the CURRENT PHOTO CHANGES (not on thumbnail/preview/original upgrades of the same image). -->
                            <TextBlock x:Name="ImageTransitionLabel" Text="{loc:Tr settings.imageTransition.label}" Grid.Row="7" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="ImageTransitionCombo" AutomationProperties.LabeledBy="{Binding ElementName=ImageTransitionLabel}" AutomationProperties.Name="{loc:Tr settings.imageTransition.automationName}" Grid.Row="7" Grid.Column="1" SelectionChanged="ImageTransitionCombo_SelectionChanged"><ComboBoxItem Content="{loc:Tr enum.imageTransition.none}"/><ComboBoxItem Content="{loc:Tr enum.imageTransition.fade}"/></ComboBox>
                            <TextBlock Text="{loc:Tr settings.imageTransition.hint}" Grid.Row="8" Grid.Column="1" Style="{StaticResource HelpText}"/>
                            <TextBlock x:Name="ImageTransitionMsLabel" Text="{loc:Tr settings.imageTransitionMs.label}" Grid.Row="9" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="ImageTransitionMsBox" AutomationProperties.LabeledBy="{Binding ElementName=ImageTransitionMsLabel}" AutomationProperties.Name="{loc:Tr settings.imageTransitionMs.automationName}" Grid.Row="9" Grid.Column="1" Width="90" HorizontalAlignment="Left"/>
                        </Grid></GroupBox>

                        <!-- PR-C feat/context-menu-redesign -->
                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.contextMenu}"><StackPanel>
                            <TextBlock Text="{loc:Tr settings.contextMenu.hint}" Style="{StaticResource HelpText}" Margin="0,0,0,8"/>
                            <!-- One check box per right-click menu item, built in code from ContextMenuItems.Items (stable ids). -->
                            <StackPanel x:Name="ContextMenuItemsHost" KeyboardNavigation.TabNavigation="Local"/>
                        </StackPanel></GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Hiệu năng / Performance ============ -->
                <ScrollViewer x:Name="PerformanceScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False" Visibility="Collapsed">
                    <StackPanel x:Name="PerformancePage" KeyboardNavigation.TabNavigation="Local">
                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.nav.performance}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{loc:Tr settings.decoderBackend.label}" Grid.Row="0" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="DecoderBackendCombo" Grid.Row="0" Grid.Column="1" AutomationProperties.Name="{loc:Tr settings.decoderBackend.automationName}"><ComboBoxItem Content="{loc:Tr enum.decoderBackend.wpf}"/><ComboBoxItem Content="{loc:Tr enum.decoderBackend.wicDirect}"/><ComboBoxItem x:Name="TurboJpegOption" Content="{loc:Tr enum.decoderBackend.turboJpeg}"/></ComboBox>
                            <!-- RAM%: in-memory preview cache share of physical RAM, [system minimum, 90]; applies after restart. -->
                            <TextBlock x:Name="RamCacheLabel" Text="{loc:Tr settings.ramCache.label}" Grid.Row="1" Style="{StaticResource FormLabel}" Margin="0,10,12,10"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,10">
                                <Slider x:Name="RamCacheSlider" Width="260" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="5"
                                        AutomationProperties.Name="{loc:Tr settings.ramCache.automationName}" ValueChanged="RamCacheSlider_ValueChanged"/>
                                <TextBlock x:Name="RamCacheValueText" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                            <TextBlock x:Name="RamCacheHint" Grid.Row="2" Grid.Column="1" Style="{StaticResource HelpText}"/>
                            <!-- feat/preload-window-setting: forward/backward preload window, [PerformanceOptions bounds]; applies after restart. -->
                            <TextBlock x:Name="PreloadForwardLabel" Text="{loc:Tr settings.preloadForward.label}" Grid.Row="3" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="PreloadForwardBox" AutomationProperties.LabeledBy="{Binding ElementName=PreloadForwardLabel}" AutomationProperties.Name="{loc:Tr settings.preloadForward.automationName}" Grid.Row="3" Grid.Column="1" Width="90" HorizontalAlignment="Left" TextChanged="PreloadWindow_TextChanged"/>
                            <TextBlock x:Name="PreloadBackwardLabel" Text="{loc:Tr settings.preloadBackward.label}" Grid.Row="4" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="PreloadBackwardBox" AutomationProperties.LabeledBy="{Binding ElementName=PreloadBackwardLabel}" AutomationProperties.Name="{loc:Tr settings.preloadBackward.automationName}" Grid.Row="4" Grid.Column="1" Width="90" HorizontalAlignment="Left" TextChanged="PreloadWindow_TextChanged"/>
                            <TextBlock x:Name="PreloadWindowHint" Grid.Row="5" Grid.Column="1" Style="{StaticResource HelpText}"/>
                        </Grid></GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Phím tắt / Shortcuts ============ -->
                <ScrollViewer x:Name="ShortcutsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False" Visibility="Collapsed">
                    <StackPanel x:Name="ShortcutsPage" KeyboardNavigation.TabNavigation="Local">
                        <TextBlock Text="{loc:Tr settings.group.shortcuts.hint}" Style="{StaticResource HelpText}"/>
                        <TextBlock x:Name="ShortcutDuplicateWarningText" Style="{StaticResource HelpText}" Foreground="{DynamicResource Dark.Warning}" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.navigation}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="NextLabel" Grid.Row="0" Grid.Column="0" Text="{loc:Tr settings.shortcut.next}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="NextText" AutomationProperties.LabeledBy="{Binding ElementName=NextLabel}" Style="{StaticResource ShortcutBox}"/>
                            <TextBlock x:Name="PreviousLabel" Grid.Row="1" Grid.Column="0" Text="{loc:Tr settings.shortcut.previous}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="PreviousText" AutomationProperties.LabeledBy="{Binding ElementName=PreviousLabel}" Style="{StaticResource ShortcutBox}"/>
                            <TextBlock x:Name="FirstImageLabel" Grid.Row="2" Grid.Column="0" Text="{loc:Tr settings.shortcut.firstImage}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="FirstImageText" AutomationProperties.LabeledBy="{Binding ElementName=FirstImageLabel}" Style="{StaticResource ShortcutBox}"/>
                            <TextBlock x:Name="OpenFolderLabel" Grid.Row="3" Grid.Column="0" Text="{loc:Tr settings.shortcut.openFolder}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="OpenFolderText" AutomationProperties.LabeledBy="{Binding ElementName=OpenFolderLabel}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="3" Grid.Column="1" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.openFolder.clearAutomationName}" Click="ClearOpenFolder_Click"/>
                            <TextBlock x:Name="ToggleCaptureMemberLabel" Grid.Row="4" Grid.Column="0" Text="{loc:Tr settings.shortcut.toggleCaptureMember}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="4" Grid.Column="1" x:Name="ToggleCaptureMemberText" AutomationProperties.LabeledBy="{Binding ElementName=ToggleCaptureMemberLabel}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="4" Grid.Column="1" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.toggleCaptureMember.clearAutomationName}" Click="ClearToggleCaptureMember_Click"/>
                            <TextBlock x:Name="LastImageLabel" Grid.Row="0" Grid.Column="3" Text="{loc:Tr settings.shortcut.lastImage}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="0" Grid.Column="4" x:Name="LastImageText" AutomationProperties.LabeledBy="{Binding ElementName=LastImageLabel}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="0" Grid.Column="4" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.lastImage.clearAutomationName}" Click="ClearLastImage_Click"/>
                            <TextBlock x:Name="NextFolderLabel" Grid.Row="1" Grid.Column="3" Text="{loc:Tr settings.shortcut.nextFolder}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="1" Grid.Column="4" x:Name="NextFolderText" AutomationProperties.LabeledBy="{Binding ElementName=NextFolderLabel}" Style="{StaticResource ShortcutBox}"/>
                            <TextBlock x:Name="PreviousFolderLabel" Grid.Row="2" Grid.Column="3" Text="{loc:Tr settings.shortcut.previousFolder}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="2" Grid.Column="4" x:Name="PreviousFolderText" AutomationProperties.LabeledBy="{Binding ElementName=PreviousFolderLabel}" Style="{StaticResource ShortcutBox}"/>
                        </Grid></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.view}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="ZoomInLabel" Grid.Row="0" Grid.Column="0" Text="{loc:Tr settings.shortcut.zoomIn}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="ZoomInText" AutomationProperties.LabeledBy="{Binding ElementName=ZoomInLabel}" Style="{StaticResource ShortcutBox}"/>
                            <TextBlock x:Name="ZoomOutLabel" Grid.Row="1" Grid.Column="0" Text="{loc:Tr settings.shortcut.zoomOut}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="ZoomOutText" AutomationProperties.LabeledBy="{Binding ElementName=ZoomOutLabel}" Style="{StaticResource ShortcutBox}"/>
                            <TextBlock x:Name="ToggleFitLabel" Grid.Row="2" Grid.Column="0" Text="{loc:Tr settings.shortcut.toggleFit}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="ToggleFitText" AutomationProperties.LabeledBy="{Binding ElementName=ToggleFitLabel}" Style="{StaticResource ShortcutBox}"/>
                            <TextBlock x:Name="ClickZoomLabel" Grid.Row="3" Grid.Column="0" Text="{loc:Tr settings.shortcut.clickZoom}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="ClickZoomText" AutomationProperties.LabeledBy="{Binding ElementName=ClickZoomLabel}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="3" Grid.Column="1" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.clickZoom.clearAutomationName}" Click="ClearClickZoom_Click"/>
                            <TextBlock x:Name="FitHeightLabel" Grid.Row="4" Grid.Column="0" Text="{loc:Tr settings.shortcut.fitHeight}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="4" Grid.Column="1" x:Name="FitHeightText" AutomationProperties.LabeledBy="{Binding ElementName=FitHeightLabel}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="4" Grid.Column="1" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.fitHeight.clearAutomationName}" Click="ClearFitHeight_Click"/>
                            <TextBlock x:Name="CustomZoomLabel" Grid.Row="5" Grid.Column="0" Text="{loc:Tr settings.shortcut.customZoom}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="5" Grid.Column="1" x:Name="CustomZoomText" AutomationProperties.LabeledBy="{Binding ElementName=CustomZoomLabel}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="5" Grid.Column="1" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.customZoom.clearAutomationName}" Click="ClearCustomZoom_Click"/>
                            <TextBlock x:Name="ZoomActualSizeLabel" Grid.Row="0" Grid.Column="3" Text="{loc:Tr settings.shortcut.zoomActualSize}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="0" Grid.Column="4" x:Name="ZoomActualSizeText" AutomationProperties.LabeledBy="{Binding ElementName=ZoomActualSizeLabel}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="0" Grid.Column="4" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.zoomActualSize.clearAutomationName}" Click="ClearZoomActualSize_Click"/>
                            <TextBlock x:Name="FullscreenLabel" Grid.Row="1" Grid.Column="3" Text="{loc:Tr settings.shortcut.fullscreen}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="1" Grid.Column="4" x:Name="FullscreenText" AutomationProperties.LabeledBy="{Binding ElementName=FullscreenLabel}" Style="{StaticResource ShortcutBox}"/>
                            <TextBlock x:Name="ToggleInfoOverlayLabel" Grid.Row="2" Grid.Column="3" Text="{loc:Tr settings.shortcut.toggleInfoOverlay}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="2" Grid.Column="4" x:Name="ToggleInfoOverlayText" AutomationProperties.LabeledBy="{Binding ElementName=ToggleInfoOverlayLabel}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="2" Grid.Column="4" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.toggleInfoOverlay.clearAutomationName}" Click="ClearToggleInfoOverlay_Click"/>
                            <TextBlock x:Name="FitWidthLabel" Grid.Row="3" Grid.Column="3" Text="{loc:Tr settings.shortcut.fitWidth}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="3" Grid.Column="4" x:Name="FitWidthText" AutomationProperties.LabeledBy="{Binding ElementName=FitWidthLabel}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="3" Grid.Column="4" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.fitWidth.clearAutomationName}" Click="ClearFitWidth_Click"/>
                            <TextBlock x:Name="ToggleKeepZoomLabel" Grid.Row="4" Grid.Column="3" Text="{loc:Tr settings.shortcut.toggleKeepZoom}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="4" Grid.Column="4" x:Name="ToggleKeepZoomText" AutomationProperties.LabeledBy="{Binding ElementName=ToggleKeepZoomLabel}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="4" Grid.Column="4" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.toggleKeepZoom.clearAutomationName}" Click="ClearToggleKeepZoom_Click"/>
                            <TextBlock x:Name="FitWidth2Label" Grid.Row="5" Grid.Column="3" Text="{loc:Tr settings.shortcut.fitWidth2}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="5" Grid.Column="4" x:Name="FitWidth2Text" AutomationProperties.LabeledBy="{Binding ElementName=FitWidth2Label}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="5" Grid.Column="4" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.fitWidth2.clearAutomationName}" Click="ClearFitWidth2_Click"/>
                        </Grid></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.actions}"><StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock x:Name="SkipLabel" Grid.Row="0" Grid.Column="0" Text="{loc:Tr settings.shortcut.skip}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="SkipText" AutomationProperties.LabeledBy="{Binding ElementName=SkipLabel}" Style="{StaticResource ShortcutBox}"/>
                                <TextBlock x:Name="UndoLabel" Grid.Row="1" Grid.Column="0" Text="{loc:Tr settings.shortcut.undo}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="UndoText" AutomationProperties.LabeledBy="{Binding ElementName=UndoLabel}" Style="{StaticResource ShortcutBox}"/>
                                <TextBlock x:Name="CompareLabel" Grid.Row="2" Grid.Column="0" Text="{loc:Tr settings.shortcut.compare}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="CompareText" AutomationProperties.LabeledBy="{Binding ElementName=CompareLabel}" Style="{StaticResource ShortcutBox}"/>
                                <TextBlock x:Name="MoveToFolderLabel" Grid.Row="0" Grid.Column="3" Text="{loc:Tr settings.shortcut.moveToFolder}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="0" Grid.Column="4" x:Name="MoveToFolderText" AutomationProperties.LabeledBy="{Binding ElementName=MoveToFolderLabel}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="0" Grid.Column="4" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.moveToFolder.clearAutomationName}" Click="ClearMoveToFolder_Click"/>
                                <TextBlock x:Name="CopyToFolderLabel" Grid.Row="1" Grid.Column="3" Text="{loc:Tr settings.shortcut.copyToFolder}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="1" Grid.Column="4" x:Name="CopyToFolderText" AutomationProperties.LabeledBy="{Binding ElementName=CopyToFolderLabel}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="1" Grid.Column="4" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.copyToFolder.clearAutomationName}" Click="ClearCopyToFolder_Click"/>
                                <TextBlock x:Name="RecycleLabel" Grid.Row="2" Grid.Column="3" Text="{loc:Tr settings.shortcut.recycle}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="2" Grid.Column="4" x:Name="RecycleText" AutomationProperties.LabeledBy="{Binding ElementName=RecycleLabel}" Style="{StaticResource ShortcutBox}"/>
                            </Grid>
                            <CheckBox x:Name="MoveCopyReuseLastFolderCheck" Content="{loc:Tr settings.moveCopyReuseLastFolder.label}" Margin="0,4,0,0"/>
                            <TextBlock Text="{loc:Tr settings.moveCopyReuseLastFolder.hint}" Style="{StaticResource HelpText}" Margin="20,0,0,4"/>
                            <TextBlock x:Name="ActionProfilesDefaultsHint" Text="{loc:Tr settings.editActionProfiles.hint}" Style="{StaticResource HelpText}" Margin="0,8,0,0"/>
                            <Button Content="{loc:Tr settings.editActionProfiles}" ToolTip="{loc:Tr settings.editActionProfiles.hint}" HorizontalAlignment="Left" Click="EditActions_Click" Margin="0,6,0,0"/>
                        </StackPanel></GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Tệp & an toàn / Files & safety ============ -->
                <ScrollViewer x:Name="FilesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False" Visibility="Collapsed">
                    <StackPanel x:Name="FilesPage" KeyboardNavigation.TabNavigation="Local">
                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.fileHandling}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="ActionsLabel" Text="{loc:Tr settings.actionsJson.label}" Grid.Row="0" VerticalAlignment="Top" Margin="0,6,12,10"/>
                            <TextBox x:Name="ActionsText" AutomationProperties.LabeledBy="{Binding ElementName=ActionsLabel}" Grid.Row="0" Grid.Column="1" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" TextChanged="Shortcut_TextChanged"/>
                        </Grid></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.compareOptions}"><StackPanel>
                            <CheckBox x:Name="CompareHashCheck" Content="{loc:Tr settings.compareHash.label}" IsChecked="True"/>
                            <CheckBox x:Name="CompareSizeCheck" Content="{loc:Tr settings.compareSize.label}" IsChecked="True"/>
                        </StackPanel></GroupBox>

                        <!-- Camera RAW support (feat/raw-support-integration) -->
                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.raw}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <CheckBox x:Name="RawSupportEnabledCheck" Grid.Row="0" Grid.ColumnSpan="2" Content="{loc:Tr settings.rawSupportEnabled.label}" AutomationProperties.Name="{loc:Tr settings.rawSupportEnabled.automationName}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource HelpText}" Text="{loc:Tr settings.rawSupportEnabled.hint}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="RawFullDecodeLabel" Text="{loc:Tr settings.rawFullDecode.label}" Grid.Row="2" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="RawFullDecodeCombo" AutomationProperties.LabeledBy="{Binding ElementName=RawFullDecodeLabel}" AutomationProperties.Name="{loc:Tr settings.rawFullDecode.automationName}" Grid.Row="2" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.rawFullDecode.never}"/><ComboBoxItem Content="{loc:Tr enum.rawFullDecode.onZoom}"/></ComboBox>
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource HelpText}" Text="{loc:Tr settings.rawFullDecode.hint}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="RawPairModeLabel" Text="{loc:Tr settings.rawPairMode.label}" Grid.Row="4" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="RawPairModeCombo" AutomationProperties.LabeledBy="{Binding ElementName=RawPairModeLabel}" AutomationProperties.Name="{loc:Tr settings.rawPairMode.automationName}" ToolTip="{loc:Tr settings.rawPairMode.shortcutHint}" Grid.Row="4" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.rawPairMode.separate}"/><ComboBoxItem Content="{loc:Tr enum.rawPairMode.preferJpeg}"/><ComboBoxItem Content="{loc:Tr enum.rawPairMode.preferRaw}"/></ComboBox>
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource HelpText}" Text="{loc:Tr settings.rawPairMode.hint}"/>
                        </Grid></GroupBox>

                        <StackPanel Margin="0,0,0,10">
                            <CheckBox x:Name="AllowPermanentDeleteCheck" AutomationProperties.Name="{loc:Tr settings.allowPermanentDelete.label}" Content="{loc:Tr settings.allowPermanentDelete.label}"/>
                            <TextBlock x:Name="AllowPermanentDeleteHint" Text="{loc:Tr settings.allowPermanentDelete.hint}" Style="{StaticResource HelpText}" Margin="20,4,0,0"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <CheckBox x:Name="ConfirmBeforeDeleteCheck" Content="{loc:Tr settings.confirmBeforeDelete.label}" AutomationProperties.Name="{loc:Tr settings.confirmBeforeDelete.label}"/>
                            <TextBlock Text="{loc:Tr settings.confirmBeforeDelete.hint}" Style="{StaticResource HelpText}" Margin="20,4,0,0"/>
                        </StackPanel>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.externalEditor}"><StackPanel>
                            <TextBlock x:Name="ExternalEditorPathLabel" Text="{loc:Tr settings.externalEditorPath.label}" Style="{StaticResource FormLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ExternalEditorPathText" Grid.Column="0" Margin="0,0,8,0" AutomationProperties.LabeledBy="{Binding ElementName=ExternalEditorPathLabel}" AutomationProperties.Name="{loc:Tr settings.externalEditorPath.automationName}"/>
                                <Button Content="{loc:Tr settings.externalEditorPath.browse}" Grid.Column="1" Click="BrowseExternalEditor_Click"/>
                            </Grid>
                            <TextBlock Text="{loc:Tr settings.externalEditorPath.hint}" Style="{StaticResource HelpText}"/>
                        </StackPanel></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.journalDurability}"><StackPanel AutomationProperties.Name="{loc:Tr settings.journalDurability.label}">
                            <TextBlock Text="{loc:Tr settings.journalDurability.label}" Margin="0,0,0,8"/>
                            <RadioButton x:Name="JournalFastRadio" GroupName="JournalDurability" Content="{loc:Tr settings.journalDurability.fast}" IsChecked="True"/>
                            <TextBlock Text="{loc:Tr settings.journalDurability.fast.hint}" Style="{StaticResource HelpText}" Margin="20,2,0,10"/>
                            <RadioButton x:Name="JournalSafeRadio" GroupName="JournalDurability" Content="{loc:Tr settings.journalDurability.safe}"/>
                            <TextBlock Text="{loc:Tr settings.journalDurability.safe.hint}" Style="{StaticResource HelpText}" Margin="20,2,0,0"/>
                        </StackPanel></GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Chẩn đoán / Diagnostics ============ -->
                <ScrollViewer x:Name="DiagnosticsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False" Visibility="Collapsed">
                    <StackPanel x:Name="DiagnosticsPage" KeyboardNavigation.TabNavigation="Local">
                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.nav.diagnostics}"><StackPanel>
                            <CheckBox x:Name="LoggingCheck" Content="{loc:Tr settings.logging.label}"/>
                            <Button Content="{loc:Tr settings.openLogLocation}" AutomationProperties.Name="{loc:Tr settings.openLogLocation}" HorizontalAlignment="Left" Click="OpenLogLocation_Click"/>
                        </StackPanel></GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{loc:Tr settings.restoreDefaults}" Click="Defaults_Click"/>
                <Button Content="{loc:Tr settings.exportSettings}" Click="ExportSettings_Click" Margin="8,0,0,0"/>
                <Button Content="{loc:Tr settings.importSettings}" Click="ImportSettings_Click" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{loc:Tr common.cancel}" IsCancel="True" MinWidth="80" Margin="0,0,8,0"/>
                <Button Content="{loc:Tr common.save}" IsDefault="True" Click="Save_Click" MinWidth="80"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
