<Window x:Class="PhotoReview.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PhotoReview.App.Localization"
        Title="{loc:Tr settings.window.title}" Width="760" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="680" MinHeight="560" Background="{DynamicResource Dark.Window}" Foreground="{DynamicResource Dark.WindowText}" Loaded="SettingsWindow_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PhotoReview.App;component/Themes/DarkControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.Resources>
            <!-- Local tweaks live one level below the Window so BasedOn={StaticResource {x:Type ...}} resolves to the
                 dark theme styles merged into Window.Resources (inside the same dictionary it resolved to the system style). -->
            <!-- Form spacing: label column vertically centred on its input. -->
            <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,10"/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,0,0,10"/></Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,0,0,10"/></Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0,2,0,10"/></Style>
            <Style x:Key="ShortcutBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Width" Value="130"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="ShortcutLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,8"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{loc:Tr settings.header}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Dark.TextStrong}"/>
            <TextBlock Text="{loc:Tr settings.subtitle}" Foreground="{DynamicResource Dark.TextSubtle}" Margin="0,4,0,0"/>
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource Dark.TextFaint}" Margin="0,6,0,0"/>
        </StackPanel>
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False" Margin="0,18,0,8">
            <StackPanel KeyboardNavigation.TabNavigation="Local" Margin="0,0,12,0">
                <!-- I18N L08: first group, and its header reads "Language / Ngôn ngữ" in every language on purpose
                     (settings.group.language), so a user who picked a language they cannot read still finds the way back. -->
                <GroupBox x:Name="LanguageGroup" Header="{loc:Tr settings.group.language}"><Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{loc:Tr settings.language.label}" Grid.Row="0" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="LanguageCombo" Grid.Row="0" Grid.Column="1" DisplayMemberPath="DisplayName" AutomationProperties.Name="{loc:Tr settings.language.automationName}"/>
                    <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                        <Button Content="{loc:Tr settings.language.openFolder}" Click="OpenLanguagesFolder_Click" Margin="0,0,8,4"/>
                        <Button Content="{loc:Tr settings.language.reload}" Click="ReloadTranslations_Click" Margin="0,0,8,4"/>
                        <Button Content="{loc:Tr settings.language.export}" ToolTip="{loc:Tr settings.language.export.toolTip}" Click="ExportTranslation_Click" Margin="0,0,0,4"/>
                    </WrapPanel>
                    <TextBlock Text="{loc:Tr settings.language.hint}" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource Dark.TextMuted}"/>
                </Grid></GroupBox>

                <GroupBox Header="{loc:Tr settings.group.displayPerformance}"><Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="ViewModeLabel" Text="{loc:Tr settings.viewMode.label}" Grid.Row="0" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="ViewModeCombo" AutomationProperties.LabeledBy="{Binding ElementName=ViewModeLabel}" Grid.Row="0" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.initialViewMode.fit}"/><ComboBoxItem Content="100%"/><ComboBoxItem Content="200%"/><ComboBoxItem Content="400%"/></ComboBox>
                    <TextBlock x:Name="LoadingModeLabel" Text="{loc:Tr settings.loadingMode.label}" Grid.Row="1" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="LoadingModeCombo" AutomationProperties.LabeledBy="{Binding ElementName=LoadingModeLabel}" Grid.Row="1" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.loadingMode.fast}"/><ComboBoxItem Content="{loc:Tr enum.loadingMode.preview}"/><ComboBoxItem Content="{loc:Tr settings.loadingMode.originalWithHint}" Tag="Original"/></ComboBox>
                    <TextBlock x:Name="SortModeLabel" Text="{loc:Tr settings.sortMode.label}" Grid.Row="2" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="SortModeCombo" AutomationProperties.LabeledBy="{Binding ElementName=SortModeLabel}" Grid.Row="2" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.imageSortMode.name}" Tag="Name"/><ComboBoxItem Content="{loc:Tr enum.imageSortMode.sizeAscending}" Tag="SizeAscending"/><ComboBoxItem Content="{loc:Tr enum.imageSortMode.sizeDescending}" Tag="SizeDescending"/></ComboBox>
                    <CheckBox x:Name="CompareHashCheck" Grid.Row="3" Grid.Column="1" Content="{loc:Tr settings.compareHash.label}" IsChecked="True"/>
                    <CheckBox x:Name="CompareSizeCheck" Grid.Row="4" Grid.Column="1" Content="{loc:Tr settings.compareSize.label}" IsChecked="True"/>
                    <TextBlock Text="{loc:Tr settings.decoderBackend.label}" Grid.Row="5" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="DecoderBackendCombo" Grid.Row="5" Grid.Column="1" AutomationProperties.Name="{loc:Tr settings.decoderBackend.automationName}"><ComboBoxItem Content="{loc:Tr enum.decoderBackend.wpf}"/><ComboBoxItem Content="{loc:Tr enum.decoderBackend.wicDirect}"/><ComboBoxItem x:Name="TurboJpegOption" Content="{loc:Tr enum.decoderBackend.turboJpeg}"/></ComboBox>
                    <TextBlock Text="{loc:Tr settings.scalingQuality.label}" Grid.Row="6" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="ScalingQualityCombo" Grid.Row="6" Grid.Column="1" AutomationProperties.Name="{loc:Tr settings.scalingQuality.automationName}" Margin="0"><ComboBoxItem Content="{loc:Tr enum.scalingQuality.highQuality}"/><ComboBoxItem Content="{loc:Tr enum.scalingQuality.linear}"/></ComboBox>
                </Grid></GroupBox>

                <GroupBox Header="{loc:Tr settings.group.diagnostics}"><StackPanel>
                    <CheckBox x:Name="LoggingCheck" Content="{loc:Tr settings.logging.label}"/>
                    <Button Content="{loc:Tr settings.openLogLocation}" AutomationProperties.Name="{loc:Tr settings.openLogLocation}" HorizontalAlignment="Left" Click="OpenLogLocation_Click"/>
                </StackPanel></GroupBox>

                <GroupBox><GroupBox.Header><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Dark.TextStrong}"><Run Text="{loc:Tr settings.group.shortcuts.title}"/><Run Text="  ·  " FontWeight="Normal" Foreground="{DynamicResource Dark.TextMuted}" FontSize="13"/><Run Text="{loc:Tr settings.group.shortcuts.hint}" FontWeight="Normal" Foreground="{DynamicResource Dark.TextMuted}" FontSize="13"/></TextBlock></GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock x:Name="NextLabel" Grid.Row="0" Grid.Column="0" Text="{loc:Tr settings.shortcut.next}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="NextText" AutomationProperties.LabeledBy="{Binding ElementName=NextLabel}" Style="{StaticResource ShortcutBox}"/>
                        <TextBlock x:Name="PreviousLabel" Grid.Row="1" Grid.Column="0" Text="{loc:Tr settings.shortcut.previous}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="PreviousText" AutomationProperties.LabeledBy="{Binding ElementName=PreviousLabel}" Style="{StaticResource ShortcutBox}"/>
                        <TextBlock x:Name="CompareLabel" Grid.Row="2" Grid.Column="0" Text="{loc:Tr settings.shortcut.compare}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="CompareText" AutomationProperties.LabeledBy="{Binding ElementName=CompareLabel}" Style="{StaticResource ShortcutBox}"/>
                        <TextBlock x:Name="ZoomInLabel" Grid.Row="3" Grid.Column="0" Text="{loc:Tr settings.shortcut.zoomIn}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="ZoomInText" AutomationProperties.LabeledBy="{Binding ElementName=ZoomInLabel}" Style="{StaticResource ShortcutBox}"/>
                        <TextBlock x:Name="ToggleFitLabel" Grid.Row="4" Grid.Column="0" Text="{loc:Tr settings.shortcut.toggleFit}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="4" Grid.Column="1" x:Name="ToggleFitText" AutomationProperties.LabeledBy="{Binding ElementName=ToggleFitLabel}" Style="{StaticResource ShortcutBox}"/>
                        <TextBlock x:Name="SkipLabel" Grid.Row="5" Grid.Column="0" Text="{loc:Tr settings.shortcut.skip}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="5" Grid.Column="1" x:Name="SkipText" AutomationProperties.LabeledBy="{Binding ElementName=SkipLabel}" Style="{StaticResource ShortcutBox}"/>
                        <TextBlock x:Name="FullscreenLabel" Grid.Row="6" Grid.Column="0" Text="{loc:Tr settings.shortcut.fullscreen}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="6" Grid.Column="1" x:Name="FullscreenText" AutomationProperties.LabeledBy="{Binding ElementName=FullscreenLabel}" Style="{StaticResource ShortcutBox}"/>
                        <TextBlock x:Name="NextFolderLabel" Grid.Row="0" Grid.Column="3" Text="{loc:Tr settings.shortcut.nextFolder}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="0" Grid.Column="4" x:Name="NextFolderText" AutomationProperties.LabeledBy="{Binding ElementName=NextFolderLabel}" Style="{StaticResource ShortcutBox}"/>
                        <TextBlock x:Name="PreviousFolderLabel" Grid.Row="1" Grid.Column="3" Text="{loc:Tr settings.shortcut.previousFolder}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="1" Grid.Column="4" x:Name="PreviousFolderText" AutomationProperties.LabeledBy="{Binding ElementName=PreviousFolderLabel}" Style="{StaticResource ShortcutBox}"/>
                        <TextBlock x:Name="FirstImageLabel" Grid.Row="2" Grid.Column="3" Text="{loc:Tr settings.shortcut.firstImage}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="2" Grid.Column="4" x:Name="FirstImageText" AutomationProperties.LabeledBy="{Binding ElementName=FirstImageLabel}" Style="{StaticResource ShortcutBox}"/>
                        <TextBlock x:Name="ZoomOutLabel" Grid.Row="3" Grid.Column="3" Text="{loc:Tr settings.shortcut.zoomOut}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="3" Grid.Column="4" x:Name="ZoomOutText" AutomationProperties.LabeledBy="{Binding ElementName=ZoomOutLabel}" Style="{StaticResource ShortcutBox}"/>
                        <TextBlock x:Name="UndoLabel" Grid.Row="4" Grid.Column="3" Text="{loc:Tr settings.shortcut.undo}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="4" Grid.Column="4" x:Name="UndoText" AutomationProperties.LabeledBy="{Binding ElementName=UndoLabel}" Style="{StaticResource ShortcutBox}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="{loc:Tr settings.group.fileHandling}"><Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="RecycleLabel" Text="{loc:Tr settings.shortcut.recycle}" Grid.Row="0" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="RecycleText" AutomationProperties.LabeledBy="{Binding ElementName=RecycleLabel}" Grid.Row="0" Grid.Column="1" Width="130" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ActionsLabel" Text="{loc:Tr settings.actionsJson.label}" Grid.Row="1" VerticalAlignment="Top" Margin="0,6,12,10"/>
                    <TextBox x:Name="ActionsText" AutomationProperties.LabeledBy="{Binding ElementName=ActionsLabel}" Grid.Row="1" Grid.Column="1" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas"/>
                    <Button Content="{loc:Tr settings.editActions}" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Click="EditActions_Click"/>
                </Grid></GroupBox>

                <StackPanel Margin="0,0,0,10">
                    <CheckBox x:Name="AllowPermanentDeleteCheck" AutomationProperties.Name="{loc:Tr settings.allowPermanentDelete.label}" Content="{loc:Tr settings.allowPermanentDelete.label}"/>
                    <TextBlock x:Name="AllowPermanentDeleteHint" Text="{loc:Tr settings.allowPermanentDelete.hint}" TextWrapping="Wrap" Foreground="{DynamicResource Dark.TextMuted}" Margin="20,4,0,0"/>
                </StackPanel>

                <GroupBox Header="{loc:Tr settings.group.journalDurability}"><StackPanel AutomationProperties.Name="{loc:Tr settings.journalDurability.label}">
                    <TextBlock Text="{loc:Tr settings.journalDurability.label}" Margin="0,0,0,8"/>
                    <RadioButton x:Name="JournalFastRadio" GroupName="JournalDurability" Content="{loc:Tr settings.journalDurability.fast}" IsChecked="True"/>
                    <TextBlock Text="{loc:Tr settings.journalDurability.fast.hint}" TextWrapping="Wrap" Foreground="{DynamicResource Dark.TextMuted}" Margin="20,2,0,10"/>
                    <RadioButton x:Name="JournalSafeRadio" GroupName="JournalDurability" Content="{loc:Tr settings.journalDurability.safe}"/>
                    <TextBlock Text="{loc:Tr settings.journalDurability.safe.hint}" TextWrapping="Wrap" Foreground="{DynamicResource Dark.TextMuted}" Margin="20,2,0,0"/>
                </StackPanel></GroupBox>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Tr settings.restoreDefaults}" Click="Defaults_Click" Margin="0,0,8,0"/>
            <Button Content="{loc:Tr common.cancel}" IsCancel="True" MinWidth="80" Margin="0,0,8,0"/>
            <Button Content="{loc:Tr common.save}" IsDefault="True" Click="Save_Click" MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
