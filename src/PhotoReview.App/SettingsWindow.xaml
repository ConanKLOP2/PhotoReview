<Window x:Class="PhotoReview.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PhotoReview.App.Localization"
        Title="{loc:Tr settings.window.title}" Width="900" Height="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="760" MinHeight="560" Background="{DynamicResource Dark.Window}" Foreground="{DynamicResource Dark.WindowText}" Loaded="SettingsWindow_Loaded" PreviewKeyDown="SettingsWindow_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PhotoReview.App;component/Themes/DarkControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.Resources>
            <!-- Local tweaks live one level below the Window so BasedOn={StaticResource {x:Type ...}} resolves to the
                 dark theme styles merged into Window.Resources (inside the same dictionary it resolved to the system style). -->
            <!-- Form spacing: label column vertically centred on its input. -->
            <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,10"/>
            </Style>
            <Style x:Key="HelpText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{DynamicResource Dark.TextMuted}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style x:Key="PageHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Dark.TextStrong}"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>
            <Style x:Key="SectionCard" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,0,0,10"/></Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,0,0,10"/></Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0,2,0,10"/></Style>
            <Style x:Key="ShortcutBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Width" Value="110"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="ShortcutLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,8"/>
            </Style>
            <Style x:Key="ClearShortcutButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Margin" Value="4,0,0,8"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="GroupSubheading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Dark.TextSubtle}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Left navigation -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="{loc:Tr settings.header}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Dark.TextStrong}" Margin="0,0,0,12"/>
                <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Foreground="{DynamicResource Dark.TextFaint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <ListBox x:Name="NavList" DockPanel.Dock="Top" BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="{loc:Tr settings.nav.automationName}"
                         KeyboardNavigation.TabNavigation="Once" SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem x:Name="NavGeneral" Tag="General" Content="{loc:Tr settings.nav.general}"/>
                    <ListBoxItem x:Name="NavDisplay" Tag="Display" Content="{loc:Tr settings.nav.display}"/>
                    <ListBoxItem x:Name="NavMouse" Tag="Mouse" Content="{loc:Tr settings.nav.mouse}"/>
                    <ListBoxItem x:Name="NavPerformance" Tag="Performance" Content="{loc:Tr settings.nav.performance}"/>
                    <ListBoxItem x:Name="NavShortcuts" Tag="Shortcuts" Content="{loc:Tr settings.nav.shortcuts}"/>
                    <ListBoxItem x:Name="NavFiles" Tag="Files" Content="{loc:Tr settings.nav.files}"/>
                    <ListBoxItem x:Name="NavDiagnostics" Tag="Diagnostics" Content="{loc:Tr settings.nav.diagnostics}"/>
                </ListBox>
            </DockPanel>

            <!-- Right content -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="PageTitleText" Grid.Row="0" Style="{StaticResource PageHeading}"/>

                <!-- ============ Chung / General ============ -->
                <ScrollViewer x:Name="GeneralScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False">
                    <StackPanel x:Name="GeneralPage" KeyboardNavigation.TabNavigation="Local">
                        <GroupBox x:Name="LanguageGroup" Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.language}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{loc:Tr settings.language.label}" Grid.Row="0" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="LanguageCombo" Grid.Row="0" Grid.Column="1" DisplayMemberPath="DisplayName" AutomationProperties.Name="{loc:Tr settings.language.automationName}"/>
                            <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                <Button Content="{loc:Tr settings.language.openFolder}" Click="OpenLanguagesFolder_Click" Margin="0,0,8,4"/>
                                <Button Content="{loc:Tr settings.language.reload}" Click="ReloadTranslations_Click" Margin="0,0,8,4"/>
                                <Button Content="{loc:Tr settings.language.export}" ToolTip="{loc:Tr settings.language.export.toolTip}" Click="ExportTranslation_Click" Margin="0,0,0,4"/>
                            </WrapPanel>
                            <TextBlock Text="{loc:Tr settings.language.hint}" Grid.Row="2" Grid.Column="1" Style="{StaticResource HelpText}"/>
                        </Grid></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.nav.general}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="SortModeLabel" Text="{loc:Tr settings.sortMode.label}" Grid.Row="0" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="SortModeCombo" AutomationProperties.LabeledBy="{Binding ElementName=SortModeLabel}" Grid.Row="0" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.imageSortMode.name}" Tag="Name"/><ComboBoxItem Content="{loc:Tr enum.imageSortMode.sizeAscending}" Tag="SizeAscending"/><ComboBoxItem Content="{loc:Tr enum.imageSortMode.sizeDescending}" Tag="SizeDescending"/></ComboBox>
                            <TextBlock x:Name="ViewModeLabel" Text="{loc:Tr settings.viewMode.label}" Grid.Row="1" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="ViewModeCombo" AutomationProperties.LabeledBy="{Binding ElementName=ViewModeLabel}" Grid.Row="1" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.initialViewMode.fit}"/><ComboBoxItem Content="100%"/><ComboBoxItem Content="200%"/><ComboBoxItem Content="400%"/></ComboBox>
                            <TextBlock x:Name="InstanceModeLabel" Text="{loc:Tr settings.instanceMode.label}" Grid.Row="2" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="InstanceModeCombo" AutomationProperties.LabeledBy="{Binding ElementName=InstanceModeLabel}" Grid.Row="2" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.instanceMode.singleWindow}"/><ComboBoxItem Content="{loc:Tr enum.instanceMode.perFolder}"/></ComboBox>
                            <TextBlock Text="{loc:Tr settings.instanceMode.hint}" Grid.Row="3" Grid.Column="1" Style="{StaticResource HelpText}"/>
                        </Grid></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr update.section.title}"><StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckUpdateButton" Content="{loc:Tr update.check.button}" AutomationProperties.Name="{loc:Tr update.check.button}" Click="CheckUpdate_Click" Margin="0,0,8,0"/>
                                <Button x:Name="OpenUpdatePageButton" Content="{loc:Tr update.openPage.button}" AutomationProperties.Name="{loc:Tr update.openPage.button}" Click="OpenUpdatePage_Click" Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="{loc:Tr update.hint}" Style="{StaticResource HelpText}" Margin="0,8,0,0"/>
                        </StackPanel></GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Hiển thị / Display ============ -->
                <ScrollViewer x:Name="DisplayScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False" Visibility="Collapsed">
                    <StackPanel x:Name="DisplayPage" KeyboardNavigation.TabNavigation="Local">
                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.nav.display}"><StackPanel>
                            <CheckBox x:Name="ShowInfoOverlayCheck" Content="{loc:Tr settings.showInfoOverlay.label}" Checked="ShowInfoOverlayCheck_CheckedChanged" Unchecked="ShowInfoOverlayCheck_CheckedChanged"/>
                            <StackPanel Margin="20,0,0,0">
                                <CheckBox x:Name="ShowFileInfoCheck" Content="{loc:Tr settings.showFileInfo.label}"/>
                                <CheckBox x:Name="ShowFolderInfoCheck" Content="{loc:Tr settings.showFolderInfo.label}"/>
                            </StackPanel>
                        </StackPanel></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.displayPerformance}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="LoadingModeLabel" Text="{loc:Tr settings.loadingMode.label}" Grid.Row="0" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="LoadingModeCombo" AutomationProperties.LabeledBy="{Binding ElementName=LoadingModeLabel}" Grid.Row="0" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.loadingMode.fast}"/><ComboBoxItem Content="{loc:Tr enum.loadingMode.preview}"/><ComboBoxItem Content="{loc:Tr settings.loadingMode.originalWithHint}" Tag="Original"/></ComboBox>
                            <TextBlock Text="{loc:Tr settings.scalingQuality.label}" Grid.Row="1" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="ScalingQualityCombo" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="{loc:Tr settings.scalingQuality.automationName}" Margin="0,0,0,0"><ComboBoxItem Content="{loc:Tr enum.scalingQuality.highQuality}"/><ComboBoxItem Content="{loc:Tr enum.scalingQuality.linear}"/></ComboBox>
                        </Grid></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.exif}"><StackPanel x:Name="ExifSettingsHost">
                            <CheckBox x:Name="ShowExifInfoCheck" Content="{loc:Tr settings.showExifInfo.label}" Checked="ShowExifInfoCheck_CheckedChanged" Unchecked="ShowExifInfoCheck_CheckedChanged"/>
                            <TextBlock Text="{loc:Tr settings.group.exif.hint}" Style="{StaticResource HelpText}" Margin="20,0,0,8"/>
                            <WrapPanel Margin="20,0,0,0">
                                <CheckBox x:Name="ExifFieldFileNameCheck" Content="{loc:Tr settings.exifField.fileName}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldDateTakenCheck" Content="{loc:Tr settings.exifField.dateTaken}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldModifiedDateCheck" Content="{loc:Tr settings.exifField.modifiedDate}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldDimensionsCheck" Content="{loc:Tr settings.exifField.dimensions}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldCameraCheck" Content="{loc:Tr settings.exifField.camera}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldLensCheck" Content="{loc:Tr settings.exifField.lens}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldIsoCheck" Content="{loc:Tr settings.exifField.iso}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldFocalLengthCheck" Content="{loc:Tr settings.exifField.focalLength}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldApertureCheck" Content="{loc:Tr settings.exifField.aperture}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="ExifFieldShutterSpeedCheck" Content="{loc:Tr settings.exifField.shutterSpeed}" Margin="0,2,16,10"/>
                            </WrapPanel>
                        </StackPanel></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.titleBar}"><StackPanel>
                            <TextBlock Text="{loc:Tr settings.group.titleBar.hint}" Style="{StaticResource HelpText}" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <CheckBox x:Name="TitleBarFieldFolderNameCheck" Content="{loc:Tr settings.titleBarField.folderName}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldFolderPathCheck" Content="{loc:Tr settings.titleBarField.folderPath}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldIndexCountCheck" Content="{loc:Tr settings.titleBarField.indexCount}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldFileNameCheck" Content="{loc:Tr settings.exifField.fileName}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldFileSizeCheck" Content="{loc:Tr settings.titleBarField.fileSize}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldDimensionsCheck" Content="{loc:Tr settings.exifField.dimensions}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldModifiedDateCheck" Content="{loc:Tr settings.exifField.modifiedDate}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldDateTakenCheck" Content="{loc:Tr settings.exifField.dateTaken}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldCameraCheck" Content="{loc:Tr settings.exifField.camera}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldLensCheck" Content="{loc:Tr settings.exifField.lens}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldIsoCheck" Content="{loc:Tr settings.exifField.iso}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldFocalLengthCheck" Content="{loc:Tr settings.exifField.focalLength}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldApertureCheck" Content="{loc:Tr settings.exifField.aperture}" Margin="0,2,16,10"/>
                                <CheckBox x:Name="TitleBarFieldShutterSpeedCheck" Content="{loc:Tr settings.exifField.shutterSpeed}" Margin="0,2,16,10"/>
                            </WrapPanel>
                        </StackPanel></GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Chuột & Zoom / Mouse & zoom ============ -->
                <ScrollViewer x:Name="MouseScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False" Visibility="Collapsed">
                    <StackPanel x:Name="MousePage" KeyboardNavigation.TabNavigation="Local">
                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.mouseZoom}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="MouseWheelActionLabel" Text="{loc:Tr settings.mouseWheelAction.label}" Grid.Row="0" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="MouseWheelActionCombo" AutomationProperties.LabeledBy="{Binding ElementName=MouseWheelActionLabel}" AutomationProperties.Name="{loc:Tr settings.mouseWheelAction.automationName}" Grid.Row="0" Grid.Column="1"><ComboBoxItem Content="{loc:Tr enum.mouseWheelAction.zoom}"/><ComboBoxItem Content="{loc:Tr enum.mouseWheelAction.navigate}"/></ComboBox>
                            <TextBlock Text="{loc:Tr settings.mouseWheelAction.hint}" Grid.Row="1" Grid.Column="1" Style="{StaticResource HelpText}"/>
                            <CheckBox x:Name="ClickToZoomCheck" Grid.Row="2" Grid.Column="1" Content="{loc:Tr settings.clickToZoom.label}" Checked="ClickToZoomCheck_CheckedChanged" Unchecked="ClickToZoomCheck_CheckedChanged"/>
                            <TextBlock x:Name="ClickZoomPercentLabel" Text="{loc:Tr settings.clickZoomPercent.label}" Grid.Row="3" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="ClickZoomPercentBox" AutomationProperties.LabeledBy="{Binding ElementName=ClickZoomPercentLabel}" AutomationProperties.Name="{loc:Tr settings.clickZoomPercent.automationName}" Grid.Row="3" Grid.Column="1" Width="90" HorizontalAlignment="Left"/>
                            <CheckBox x:Name="KineticPanCheck" Grid.Row="4" Grid.Column="1" Content="{loc:Tr settings.kineticPan.label}"/>
                        </Grid></GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Hiệu năng / Performance ============ -->
                <ScrollViewer x:Name="PerformanceScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False" Visibility="Collapsed">
                    <StackPanel x:Name="PerformancePage" KeyboardNavigation.TabNavigation="Local">
                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.nav.performance}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{loc:Tr settings.decoderBackend.label}" Grid.Row="0" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="DecoderBackendCombo" Grid.Row="0" Grid.Column="1" AutomationProperties.Name="{loc:Tr settings.decoderBackend.automationName}"><ComboBoxItem Content="{loc:Tr enum.decoderBackend.wpf}"/><ComboBoxItem Content="{loc:Tr enum.decoderBackend.wicDirect}"/><ComboBoxItem x:Name="TurboJpegOption" Content="{loc:Tr enum.decoderBackend.turboJpeg}"/></ComboBox>
                            <!-- RAM%: in-memory preview cache share of physical RAM, [system minimum, 90]; applies after restart. -->
                            <TextBlock x:Name="RamCacheLabel" Text="{loc:Tr settings.ramCache.label}" Grid.Row="1" Style="{StaticResource FormLabel}" Margin="0,10,12,10"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,10">
                                <Slider x:Name="RamCacheSlider" Width="260" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="5"
                                        AutomationProperties.Name="{loc:Tr settings.ramCache.automationName}" ValueChanged="RamCacheSlider_ValueChanged"/>
                                <TextBlock x:Name="RamCacheValueText" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                            <TextBlock x:Name="RamCacheHint" Grid.Row="2" Grid.Column="1" Style="{StaticResource HelpText}"/>
                        </Grid></GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Phím tắt / Shortcuts ============ -->
                <ScrollViewer x:Name="ShortcutsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False" Visibility="Collapsed">
                    <StackPanel x:Name="ShortcutsPage" KeyboardNavigation.TabNavigation="Local">
                        <TextBlock Text="{loc:Tr settings.group.shortcuts.hint}" Style="{StaticResource HelpText}"/>
                        <TextBlock x:Name="ShortcutDuplicateWarningText" Style="{StaticResource HelpText}" Foreground="{DynamicResource Dark.Warning}" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.navigation}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="NextLabel" Grid.Row="0" Grid.Column="0" Text="{loc:Tr settings.shortcut.next}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="NextText" AutomationProperties.LabeledBy="{Binding ElementName=NextLabel}" Style="{StaticResource ShortcutBox}"/>
                            <TextBlock x:Name="PreviousLabel" Grid.Row="1" Grid.Column="0" Text="{loc:Tr settings.shortcut.previous}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="PreviousText" AutomationProperties.LabeledBy="{Binding ElementName=PreviousLabel}" Style="{StaticResource ShortcutBox}"/>
                            <TextBlock x:Name="FirstImageLabel" Grid.Row="2" Grid.Column="0" Text="{loc:Tr settings.shortcut.firstImage}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="FirstImageText" AutomationProperties.LabeledBy="{Binding ElementName=FirstImageLabel}" Style="{StaticResource ShortcutBox}"/>
                            <TextBlock x:Name="LastImageLabel" Grid.Row="0" Grid.Column="3" Text="{loc:Tr settings.shortcut.lastImage}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="0" Grid.Column="4" x:Name="LastImageText" AutomationProperties.LabeledBy="{Binding ElementName=LastImageLabel}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="0" Grid.Column="4" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.lastImage.clearAutomationName}" Click="ClearLastImage_Click"/>
                            <TextBlock x:Name="NextFolderLabel" Grid.Row="1" Grid.Column="3" Text="{loc:Tr settings.shortcut.nextFolder}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="1" Grid.Column="4" x:Name="NextFolderText" AutomationProperties.LabeledBy="{Binding ElementName=NextFolderLabel}" Style="{StaticResource ShortcutBox}"/>
                            <TextBlock x:Name="PreviousFolderLabel" Grid.Row="2" Grid.Column="3" Text="{loc:Tr settings.shortcut.previousFolder}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="2" Grid.Column="4" x:Name="PreviousFolderText" AutomationProperties.LabeledBy="{Binding ElementName=PreviousFolderLabel}" Style="{StaticResource ShortcutBox}"/>
                        </Grid></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.view}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="ZoomInLabel" Grid.Row="0" Grid.Column="0" Text="{loc:Tr settings.shortcut.zoomIn}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="ZoomInText" AutomationProperties.LabeledBy="{Binding ElementName=ZoomInLabel}" Style="{StaticResource ShortcutBox}"/>
                            <TextBlock x:Name="ZoomOutLabel" Grid.Row="1" Grid.Column="0" Text="{loc:Tr settings.shortcut.zoomOut}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="ZoomOutText" AutomationProperties.LabeledBy="{Binding ElementName=ZoomOutLabel}" Style="{StaticResource ShortcutBox}"/>
                            <TextBlock x:Name="ToggleFitLabel" Grid.Row="2" Grid.Column="0" Text="{loc:Tr settings.shortcut.toggleFit}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="ToggleFitText" AutomationProperties.LabeledBy="{Binding ElementName=ToggleFitLabel}" Style="{StaticResource ShortcutBox}"/>
                            <TextBlock x:Name="ZoomActualSizeLabel" Grid.Row="0" Grid.Column="3" Text="{loc:Tr settings.shortcut.zoomActualSize}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="0" Grid.Column="4" x:Name="ZoomActualSizeText" AutomationProperties.LabeledBy="{Binding ElementName=ZoomActualSizeLabel}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="0" Grid.Column="4" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.zoomActualSize.clearAutomationName}" Click="ClearZoomActualSize_Click"/>
                            <TextBlock x:Name="FullscreenLabel" Grid.Row="1" Grid.Column="3" Text="{loc:Tr settings.shortcut.fullscreen}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="1" Grid.Column="4" x:Name="FullscreenText" AutomationProperties.LabeledBy="{Binding ElementName=FullscreenLabel}" Style="{StaticResource ShortcutBox}"/>
                            <TextBlock x:Name="ToggleInfoOverlayLabel" Grid.Row="2" Grid.Column="3" Text="{loc:Tr settings.shortcut.toggleInfoOverlay}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="2" Grid.Column="4" x:Name="ToggleInfoOverlayText" AutomationProperties.LabeledBy="{Binding ElementName=ToggleInfoOverlayLabel}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="2" Grid.Column="4" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.toggleInfoOverlay.clearAutomationName}" Click="ClearToggleInfoOverlay_Click"/>
                        </Grid></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.actions}"><StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock x:Name="SkipLabel" Grid.Row="0" Grid.Column="0" Text="{loc:Tr settings.shortcut.skip}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="SkipText" AutomationProperties.LabeledBy="{Binding ElementName=SkipLabel}" Style="{StaticResource ShortcutBox}"/>
                                <TextBlock x:Name="UndoLabel" Grid.Row="1" Grid.Column="0" Text="{loc:Tr settings.shortcut.undo}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="UndoText" AutomationProperties.LabeledBy="{Binding ElementName=UndoLabel}" Style="{StaticResource ShortcutBox}"/>
                                <TextBlock x:Name="CompareLabel" Grid.Row="2" Grid.Column="0" Text="{loc:Tr settings.shortcut.compare}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="CompareText" AutomationProperties.LabeledBy="{Binding ElementName=CompareLabel}" Style="{StaticResource ShortcutBox}"/>
                                <TextBlock x:Name="MoveToFolderLabel" Grid.Row="0" Grid.Column="3" Text="{loc:Tr settings.shortcut.moveToFolder}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="0" Grid.Column="4" x:Name="MoveToFolderText" AutomationProperties.LabeledBy="{Binding ElementName=MoveToFolderLabel}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="0" Grid.Column="4" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.moveToFolder.clearAutomationName}" Click="ClearMoveToFolder_Click"/>
                                <TextBlock x:Name="CopyToFolderLabel" Grid.Row="1" Grid.Column="3" Text="{loc:Tr settings.shortcut.copyToFolder}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="1" Grid.Column="4" x:Name="CopyToFolderText" AutomationProperties.LabeledBy="{Binding ElementName=CopyToFolderLabel}" Style="{StaticResource ShortcutBox}"/><Button Grid.Row="1" Grid.Column="4" Content="✕" HorizontalAlignment="Right" Style="{StaticResource ClearShortcutButton}" AutomationProperties.Name="{loc:Tr settings.shortcut.copyToFolder.clearAutomationName}" Click="ClearCopyToFolder_Click"/>
                                <TextBlock x:Name="RecycleLabel" Grid.Row="2" Grid.Column="3" Text="{loc:Tr settings.shortcut.recycle}" Style="{StaticResource ShortcutLabel}"/><TextBox Grid.Row="2" Grid.Column="4" x:Name="RecycleText" AutomationProperties.LabeledBy="{Binding ElementName=RecycleLabel}" Style="{StaticResource ShortcutBox}"/>
                            </Grid>
                            <CheckBox x:Name="MoveCopyReuseLastFolderCheck" Content="{loc:Tr settings.moveCopyReuseLastFolder.label}" Margin="0,4,0,0"/>
                            <TextBlock Text="{loc:Tr settings.moveCopyReuseLastFolder.hint}" Style="{StaticResource HelpText}" Margin="20,0,0,4"/>
                            <Button Content="{loc:Tr settings.editActionProfiles}" HorizontalAlignment="Left" Click="EditActions_Click" Margin="0,6,0,0"/>
                        </StackPanel></GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Tệp & an toàn / Files & safety ============ -->
                <ScrollViewer x:Name="FilesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False" Visibility="Collapsed">
                    <StackPanel x:Name="FilesPage" KeyboardNavigation.TabNavigation="Local">
                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.fileHandling}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="ActionsLabel" Text="{loc:Tr settings.actionsJson.label}" Grid.Row="0" VerticalAlignment="Top" Margin="0,6,12,10"/>
                            <TextBox x:Name="ActionsText" AutomationProperties.LabeledBy="{Binding ElementName=ActionsLabel}" Grid.Row="0" Grid.Column="1" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" TextChanged="Shortcut_TextChanged"/>
                        </Grid></GroupBox>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.compareOptions}"><StackPanel>
                            <CheckBox x:Name="CompareHashCheck" Content="{loc:Tr settings.compareHash.label}" IsChecked="True"/>
                            <CheckBox x:Name="CompareSizeCheck" Content="{loc:Tr settings.compareSize.label}" IsChecked="True"/>
                        </StackPanel></GroupBox>

                        <StackPanel Margin="0,0,0,10">
                            <CheckBox x:Name="AllowPermanentDeleteCheck" AutomationProperties.Name="{loc:Tr settings.allowPermanentDelete.label}" Content="{loc:Tr settings.allowPermanentDelete.label}"/>
                            <TextBlock x:Name="AllowPermanentDeleteHint" Text="{loc:Tr settings.allowPermanentDelete.hint}" Style="{StaticResource HelpText}" Margin="20,4,0,0"/>
                        </StackPanel>

                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.group.journalDurability}"><StackPanel AutomationProperties.Name="{loc:Tr settings.journalDurability.label}">
                            <TextBlock Text="{loc:Tr settings.journalDurability.label}" Margin="0,0,0,8"/>
                            <RadioButton x:Name="JournalFastRadio" GroupName="JournalDurability" Content="{loc:Tr settings.journalDurability.fast}" IsChecked="True"/>
                            <TextBlock Text="{loc:Tr settings.journalDurability.fast.hint}" Style="{StaticResource HelpText}" Margin="20,2,0,10"/>
                            <RadioButton x:Name="JournalSafeRadio" GroupName="JournalDurability" Content="{loc:Tr settings.journalDurability.safe}"/>
                            <TextBlock Text="{loc:Tr settings.journalDurability.safe.hint}" Style="{StaticResource HelpText}" Margin="20,2,0,0"/>
                        </StackPanel></GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Chẩn đoán / Diagnostics ============ -->
                <ScrollViewer x:Name="DiagnosticsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False" Visibility="Collapsed">
                    <StackPanel x:Name="DiagnosticsPage" KeyboardNavigation.TabNavigation="Local">
                        <GroupBox Style="{StaticResource SectionCard}" Header="{loc:Tr settings.nav.diagnostics}"><StackPanel>
                            <CheckBox x:Name="LoggingCheck" Content="{loc:Tr settings.logging.label}"/>
                            <Button Content="{loc:Tr settings.openLogLocation}" AutomationProperties.Name="{loc:Tr settings.openLogLocation}" HorizontalAlignment="Left" Click="OpenLogLocation_Click"/>
                        </StackPanel></GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{loc:Tr settings.restoreDefaults}" Click="Defaults_Click" HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{loc:Tr common.cancel}" IsCancel="True" MinWidth="80" Margin="0,0,8,0"/>
                <Button Content="{loc:Tr common.save}" IsDefault="True" Click="Save_Click" MinWidth="80"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
