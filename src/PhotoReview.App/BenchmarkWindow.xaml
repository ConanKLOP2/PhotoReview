<Window x:Class="PhotoReview.App.BenchmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photo Review · Benchmark" Width="960" Height="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="820" MinHeight="560"
        Background="#171717" Foreground="#F5F5F5">
    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PhotoReview.App;component/Themes/DarkControls.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#171717"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#1E1E1E"/>
            <Setter Property="AlternatingRowBackground" Value="#242424"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#333333"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#3A5A80"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBest}" Value="True"><Setter Property="Background" Value="#1E3B24"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Fail"><Setter Property="Background" Value="#3B1E1E"/></DataTrigger>
            </Style.Triggers>
        </Style>
      </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.Resources>
            <!-- Grid-level so BasedOn resolves to the shared dark theme merged into Window.Resources. -->
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Margin" Value="0,0,0,5"/></Style>
            <Style x:Key="NumericCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Benchmark" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="So sánh các cấu hình tải/giải mã ảnh trên bộ ảnh thật để tìm cấu hình nhanh và ổn định nhất cho máy này." Foreground="#AAAAAA" Margin="0,4,0,16" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="FolderText" Grid.Column="0" AutomationProperties.Name="Folder ảnh thật dùng để benchmark"/>
                <Button x:Name="BrowseButton" Grid.Column="1" Content="Chọn folder…" Click="Browse_Click" Margin="8,0,0,0"/>
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0" VerticalAlignment="Center" Text="Chọn các cấu hình cần so sánh (giữ Ctrl để chọn nhiều — cùng Workload mới so sánh trực tiếp được):"/>
                <Button x:Name="SelectAllButton" Grid.Column="1" Content="Chọn tất cả" Click="SelectAll_Click" Margin="8,0,0,0"/>
                <Button x:Name="SelectNoneButton" Grid.Column="2" Content="Bỏ chọn" Click="SelectNone_Click" Margin="8,0,0,0"/>
            </Grid>
            <ListBox x:Name="ProfilesList" Height="120" SelectionMode="Multiple" DisplayMemberPath="Name"
                     VirtualizingPanel.IsVirtualizing="False">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="ToolTip" Value="{Binding Description}"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="RunButton" Content="Chạy benchmark" Click="Run_Click" Margin="0,0,8,0" IsDefault="True"/>
                <Button x:Name="CancelButton" Content="Hủy" Click="Cancel_Click" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <ProgressBar x:Name="RunProgress" Height="6" Minimum="0" Maximum="1" Value="0"/>
            <TextBlock x:Name="StatusText" Foreground="#BBBBBB" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <DataGrid x:Name="ResultsGrid" Grid.Row="3">
            <DataGrid.Columns>
                <DataGridTextColumn Header="🏆" Binding="{Binding BestMarker}" Width="36"/>
                <DataGridTextColumn Header="Cấu hình" Binding="{Binding ProfileName}" Width="2*"/>
                <DataGridTextColumn Header="Chế độ tải" Binding="{Binding LoadingMode}" Width="90"/>
                <DataGridTextColumn Header="Workload" Binding="{Binding Workload}" Width="100"/>
                <DataGridTextColumn Header="Mẫu" Binding="{Binding Count}" Width="55" ElementStyle="{StaticResource NumericCell}"/>
                <DataGridTextColumn Header="P50" Binding="{Binding P50Text}" Width="75" ElementStyle="{StaticResource NumericCell}"/>
                <DataGridTextColumn Header="P95" Binding="{Binding P95Text}" Width="75" ElementStyle="{StaticResource NumericCell}"/>
                <DataGridTextColumn Header="P99" Binding="{Binding P99Text}" Width="75" ElementStyle="{StaticResource NumericCell}"/>
                <DataGridTextColumn Header="Max" Binding="{Binding MaxText}" Width="75" ElementStyle="{StaticResource NumericCell}"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="1*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OpenReportButton" Content="Mở báo cáo cuối" Click="OpenReport_Click" Margin="0,0,8,0"/>
            <Button x:Name="OpenResultFolderButton" Content="Mở thư mục kết quả" Click="OpenResultFolder_Click" Margin="0,0,8,0"/>
            <Button Content="Đóng" Click="Close_Click" Padding="18,7"/>
        </StackPanel>
    </Grid>
</Window>
