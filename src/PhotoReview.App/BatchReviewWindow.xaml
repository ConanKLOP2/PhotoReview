<Window x:Class="PhotoReview.App.BatchReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PhotoReview.App.Localization" Title="{loc:Tr batchReview.title}" Width="720" Height="560" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner" Background="#171717" Foreground="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{loc:Tr batchReview.title}" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="SummaryText" Foreground="#BBBBBB" Margin="0,6,0,14"/></StackPanel>
        <ListBox x:Name="FilesList" Grid.Row="1" Background="#252525" Foreground="#FFFFFF"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="{loc:Tr common.cancel}" IsCancel="True" Padding="16,8" Margin="0,0,8,0"/><Button Content="{loc:Tr batchReview.confirm}" IsDefault="True" Click="Confirm_Click" Padding="16,8"/></StackPanel>
    </Grid>
</Window>
