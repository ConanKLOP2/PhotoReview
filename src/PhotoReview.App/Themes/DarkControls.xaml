<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Shared dark control styles for dialog windows (Settings, Action profiles, ...).
        Merge into a Window's resources:
            <ResourceDictionary Source="/PhotoReview.App;component/Themes/DarkControls.xaml"/>
        The default (Aero) templates of GroupBox/Button/ComboBox/ScrollBar draw light chrome that
        clashes with the dark window background, so those get small templates of their own.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/PhotoReview.App;component/Themes/DarkPalette.xaml"/>
        <ResourceDictionary Source="/PhotoReview.App;component/Themes/DarkScrollBars.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Background" Value="{StaticResource Dark.Input}"/>
        <Setter Property="Foreground" Value="{StaticResource Dark.TextStrong}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Dark.BorderStrong}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Dark.TextStrong}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Dark.Accent}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Without this the label keeps the system foreground (dark) and disappears on the dark panel. -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Header above a rounded panel, instead of the Aero etched frame the header text overlapped. -->
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <DockPanel>
                        <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="2,0,0,8" RecognizesAccessKey="True"
                                          TextElement.FontSize="15" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource Dark.TextStrong}"/>
                        <Border Background="{StaticResource Dark.Panel}" BorderBrush="{StaticResource Dark.Border}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Dark.TextStrong}"/>
        <Setter Property="Background" Value="{StaticResource Dark.Button}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Dark.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.Accent}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Dark.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ButtonHover}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions><Condition Property="IsDefault" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.AccentHover}"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ButtonPressed}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Dark.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: dark field + dark drop-down. Items keep keyboard/selection behaviour of the stock control. -->
    <Style x:Key="Dark.ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{StaticResource Dark.Input}" BorderBrush="{StaticResource Dark.BorderStrong}" BorderThickness="1" CornerRadius="3">
                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Dark.Text}" StrokeThickness="1.5"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Dark.AccentHover}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Dark.TextStrong}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ButtonHover}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.Accent}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Dark.TextMuted}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Dark.TextStrong}"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="8,5,28,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource Dark.ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{StaticResource Dark.Input}" BorderBrush="{StaticResource Dark.BorderStrong}" BorderThickness="1" Margin="0,2,0,0">
                                <ScrollViewer SnapsToDevicePixels="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Dark.Input}"/>
        <Setter Property="Foreground" Value="{StaticResource Dark.TextStrong}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Dark.TextStrong}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ButtonHover}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.Accent}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Dark.TextMuted}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="#2A2A2A"/>
        <Setter Property="Foreground" Value="{StaticResource Dark.Accent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="6"/>
    </Style>

    <!-- ScrollBar / ScrollViewer dark styling now lives in Themes/DarkScrollBars.xaml (merged above)
         so MainWindow's ImageScroll can share it without merging this whole dialog-styles file. -->
</ResourceDictionary>
