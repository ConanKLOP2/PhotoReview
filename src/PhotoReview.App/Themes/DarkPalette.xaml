<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Dark palette: brushes only, no implicit styles. Every colour used by the app's XAML lives here
        (rule: XamlThemeRulesTests). MainWindow merges just this file; the dialog windows get it through
        DarkControls.xaml. Reference brushes with {DynamicResource Dark.*} instead of hex literals.
    -->
    <SolidColorBrush x:Key="Dark.Text" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="Dark.TextStrong" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Dark.TextMuted" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Dark.Input" Color="#252525"/>
    <SolidColorBrush x:Key="Dark.Panel" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Dark.Border" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="Dark.BorderStrong" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="Dark.Button" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="Dark.ButtonHover" Color="#383838"/>
    <SolidColorBrush x:Key="Dark.ButtonPressed" Color="#444444"/>
    <SolidColorBrush x:Key="Dark.Accent" Color="#3A7BD5"/>
    <SolidColorBrush x:Key="Dark.AccentHover" Color="#4A8BE5"/>

    <!-- Window and surface backgrounds -->
    <SolidColorBrush x:Key="Dark.Window" Color="#171717"/>
    <SolidColorBrush x:Key="Dark.Backdrop" Color="#181818"/>
    <SolidColorBrush x:Key="Dark.Canvas" Color="#101010"/>
    <SolidColorBrush x:Key="Dark.Tooltip" Color="#202020"/>
    <SolidColorBrush x:Key="Dark.Surface" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Dark.RowAlt" Color="#242424"/>
    <SolidColorBrush x:Key="Dark.Overlay" Color="#B0181818"/>
    <SolidColorBrush x:Key="Dark.Selection" Color="#3A5A80"/>
    <SolidColorBrush x:Key="Dark.SuccessBackground" Color="#1E3B24"/>
    <SolidColorBrush x:Key="Dark.ErrorBackground" Color="#3B1E1E"/>

    <!-- Text tones -->
    <SolidColorBrush x:Key="Dark.WindowText" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Dark.TextBright" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="Dark.TextSoft" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="Dark.TextSecondary" Color="#BBBBBB"/>
    <SolidColorBrush x:Key="Dark.TextSubtle" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="Dark.TextFaint" Color="#777777"/>
    <SolidColorBrush x:Key="Dark.Warning" Color="#FFC857"/>
    <SolidColorBrush x:Key="Dark.Caution" Color="#F0B040"/>
    <SolidColorBrush x:Key="Dark.ErrorText" Color="#FF9A9A"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="Dark.BorderSubtle" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Dark.BorderToolbar" Color="#454545"/>
    <SolidColorBrush x:Key="Dark.GridLine" Color="#333333"/>
</ResourceDictionary>
