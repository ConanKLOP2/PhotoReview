<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        PR-C (feat/context-menu-redesign): dark ContextMenu/MenuItem/Separator styles for MainWindow's
        right-click menu. Kept out of DarkControls.xaml on purpose - that file's implicit TextBlock/Button/
        CheckBox/... styles are only merged into dialog windows (Settings, Action profiles); MainWindow
        merges just DarkPalette.xaml + DarkScrollBars.xaml (see DarkPalette.xaml's own comment) so its own
        Button/ToggleButton styles in MainWindow.xaml stay in charge of the toolbar. Merging DarkControls.xaml
        wholesale into MainWindow would silently reskin every bare TextBlock in it (several have no explicit
        Foreground today) and shadow its local Button style ordering, so the menu gets a small dictionary of
        its own instead; MainWindow.xaml merges this alongside DarkPalette.xaml + DarkScrollBars.xaml.

        ContextMenu items are never top-level (Role is SubmenuItem/SubmenuHeader, not TopLevelItem/TopLevelHeader,
        because MainWindow only ever hosts a ContextMenu, never a Menu bar) - but the MenuItem style below still
        covers all four Role values so it stays correct if a Menu is ever added.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/PhotoReview.App;component/Themes/DarkPalette.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource Dark.Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Dark.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Dark.TextStrong}"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Margin="0,2"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Straight line instead of the default two-tone (light/dark) bevel, which reads as a bright line on a dark menu. -->
    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border BorderBrush="{StaticResource Dark.Border}" BorderThickness="0,1,0,0" Margin="6,4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SubmenuItem/TopLevelItem: a leaf entry (no children), optionally IsCheckable (presets, "also set" toggle). -->
    <ControlTemplate x:Key="Dark.MenuItem.ItemTemplate" TargetType="MenuItem">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path x:Name="CheckMark" Grid.Column="0" Visibility="Collapsed" Width="8" Height="7"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M0,3.5 L3,6.5 L8,0.5" Stroke="{StaticResource Dark.TextStrong}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                   VerticalAlignment="Center" Margin="4,6,16,6"/>
                <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                           Foreground="{StaticResource Dark.TextFaint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ButtonHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ButtonPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuHeader/TopLevelHeader: has child items, so it opens its own Popup with a submenu arrow. -->
    <ControlTemplate x:Key="Dark.MenuItem.HeaderTemplate" TargetType="MenuItem">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="18"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                   VerticalAlignment="Center" Margin="4,6,16,6"/>
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                           Foreground="{StaticResource Dark.TextFaint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Path Grid.Column="3" Width="7" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M0,0 L4,4 L0,8 Z" Fill="{StaticResource Dark.TextSoft}"/>
                <Popup x:Name="Popup" Placement="Right" HorizontalOffset="-4" VerticalOffset="-3"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="{StaticResource Dark.Panel}" BorderBrush="{StaticResource Dark.BorderStrong}"
                            BorderThickness="1" CornerRadius="4" Padding="2">
                        <Border.Effect>
                            <DropShadowEffect Direction="270" ShadowDepth="3" Opacity="0.4" BlurRadius="8"/>
                        </Border.Effect>
                        <ScrollViewer CanContentScroll="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Margin="0,2"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ButtonHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Dark.TextStrong}"/>
        <Setter Property="Padding" Value="2,6"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource Dark.MenuItem.ItemTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource Dark.MenuItem.HeaderTemplate}"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource Dark.MenuItem.HeaderTemplate}"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource Dark.MenuItem.ItemTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
