<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\PhotoReview.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <BuildStamp>$([System.DateTime]::UtcNow.ToString('yyyyMMdd.HHmmss'))</BuildStamp>
    <InformationalVersion>1.0.1+build.$(BuildStamp)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\PhotoReview.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoReview.Core\PhotoReview.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="PhotoReview.Core.Settings" />
    <Using Include="PhotoReview.App.Services" />
    <Using Include="PhotoReview.Core.FileActions" />
    <Using Include="PhotoReview.Core.Session" />
  </ItemGroup>

</Project>
