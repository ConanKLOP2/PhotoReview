<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\PhotoReview.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- perf(startup): precompile the app's own assemblies (and packages) at publish so the first
         window is not JIT-bound. Measured on the release folder (open a JPEG in an 1841-file folder,
         median of 7): first image ~400 ms sooner (window Show/Loaded 783 -> 424 ms); +1.35 MB.
         Publish only; build/test output is unchanged. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\PhotoReview.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Legal: the third-party notices (libjpeg-turbo BSD/IJG/zlib, ICC profile, ...) must ship beside the exe; tools/verify-release.ps1 requires it. -->
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoReview.Core\PhotoReview.Core.csproj" />
    <ProjectReference Include="..\PhotoReview.Benchmarking\PhotoReview.Benchmarking.csproj" />
    <ProjectReference Include="..\PhotoReview.Imaging\PhotoReview.Imaging.csproj" />
    <ProjectReference Include="..\PhotoReview.Imaging.Raw\PhotoReview.Imaging.Raw.csproj" />
    <ProjectReference Include="..\PhotoReview.Imaging.LibRaw\PhotoReview.Imaging.LibRaw.csproj" />
    <ProjectReference Include="..\PhotoReview.Imaging.TurboJpeg\PhotoReview.Imaging.TurboJpeg.csproj" />
    <!-- WP-06: the WPF decoder/codec bridge (BitmapSource); Imaging* itself no longer uses WPF. -->
    <ProjectReference Include="..\PhotoReview.Imaging.Wpf\PhotoReview.Imaging.Wpf.csproj" />
    <ProjectReference Include="..\PhotoReview.Platform.Windows\PhotoReview.Platform.Windows.csproj" />
    <!-- NO-WPF-EXEC-PLAN (WP-01): lớp dùng chung không-WPF; WP-07/WP-09 dời thêm kiểu sang đây (namespace giữ nguyên). -->
    <ProjectReference Include="..\PhotoReview.App.Shared\PhotoReview.App.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="PhotoReview.Core.Settings" />
    <Using Include="PhotoReview.App.Services" />
    <Using Include="PhotoReview.Core.FileActions" />
    <Using Include="PhotoReview.Core.Session" />
    <Using Include="PhotoReview.Imaging" />
    <Using Include="PhotoReview.Imaging.Caching" />
    <Using Include="PhotoReview.Imaging.Decoding" />
    <Using Include="PhotoReview.Imaging.Preload" />
    <Using Include="PhotoReview.Imaging.Wpf" />
    <Using Include="PhotoReview.Platform.Windows" />
    <Using Include="PhotoReview.Platform.Windows.Explorer" />
  </ItemGroup>

</Project>
