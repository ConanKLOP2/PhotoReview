<Window x:Class="PhotoReview.App.ActionProfilesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Action profiles" Width="820" Height="520" MinWidth="700" MinHeight="420" WindowStartupLocation="CenterOwner" Background="#171717" Foreground="#F5F5F5">
    <Window.Resources><ResourceDictionary Source="/PhotoReview.App;component/Themes/DarkControls.xaml"/></Window.Resources>
    <Grid Margin="20">
        <Grid.Resources>
            <!-- Spacing on top of the shared dark theme (Grid-level so BasedOn resolves to the theme styles). -->
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Margin" Value="0,0,0,5"/></Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,0,0,12"/></Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,0,0,12"/></Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0,4,0,8"/></Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <!-- DockPanel fills with its LAST child: title and buttons are docked first, the list fills the rest.
             (The list used to come before the buttons, so it was docked Left and the buttons were stretched.) -->
        <DockPanel Margin="0,0,20,0">
            <TextBlock DockPanel.Dock="Top" Text="Actions" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,12,0,0">
                <Button Content="+ Thêm" Click="Add_Click" Margin="0,0,4,8"/>
                <Button Content="Xóa" Click="Remove_Click" Margin="4,0,0,8"/>
                <Button Content="Import" Click="Import_Click" Margin="0,0,4,0"/>
                <Button Content="Export" Click="Export_Click" Margin="4,0,0,0"/>
            </UniformGrid>
            <ListBox x:Name="ActionList" DisplayMemberPath="Name" SelectionChanged="ActionList_SelectionChanged" Background="#252525" Foreground="#FFFFFF" BorderBrush="#505050" Padding="2"/>
        </DockPanel>
        <StackPanel Grid.Column="1">
            <TextBlock Text="Chi tiết action" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,16"/>
            <TextBlock Text="Tên hiển thị"/><TextBox x:Name="NameText"/>
            <TextBlock Text="Phím tắt"/><TextBox x:Name="ShortcutText"/>
            <TextBlock Text="Operation"/><ComboBox x:Name="OperationCombo"><ComboBoxItem Content="Move"/><ComboBoxItem Content="Copy"/><ComboBoxItem Content="Recycle"/><ComboBoxItem Content="Delete"/></ComboBox>
            <TextBlock Text="Thư mục đích (relative hoặc absolute)"/><TextBox x:Name="DestinationText"/>
            <CheckBox x:Name="ConfirmCheck" Content="Luôn hỏi xác nhận trước khi thực hiện"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Hủy" IsCancel="True" Padding="16,7" Margin="0,0,8,0"/><Button Content="Áp dụng" IsDefault="True" Click="Apply_Click" Padding="18,7"/></StackPanel>
    </Grid>
</Window>
