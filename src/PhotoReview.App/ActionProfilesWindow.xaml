<Window x:Class="PhotoReview.App.ActionProfilesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PhotoReview.App.Localization" Title="{loc:Tr actionProfiles.title}" Width="820" Height="520" MinWidth="700" MinHeight="420" WindowStartupLocation="CenterOwner" Background="#171717" Foreground="#F5F5F5">
    <Window.Resources>
        <!-- Same look as SettingsWindow: dark inputs, spacing between fields. -->
        <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Foreground" Value="#E5E5E5"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Background" Value="#252525"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#505050"/><Setter Property="CaretBrush" Value="#FFFFFF"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E5E5E5"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,6"/></Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <!-- DockPanel fills with its LAST child: title and buttons are docked first, the list fills the rest.
             (The list used to come before the buttons, so it was docked Left and the buttons were stretched.) -->
        <DockPanel Margin="0,0,20,0">
            <TextBlock DockPanel.Dock="Top" Text="{loc:Tr actionProfiles.list.header}" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,12,0,0">
                <Button Content="{loc:Tr actionProfiles.add}" Click="Add_Click" Margin="0,0,4,8"/>
                <Button Content="{loc:Tr actionProfiles.remove}" Click="Remove_Click" Margin="4,0,0,8"/>
                <Button Content="{loc:Tr actionProfiles.import}" Click="Import_Click" Margin="0,0,4,0"/>
                <Button Content="{loc:Tr actionProfiles.export}" Click="Export_Click" Margin="4,0,0,0"/>
            </UniformGrid>
            <ListBox x:Name="ActionList" DisplayMemberPath="Name" SelectionChanged="ActionList_SelectionChanged" Background="#252525" Foreground="#FFFFFF" BorderBrush="#505050" Padding="2"/>
        </DockPanel>
        <StackPanel Grid.Column="1">
            <TextBlock Text="{loc:Tr actionProfiles.details.header}" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,16"/>
            <TextBlock Text="{loc:Tr actionProfiles.name.label}"/><TextBox x:Name="NameText"/>
            <TextBlock Text="{loc:Tr actionProfiles.shortcut.label}"/><TextBox x:Name="ShortcutText"/>
            <!-- Mapped by SelectedIndex in code-behind (0 Move, 1 Copy, 2 Recycle, 3 legacy Delete = Recycle): keep the order. -->
            <TextBlock Text="{loc:Tr actionProfiles.operation.label}"/><ComboBox x:Name="OperationCombo"><ComboBoxItem Content="{loc:Tr enum.fileOperation.move}"/><ComboBoxItem Content="{loc:Tr enum.fileOperation.copy}"/><ComboBoxItem Content="{loc:Tr enum.fileOperation.recycle}"/><ComboBoxItem Content="{loc:Tr enum.fileOperation.delete}"/></ComboBox>
            <TextBlock Text="{loc:Tr actionProfiles.destination.label}"/><TextBox x:Name="DestinationText"/>
            <CheckBox x:Name="ConfirmCheck" Content="{loc:Tr actionProfiles.confirm.label}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="{loc:Tr common.cancel}" IsCancel="True" Padding="16,7" Margin="0,0,8,0"/><Button Content="{loc:Tr common.apply}" IsDefault="True" Click="Apply_Click" Padding="18,7"/></StackPanel>
    </Grid>
</Window>
