<Window x:Class="PhotoReview.App.ActionProfilesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PhotoReview.App.Localization" Title="{loc:Tr actionProfiles.title}" Width="820" Height="520" MinWidth="700" MinHeight="420" WindowStartupLocation="CenterOwner" Background="{DynamicResource Dark.Window}" Foreground="{DynamicResource Dark.WindowText}">
    <Window.Resources><ResourceDictionary Source="/PhotoReview.App;component/Themes/DarkControls.xaml"/></Window.Resources>
    <Grid Margin="20">
        <Grid.Resources>
            <!-- Spacing on top of the shared dark theme (Grid-level so BasedOn resolves to the theme styles). -->
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Margin" Value="0,0,0,5"/></Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,0,0,12"/></Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,0,0,12"/></Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0,4,0,8"/></Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <!-- DockPanel fills with its LAST child: title and buttons are docked first, the list fills the rest.
             (The list used to come before the buttons, so it was docked Left and the buttons were stretched.) -->
        <DockPanel Margin="0,0,20,0">
            <TextBlock DockPanel.Dock="Top" Text="{loc:Tr actionProfiles.list.header}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Dark.TextStrong}" Margin="0,0,0,12"/>
            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,12,0,0">
                <Button Content="{loc:Tr actionProfiles.add}" Click="Add_Click" Margin="0,0,4,8"/>
                <Button Content="{loc:Tr actionProfiles.remove}" Click="Remove_Click" Margin="4,0,0,8"/>
                <Button Content="{loc:Tr actionProfiles.import}" Click="Import_Click" Margin="0,0,4,0"/>
                <Button Content="{loc:Tr actionProfiles.export}" Click="Export_Click" Margin="4,0,0,0"/>
            </UniformGrid>
            <ListBox x:Name="ActionList" DisplayMemberPath="Name" SelectionChanged="ActionList_SelectionChanged" Background="{DynamicResource Dark.Input}" Foreground="{DynamicResource Dark.TextStrong}" BorderBrush="{DynamicResource Dark.BorderStrong}" Padding="2"/>
        </DockPanel>
        <StackPanel Grid.Column="1">
            <TextBlock Text="{loc:Tr actionProfiles.details.header}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Dark.TextStrong}" Margin="0,0,0,16"/>
            <TextBlock x:Name="NameLabel" Text="{loc:Tr actionProfiles.name.label}"/><TextBox x:Name="NameText" AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"/>
            <TextBlock x:Name="ShortcutLabel" Text="{loc:Tr actionProfiles.shortcut.label}"/><TextBox x:Name="ShortcutText" AutomationProperties.LabeledBy="{Binding ElementName=ShortcutLabel}"/>
            <!-- Mapped by SelectedIndex in code-behind (0 Move, 1 Copy, 2 Recycle, 3 legacy Delete = Recycle): keep the order. -->
            <TextBlock x:Name="OperationLabel" Text="{loc:Tr actionProfiles.operation.label}"/><ComboBox x:Name="OperationCombo" AutomationProperties.LabeledBy="{Binding ElementName=OperationLabel}"><ComboBoxItem Content="{loc:Tr enum.fileOperation.move}"/><ComboBoxItem Content="{loc:Tr enum.fileOperation.copy}"/><ComboBoxItem Content="{loc:Tr enum.fileOperation.recycle}"/><ComboBoxItem Content="{loc:Tr enum.fileOperation.delete}"/></ComboBox>
            <TextBlock x:Name="DestinationLabel" Text="{loc:Tr actionProfiles.destination.label}"/><TextBox x:Name="DestinationText" AutomationProperties.LabeledBy="{Binding ElementName=DestinationLabel}"/>
            <CheckBox x:Name="ConfirmCheck" Content="{loc:Tr actionProfiles.confirm.label}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="{loc:Tr common.cancel}" IsCancel="True" Padding="16,7" Margin="0,0,8,0"/><Button Content="{loc:Tr common.apply}" IsDefault="True" Click="Apply_Click" Padding="18,7"/></StackPanel>
    </Grid>
</Window>
