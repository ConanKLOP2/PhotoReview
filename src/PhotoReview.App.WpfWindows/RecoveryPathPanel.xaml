<UserControl x:Class="PhotoReview.App.RecoveryPathPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PhotoReview.App.Localization">
    <Border Background="{DynamicResource Dark.Panel}" BorderBrush="{DynamicResource Dark.Border}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14"/>
            <TextBox x:Name="PathBox" AutomationProperties.LabeledBy="{Binding ElementName=TitleText}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,6,0,6" Padding="6,4" BorderThickness="1"/>
            <TextBlock x:Name="StatusText" FontWeight="SemiBold"/>
            <TextBlock x:Name="NowText" Foreground="{DynamicResource Dark.TextSoft}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="JournalText" Foreground="{DynamicResource Dark.TextMuted}" TextWrapping="Wrap"/>
            <TextBlock x:Name="NoteText" Foreground="{DynamicResource Dark.Caution}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="CopyButton" Content="{loc:Tr recovery.detail.copyPath}" AutomationProperties.Name="{loc:Tr recovery.detail.copyPath.automationName}" Click="Copy_Click" Padding="12,5" Margin="0,0,8,0"/>
                <Button x:Name="ShowButton" Content="{loc:Tr recovery.detail.showInExplorer}" AutomationProperties.Name="{loc:Tr recovery.detail.showInExplorer.automationName}" Click="Show_Click" Padding="12,5"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
