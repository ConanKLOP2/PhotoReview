<Project Sdk="Microsoft.NET.Sdk">

  <!-- NO-WPF-EXEC-PLAN mục 3 (WP-01, NE-5 = a, WP-19b): cầu nạp muộn cửa sổ phụ WPF (Settings, Recovery, ...) cho shell, cùng
       tiến trình. Project DUY NHẤT trong Shell.* được dùng WPF. WP-35 GĐ5: Shell.Win32 KHÔNG còn tham chiếu project này (mọi cửa sổ phụ là
       hộp thoại Win32 gốc); nó chỉ còn được dùng bởi test của nó cho tới khi WP-37 xoá. Không IsAotCompatible (WPF không AOT được). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- WP-34: [LibraryImport] (P/Invoke source-gen) cần unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoReview.Core\PhotoReview.Core.csproj" />
    <ProjectReference Include="..\PhotoReview.App.WpfWindows\PhotoReview.App.WpfWindows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PhotoReview.Shell.Tests" />
    <InternalsVisibleTo Include="PhotoReview.Shell.Integration.Tests" />
    <InternalsVisibleTo Include="PhotoReview.Shell.WpfBridge.Tests" />
  </ItemGroup>

</Project>
