<Project>

  <Import Project="..\Directory.Build.props" />

  <!-- Error-handling infra: VSTHRD analyzers for production code only (tests excluded). Only the rules
       enabled in .editorconfig (VSTHRD100 async void, VSTHRD110 unobserved async call) are active. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
