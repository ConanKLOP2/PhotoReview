<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoReview.Core\PhotoReview.Core.csproj" />
    <ProjectReference Include="..\PhotoReview.Imaging\PhotoReview.Imaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\native\x64\turbojpeg.dll" Link="turbojpeg.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="EnsureNativeBinaries" BeforeTargets="BeforeBuild;AssignTargetPaths">
    <PropertyGroup>
      <NativeDllPath>$(MSBuildThisFileDirectory)..\..\native\x64\turbojpeg.dll</NativeDllPath>
      <FetchScriptPath>$(MSBuildThisFileDirectory)..\..\tools\fetch-native.ps1</FetchScriptPath>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(FetchScriptPath)&quot;"
          Condition="!Exists('$(NativeDllPath)')" />
  </Target>

</Project>
