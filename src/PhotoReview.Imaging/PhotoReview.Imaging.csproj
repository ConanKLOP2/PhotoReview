<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- WP-02: PixelBuffer giữ bộ nhớ native (NativeMemory.AlignedAlloc, C-01) và PixelOps đọc/ghi qua con trỏ. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoReview.Core\PhotoReview.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="PhotoReview.Core.Model" />
    <Using Include="PhotoReview.Core.Abstractions" />
    <Using Include="PhotoReview.Core.Diagnostics" />
    <Using Include="PhotoReview.Imaging.Caching" />
    <Using Include="PhotoReview.Imaging.Decoding" />
    <Using Include="PhotoReview.Imaging.Preload" />
  </ItemGroup>

</Project>
