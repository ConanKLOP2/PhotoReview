<Project Sdk="Microsoft.NET.Sdk">

  <!-- NO-WPF-EXEC-PLAN mục 3 (WP-01): cửa sổ xem ảnh Win32 + Direct2D, exe PhotoReview.exe (NE-2 = a; bản WPF giữ
       PhotoReview.App.exe). WP-01: chỉ khung - hợp đồng C-11 (overlay), C-12 (host menu), C-15, C-16 (startup) và một
       cửa sổ trống; PhotoReview.exe với tham số smoke tạo + hiện cửa sổ rồi thoát mã 0. Không WPF (L-SHELL). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AssemblyName>PhotoReview</AssemblyName>
    <RootNamespace>PhotoReview.Shell.Win32</RootNamespace>
    <!-- PerMonitorV2 + comctl32 v6 (TaskDialogIndirect ở WP-19a). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- perf(startup): biên dịch trước (R2R) mã của exe và gói khi publish, như bản WPF (ảnh đầu không bị JIT chặn). Chỉ publish. -->
    <PublishReadyToRun Condition="'$(ShellAot)' != 'true'">true</PublishReadyToRun>
    <!-- WP-32 spike S1: `-p:ShellAot=true` publishes Native AOT (PublishAot is set here, not on the command line, so it does not
         flow to the netstandard analyzer projects, which NETSDK1207 rejects). -->
    <PublishAot Condition="'$(ShellAot)' == 'true'">true</PublishAot>
    <DefineConstants Condition="'$(ShellAot)' == 'true'">$(DefineConstants);SHELL_AOT</DefineConstants>
    <!-- Without this the AOT/trim feature switch is false: PhotoReviewPerf events are no-ops and PHOTOREVIEW_PERF_TRACE writes an empty CSV. -->
    <EventSourceSupport Condition="'$(ShellAot)' == 'true'">true</EventSourceSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- WP-30: the notices ship beside PhotoReview.exe too (the release folder is shared with the WPF app; same file, same bytes). -->
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoReview.Core\PhotoReview.Core.csproj" />
    <ProjectReference Include="..\PhotoReview.App.Shared\PhotoReview.App.Shared.csproj" />
    <ProjectReference Include="..\PhotoReview.Shell.Interop\PhotoReview.Shell.Interop.csproj" />
    <ProjectReference Include="..\PhotoReview.Shell.Rendering\PhotoReview.Shell.Rendering.csproj" />
    <!-- WP-19b (NE-5, L-SHELL): cầu cửa sổ phụ WPF nạp muộn; chỉ Dialogs/WpfBridgeLoader.cs chạm tới nó. -->
  </ItemGroup>

  <!-- WP-36: the WPF bridge (Settings/Diagnostics/Recovery secondary windows) is NOT part of the Native AOT variant: WPF cannot be
       AOT-compiled, and dropping the reference removes the WindowsDesktop framework from the publish folder (~20 MB, no .NET
       runtime needed). WpfBridgeLoader.cs is compiled out and SecondaryWindowPorts returns null (secondary windows no-op) until
       WP-35 replaces them. The default (hybrid R2R) build keeps the bridge. -->
  <ItemGroup Condition="'$(ShellAot)' != 'true'">
    <ProjectReference Include="..\PhotoReview.Shell.WpfBridge\PhotoReview.Shell.WpfBridge.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ShellAot)' == 'true'">
    <Compile Remove="Dialogs\WpfBridgeLoader.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PhotoReview.Shell.Tests" />
    <InternalsVisibleTo Include="PhotoReview.Shell.Integration.Tests" />
    <InternalsVisibleTo Include="PhotoReview.Shell.WpfBridge.Tests" />
  </ItemGroup>

</Project>
