<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- WP-34: analyzer AOT/trim bật; cổng thật là publish AOT của PhotoReview.exe (tools/check-aot-warnings.ps1). -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- WP-33: [LibraryImport] / [GeneratedComInterface] / con trỏ hàm unmanaged cần unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoReview.Core\PhotoReview.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="PhotoReview.Core.Model" />
    <Using Include="PhotoReview.Core.Abstractions" />
  </ItemGroup>

</Project>
