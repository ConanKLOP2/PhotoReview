"F06956"	"tests/PhotoReview.Core.Tests/Caching/BoundedLruCacheTests.cs"	"17"	"18"	"MethodDeclaration"	"BoundedLruCacheTests.[Fact(DisplayName = ""LRU retains recently accessed entry"")] public void LruRetainsRecentlyAccessedEntry()"	"STATIC-ONLY"	"Only checks seeded entry can be found; does not alone prove recency refresh. Companion LruEvictsLeastRecentlyUsedEntry exercises actual eviction after access. Mutation checks not run. BODY: [Fact(DisplayName = ""LRU retains recently accessed entry"")] public void LruRetainsRecentlyAccessedEntry() => Assert.True(Seeded().TryGet(""a"", out _));"
"F06957"	"tests/PhotoReview.Core.Tests/Caching/BoundedLruCacheTests.cs"	"20"	"27"	"MethodDeclaration"	"BoundedLruCacheTests.[Fact(DisplayName = ""LRU evicts least recently used entry"")] public void LruEvictsLeastRecentlyUsedEntry()"	"STATIC-ONLY"	"Touches a then inserts size2 c beyond capacity; missing b detects eviction of oldest rather than touched MRU. Does not assert a/c remain. Mutation checks not run. BODY: [Fact(DisplayName = ""LRU evicts least recently used entry"")] public void LruEvictsLeastRecentlyUsedEntry() { var cache = Seeded(); cache.TryGet(""a"", out _); cache.Set(""c"", ""cc""); Assert.False(cache.TryGet(""b"", out _)); }"
