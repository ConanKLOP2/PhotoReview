"F07383"	"tests/PhotoReview.Core.Tests/FileActions/FileActionSafetyEdgeTests.cs"	"74"	"92"	"MethodDeclaration"	"FileActionSafetyEdgeTests.[Fact(DisplayName = ""Two concurrent retries of one failed entry: the loser cannot leave the journal saying Failed for a completed move"")] public async Task RetryTwice_LoserDoesNotOverrideCommit()"	"STATIC-ONLY"	"Calls retry sequentially, not concurrently despite display name; validates stale failed snapshot after completed first call and empty pending/failed, not interleaving race. Mutation checks not run. BODY: [Fact(DisplayName = ""Two concurrent retries of one failed entry: the loser cannot leave the journal saying Failed for a completed move"")] public async Task RetryTwice_LoserDoesNotOverrideCommit() { var disk = new InMemoryFileSystem(); disk.AddFile(@""C:\photos\a.jpg"", ""12345"", Stamp); var clock = new Clock(); var journal = new OperationJournal(Paths, disk, clock); var failed = Move(""r1"", @""C:\photos\a.jpg"", @""C:\photos\sel\a.jpg"", JournalState.Failed); journal.Append(failed); var retry = new RecoveryRetryService(journal, disk, clock); var first = await retry.RetryMoveOrCopyAsync(failed); var second = await retry.RetryMoveOrCopyAsync(failed); // stale window: still holds the Failed entry Assert.True(first.Succeeded); Assert.False(second.Succeeded); Assert.Empty(journal.ReadFailedOperations()); Assert.Empty(journal.ReadPendingOperations()); }"
"F07384"	"tests/PhotoReview.Core.Tests/FileActions/FileActionSafetyEdgeTests.cs"	"94"	"112"	"MethodDeclaration"	"FileActionSafetyEdgeTests.[Fact(DisplayName = ""When the Prepared append fails nothing is moved and no orphan Failed record is written"")] public async Task PreparedAppendFails_NoMove_NoOrphanFailedRecord()"	"STATIC-ONLY"	"First append hook IO failure checks failed result, source present/destination absent and no orphan pending/failed; detects mutation before durable preparation. Mutation checks not run. BODY: [Fact(DisplayName = ""When the Prepared append fails nothing is moved and no orphan Failed record is written"")] public async Task PreparedAppendFails_NoMove_NoOrphanFailedRecord() { var disk = new InMemoryFileSystem(); disk.AddFile(@""C:\photos\a.jpg"", ""12345"", Stamp); var clock = new Clock(); var journal = new OperationJournal(Paths, disk, clock); var service = new FileActionService(journal, disk, clock, new Bin()); var failures = 1; disk.OpenAppendHook = _ => failures-- > 0 ? new IOException(""disk full"") : null; // only the first append fails var result = await service.ExecuteAsync(new FileActionRequest(@""C:\photos\a.jpg"", FileOperationType.Move, ""sel"")); Assert.False(result.Succeeded); Assert.True(disk.FileExists(@""C:\photos\a.jpg"")); Assert.False(disk.FileExists(@""C:\photos\sel\a.jpg"")); Assert.Empty(journal.ReadFailedOperations()); // a Failed record exists only for an operation whose Prepared is on disk Assert.Empty(journal.ReadPendingOperations()); }"
"F07385"	"tests/PhotoReview.Core.Tests/FileActions/FileActionSafetyEdgeTests.cs"	"103"	"103"	"SimpleLambdaExpression"	"FileActionSafetyEdgeTests.lambda in PreparedAppendFails_NoMove_NoOrphanFailedRecord"	"STATIC-ONLY"	"First append hook IO failure checks failed result, source present/destination absent and no orphan pending/failed; detects mutation before durable preparation. Mutation checks not run. BODY: disk.OpenAppendHook = _ => failures-- > 0 ? new IOException(""disk full"") : null; // only the first append fails"
"F07386"	"tests/PhotoReview.Core.Tests/FileActions/FileActionSafetyEdgeTests.cs"	"114"	"128"	"MethodDeclaration"	"FileActionSafetyEdgeTests.[Theory(DisplayName = ""A reconcile Failed that lands after the owner's Committed (cross-process race) does not resurrect the operation as failed"")] [InlineData(JournalErrors.PendingUnconfirmed)] [InlineData(JournalErrors.SourceStillExistsAfterRecovery)] public void StaleReconcileFailedAfterCommitted_IsIgnored(string code)"	"STATIC-ONLY"	"Manually appends committed then two stale reconcile error codes and asserts no failed/pending view; reader precedence, not live cross-process execution. Mutation checks not run. BODY: [Theory(DisplayName = ""A reconcile Failed that lands after the owner's Committed (cross-process race) does not resurrect the operation as failed"")] [InlineData(JournalErrors.PendingUnconfirmed)] [InlineData(JournalErrors.SourceStillExistsAfterRecovery)] public void StaleReconcileFailedAfterCommitted_IsIgnored(string code) { var disk = new InMemoryFileSystem(); var journal = new OperationJournal(Paths, disk, new Clock()); var prepared = Move(""race"", @""C:\photos\a.jpg"", @""C:\photos\sel\a.jpg"", JournalState.Prepared); journal.Append(prepared); journal.Append(prepared with { State = JournalState.Committed }); journal.Append(prepared with { State = JournalState.Failed, ErrorCode = code, Error = JournalErrors.EnglishText(code) }); Assert.Empty(journal.ReadFailedOperations()); Assert.Empty(journal.ReadPendingOperations()); }"
"F07387"	"tests/PhotoReview.Core.Tests/FileActions/FileActionSafetyEdgeTests.cs"	"130"	"140"	"MethodDeclaration"	"FileActionSafetyEdgeTests.[Fact(DisplayName = ""A genuine Failed after Committed (not a reconcile verdict) still counts"")] public void NonReconcileFailedAfterCommitted_StillWins()"	"STATIC-ONLY"	"Manual genuine Failed after Committed remains one failed item; complements stale-reconcile filtering so all later errors not wrongly dropped. Mutation checks not run. BODY: [Fact(DisplayName = ""A genuine Failed after Committed (not a reconcile verdict) still counts"")] public void NonReconcileFailedAfterCommitted_StillWins() { var disk = new InMemoryFileSystem(); var journal = new OperationJournal(Paths, disk, new Clock()); var prepared = Move(""x"", @""C:\photos\a.jpg"", @""C:\photos\sel\a.jpg"", JournalState.Prepared); journal.Append(prepared with { State = JournalState.Committed }); journal.Append(prepared with { State = JournalState.Failed, Error = ""boom"" }); Assert.Single(journal.ReadFailedOperations()); }"
"F07388"	"tests/PhotoReview.Core.Tests/FileActions/FileActionSafetyEdgeTests.cs"	"143"	"154"	"MethodDeclaration"	"FileActionSafetyEdgeTests.private static OperationJournal LargeJournal(InMemoryFileSystem disk)"	"STATIC-ONLY"	"Fixture pads journal over1MiB and explicitly asserts threshold to exercise reverse reader; machine JSON fixture, no actual disk I/O performance evidence. Mutation checks not run. BODY: private static OperationJournal LargeJournal(InMemoryFileSystem disk) { var text = new System.Text.StringBuilder(); for (var i = 0; i < 400; i++) { var pad = new JournalEntry(""pre"" + i, FileOperationType.Move, JournalState.Committed, $@""C:\old\{i}.jpg"", $@""C:\old\sel\{i}.jpg"", 10, Stamp, Stamp, new string('p', 3500)); text.Append(System.Text.Json.JsonSerializer.Serialize(pad)).AppendLine(); } disk.AddFile(Paths.JournalFile, text.ToString()); Assert.True(disk.GetFileStat(Paths.JournalFile)!.Length >= 1024 * 1024); return new OperationJournal(Paths, disk, new Clock()); }"
"F07389"	"tests/PhotoReview.Core.Tests/FileActions/FileActionSafetyEdgeTests.cs"	"156"	"169"	"MethodDeclaration"	"FileActionSafetyEdgeTests.[Fact(DisplayName = ""Large journal (reverse reader) and small journal agree when a stale reconcile Failed follows a Committed Move"")] public void StaleReconcileFailed_LargeJournal_SameViewAsSmall()"	"STATIC-ONLY"	"Fixture pads journal over1MiB and explicitly asserts threshold to exercise reverse reader; machine JSON fixture, no actual disk I/O performance evidence. Mutation checks not run. BODY: [Fact(DisplayName = ""Large journal (reverse reader) and small journal agree when a stale reconcile Failed follows a Committed Move"")] public void StaleReconcileFailed_LargeJournal_SameViewAsSmall() { var disk = new InMemoryFileSystem(); var journal = LargeJournal(disk); var prepared = Move(""race"", @""C:\photos.jpg"", @""C:\photos\sel.jpg"", JournalState.Prepared); journal.Append(prepared); journal.Append(prepared with { State = JournalState.Committed }); journal.Append(prepared with { State = JournalState.Failed, ErrorCode = JournalErrors.PendingUnconfirmed, Error = JournalErrors.EnglishText(JournalErrors.PendingUnconfirmed) }); Assert.Empty(journal.ReadFailedOperations()); Assert.Empty(journal.ReadPendingOperations()); Assert.Contains(journal.ReadCommittedMoves(), e => e.Id == ""race""); }"
