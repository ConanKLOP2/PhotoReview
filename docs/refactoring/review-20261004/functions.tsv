"F10302"	"tests/PhotoReview.Core.Tests/Settings/ViewerQuickSettingsTests.cs"	"25"	"37"	"MethodDeclaration"	"ViewerQuickSettingsTests.[Fact] public void Defaults_OverlaysOn_AndShortcutsEndD1I()"	"STATIC-ONLY"	"Literal boolean/key expectations cover overlay defaults and optional key assignments; no GUI overlay execution. Mutation checks not run. BODY: [Fact] public void Defaults_OverlaysOn_AndShortcutsEndD1I() { var settings = new AppSettings(); Assert.True(settings.ShowInfoOverlay); Assert.True(settings.ShowFileInfo); Assert.False(settings.ShowFolderInfo); Assert.Equal(""End"", settings.Shortcuts.LastImage); Assert.Equal(""D1"", settings.Shortcuts.ZoomActualSize); Assert.Equal(""I"", settings.Shortcuts.ToggleInfoOverlay); }"
