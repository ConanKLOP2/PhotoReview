"F09172"	"tests/PhotoReview.Core.Tests/IO/FileSystemCollisionContractTests.cs"	"59"	"73"	"MethodDeclaration"	"FileSystemCollisionContractTests.[Theory(DisplayName = ""Copy onto an existing file throws and keeps the existing destination bytes"")] [MemberData(nameof(Kinds))] public void Copy_DestinationExists_ThrowsAndKeepsBoth(string kind)"	"STATIC-ONLY"	"Physical/fake copy collision checks exact source and destination bytes after IOException, guarding overwrite mutation. Mutation checks not run. BODY: [Theory(DisplayName = ""Copy onto an existing file throws and keeps the existing destination bytes"")] [MemberData(nameof(Kinds))] public void Copy_DestinationExists_ThrowsAndKeepsBoth(string kind) { var (fs, dir) = Make(kind); var source = Path.Combine(dir, ""a.txt""); var destination = Path.Combine(dir, ""b.txt""); fs.WriteAllTextAtomic(source, ""source-bytes""); fs.WriteAllTextAtomic(destination, ""other-bytes""); Assert.ThrowsAny<IOException>(() => fs.Copy(source, destination)); Assert.Equal(""other-bytes"", fs.ReadAllText(destination)); Assert.Equal(""source-bytes"", fs.ReadAllText(source)); }"
