"F09189"	"tests/PhotoReview.Core.Tests/IO/FileSystemCollisionContractTests.cs"	"195"	"203"	"SimpleLambdaExpression"	"FileSystemCollisionContractTests.lambda in WriteAllTextAtomic_ConcurrentWriters_LeaveACompleteFile"	"STATIC-ONLY"	"Barrier synchronizes four temp-file writers,25 iterations, bounded30s joins; no failures, exact one full allowed text, no tmp files. Synchronization not fixed-delay polling. Mutation checks not run. BODY: threads.ForEach(t => t.Start());"
