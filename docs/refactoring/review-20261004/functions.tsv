"F09485"	"tests/PhotoReview.Core.Tests/Settings/SettingsParseTextTests.cs"	"16"	"30"	"MethodDeclaration"	"SettingsParseTextTests.[Fact] public void ParseText_MistypedValue_KeepsTheRestAndNamesTheDefaultedOne()"	"STATIC-ONLY"	"Bad click zoom salvaged while valid step40/Next/action retained; repair and SalvageCause check per-property salvage rather than whole reset. Mutation checks not run. BODY: [Fact] public void ParseText_MistypedValue_KeepsTheRestAndNamesTheDefaultedOne() { var result = SettingsStore.ParseText("""""" {""ConfigVersion"":3,""UiLanguage"":""en"",""ClickZoomPercent"":""abc"",""KeyboardZoomStepPercent"":40, ""Shortcuts"":{""Next"":""N""},""Actions"":[{""Name"":""Mine"",""Shortcut"":""K""}]} """"""); Assert.Equal(Defaults.ClickZoomPercent, result.Settings.ClickZoomPercent); Assert.Contains(nameof(AppSettings.ClickZoomPercent), result.Repairs); Assert.Equal(40, result.Settings.KeyboardZoomStepPercent); Assert.Equal(""N"", result.Settings.Shortcuts.Next); Assert.Equal(""Mine"", Assert.Single(result.Settings.Actions).Name); Assert.NotNull(result.SalvageCause); }"
"F09486"	"tests/PhotoReview.Core.Tests/Settings/SettingsParseTextTests.cs"	"32"	"40"	"MethodDeclaration"	"SettingsParseTextTests.[Fact] public void ParseText_UnparsableEnum_ResetsToDefaultAndReportsIt()"	"STATIC-ONLY"	"Bogus LoadingMode reset/reported while step40 retained; valid step is not range boundary coverage for CORE-03. Mutation checks not run. BODY: [Fact] public void ParseText_UnparsableEnum_ResetsToDefaultAndReportsIt() { var result = SettingsStore.ParseText(""""""{""ConfigVersion"":3,""LoadingMode"":""Bogus"",""KeyboardZoomStepPercent"":40}""""""); Assert.Equal(Defaults.LoadingMode, result.Settings.LoadingMode); Assert.Contains(nameof(AppSettings.LoadingMode), result.Repairs); Assert.Equal(40, result.Settings.KeyboardZoomStepPercent); }"
"F09487"	"tests/PhotoReview.Core.Tests/Settings/SettingsParseTextTests.cs"	"42"	"51"	"MethodDeclaration"	"SettingsParseTextTests.[Fact] public void ParseText_OutOfRangeNumber_IsResetAndReported()"	"STATIC-ONLY"	"Huge click zoom <=max and named repair without salvage/cause distinguishes normalization from deserialization failure; lower bound/exact clamp not asserted. Mutation checks not run. BODY: [Fact] public void ParseText_OutOfRangeNumber_IsResetAndReported() { var result = SettingsStore.ParseText(""""""{""ConfigVersion"":3,""ClickZoomPercent"":999999}""""""); Assert.True(result.Settings.ClickZoomPercent <= AppSettings.MaxClickZoomPercent); Assert.Contains(nameof(AppSettings.ClickZoomPercent), result.Repairs); Assert.Empty(result.Salvaged); Assert.Null(result.SalvageCause); }"
"F09488"	"tests/PhotoReview.Core.Tests/Settings/SettingsParseTextTests.cs"	"53"	"62"	"MethodDeclaration"	"SettingsParseTextTests.[Fact] public void ParseText_NoConfigVersionKey_IsTreatedAsLegacyAndMigrated()"	"STATIC-ONLY"	"Missing version migrates to current/vi and nonnull actions while preserving step40; version detection and defaults checked independently. Mutation checks not run. BODY: [Fact] public void ParseText_NoConfigVersionKey_IsTreatedAsLegacyAndMigrated() { var result = SettingsStore.ParseText(""""""{""KeyboardZoomStepPercent"":40}""""""); Assert.Equal(""vi"", result.Settings.UiLanguage); Assert.Equal(AppSettings.CurrentConfigVersion, result.Settings.ConfigVersion); Assert.NotNull(result.Settings.Actions); Assert.Equal(40, result.Settings.KeyboardZoomStepPercent); }"
"F09489"	"tests/PhotoReview.Core.Tests/Settings/SettingsParseTextTests.cs"	"64"	"70"	"MethodDeclaration"	"SettingsParseTextTests.[Fact] public void ParseText_ConfigVersion3_KeepsItsLanguage()"	"STATIC-ONLY"	"Version3 English retained; detects reapplying legacy language override to versioned settings. Mutation checks not run. BODY: [Fact] public void ParseText_ConfigVersion3_KeepsItsLanguage() { var result = SettingsStore.ParseText(""""""{""ConfigVersion"":3,""UiLanguage"":""en""}""""""); Assert.Equal(""en"", result.Settings.UiLanguage); }"
"F09490"	"tests/PhotoReview.Core.Tests/Settings/SettingsParseTextTests.cs"	"72"	"82"	"MethodDeclaration"	"SettingsParseTextTests.[Fact] public void ParseText_NewerConfigVersion_IsNotDowngradedOrRejected()"	"STATIC-ONLY"	"Future version and English retained with no repairs; unknown property ignored, no claim it is preserved on later save. Mutation checks not run. BODY: [Fact] public void ParseText_NewerConfigVersion_IsNotDowngradedOrRejected() { var newer = AppSettings.CurrentConfigVersion + 5; var result = SettingsStore.ParseText($$""""""{""ConfigVersion"":{{newer}},""UiLanguage"":""en"",""FutureThing"":1}""""""); Assert.Equal(newer, result.Settings.ConfigVersion); Assert.Equal(""en"", result.Settings.UiLanguage); Assert.Empty(result.Repairs); }"
"F09491"	"tests/PhotoReview.Core.Tests/Settings/SettingsParseTextTests.cs"	"84"	"93"	"MethodDeclaration"	"SettingsParseTextTests.[Fact] public void ParseText_ConflictingOptionalShortcut_IsDisabledAndReportedWithTheShortcutsPrefix()"	"STATIC-ONLY"	"Action K disables optional ToggleKeepZoom, reports prefixed Repairs and DisabledShortcuts while excluding ResetSettings; protects repair category separation. Mutation checks not run. BODY: [Fact] public void ParseText_ConflictingOptionalShortcut_IsDisabledAndReportedWithTheShortcutsPrefix() { var result = SettingsStore.ParseText(""""""{""ConfigVersion"":3,""Actions"":[{""Name"":""Mine"",""Shortcut"":""K""}]}""""""); Assert.Equal("""", result.Settings.Shortcuts.ToggleKeepZoom); // default ""K"" collides with the action Assert.Contains(""Shortcuts."" + nameof(ShortcutMappings.ToggleKeepZoom), result.Repairs); Assert.Contains(nameof(ShortcutMappings.ToggleKeepZoom), result.DisabledShortcuts); Assert.DoesNotContain(nameof(ShortcutMappings.ToggleKeepZoom), result.ResetSettings); }"
"F09492"	"tests/PhotoReview.Core.Tests/Settings/SettingsParseTextTests.cs"	"95"	"104"	"MethodDeclaration"	"SettingsParseTextTests.[Fact] public void ParseText_MissingKeys_FallBackToDefaultsWhileThePresentOnesAreKept()"	"STATIC-ONLY"	"Present step40 retained, missing click/delete defaults supplied and no repair; does not cover negative step or nonfinite font. Mutation checks not run. BODY: [Fact] public void ParseText_MissingKeys_FallBackToDefaultsWhileThePresentOnesAreKept() { var result = SettingsStore.ParseText(""""""{""ConfigVersion"":3,""UiLanguage"":""en"",""KeyboardZoomStepPercent"":40}""""""); Assert.Equal(40, result.Settings.KeyboardZoomStepPercent); Assert.Equal(Defaults.ClickZoomPercent, result.Settings.ClickZoomPercent); Assert.Equal(Defaults.ConfirmBeforeDelete, result.Settings.ConfirmBeforeDelete); Assert.Empty(result.Repairs); }"
