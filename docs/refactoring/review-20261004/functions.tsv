"F06922"	"tests/PhotoReview.Core.Tests/Abstractions/SystemClockTests.cs"	"8"	"19"	"MethodDeclaration"	"SystemClockTests.[Fact] public void UtcNowReturnsCurrentUtcDateTime()"	"STATIC-ONLY"	"Checks UTC kind and wall-clock bracket with 100ms tolerance; catches stale/local-kind clock but is not monotonic-clock or skew proof. Mutation checks not run. BODY: [Fact] public void UtcNowReturnsCurrentUtcDateTime() { var clock = SystemClock.Instance; var before = DateTime.UtcNow; var clockTime = clock.UtcNow; var after = DateTime.UtcNow; Assert.True(clockTime >= before.AddMilliseconds(-100)); Assert.True(clockTime <= after.AddMilliseconds(100)); Assert.Equal(DateTimeKind.Utc, clockTime.Kind); }"
"F06923"	"tests/PhotoReview.Core.Tests/Abstractions/VBlankEstimatorTests.cs"	"14"	"14"	"PropertyDeclaration"	"VBlankEstimatorTests.RefreshRates.get"	"STATIC-ONLY"	"Helper/lambda body inspected in complete test context: exact captured callback/value expression below supplies fixture or guarded call; has no independent test oracle. Mutation checks not run. BODY: public static TheoryData<double> RefreshRates => new() { 60.0, 75.0, 144.0, 240.0 };"
"F06924"	"tests/PhotoReview.Core.Tests/Abstractions/VBlankEstimatorTests.cs"	"16"	"16"	"MethodDeclaration"	"VBlankEstimatorTests.private static double Period(double hz)"	"STATIC-ONLY"	"Helper/lambda body inspected in complete test context: exact captured callback/value expression below supplies fixture or guarded call; has no independent test oracle. Mutation checks not run. BODY: private static double Period(double hz) => 1000 * TicksPerMs / hz;"
"F06925"	"tests/PhotoReview.Core.Tests/Abstractions/VBlankEstimatorTests.cs"	"18"	"29"	"MethodDeclaration"	"VBlankEstimatorTests.[Theory] [MemberData(nameof(RefreshRates))] public void ExactObservations_GiveThePeriodAndTheLatestVBlank(double hz)"	"STATIC-ONLY"	"Independent hz-derived period and last timestamp with 1 tick tolerance check period and phase, not merely non-null output. Mutation checks not run. BODY: [Theory] [MemberData(nameof(RefreshRates))] public void ExactObservations_GiveThePeriodAndTheLatestVBlank(double hz) { var estimator = new VBlankEstimator(); const long origin = 5_000_000; for (var i = 0; i < 20; i++) estimator.Add(origin + (long)Math.Round(i * Period(hz))); var timing = Assert.NotNull(estimator.Current); Assert.Equal(Period(hz), timing.RefreshPeriod, 1.0); Assert.Equal(origin + 19 * Period(hz), timing.LastVBlank, 1.0); }"
"F06926"	"tests/PhotoReview.Core.Tests/Abstractions/VBlankEstimatorTests.cs"	"31"	"51"	"MethodDeclaration"	"VBlankEstimatorTests.[Theory] [MemberData(nameof(RefreshRates))] public void LateWakeUpsAndMissedVBlanks_DoNotShiftTheGrid(double hz)"	"STATIC-ONLY"	"Supplies deterministic omitted observations/jitter and bounds both frequency and phase; no native display timing claim. Mutation checks not run. BODY: [Theory] [MemberData(nameof(RefreshRates))] public void LateWakeUpsAndMissedVBlanks_DoNotShiftTheGrid(double hz) { var estimator = new VBlankEstimator(); const long origin = 1_000_000; var last = 0L; double[] delaysMs = [0.3, 0.05, 1.2, 0.6, 0.1, 0.9, 0.2, 0.7, 0.4, 1.0, 0.15, 0.5]; for (var i = 0; i < 30; i++) { if (i is 7 or 8 or 21) continue; last = origin + (long)Math.Round(i * Period(hz)); estimator.Add(last + (long)(delaysMs[i % delaysMs.Length] * TicksPerMs)); } var timing = Assert.NotNull(estimator.Current); Assert.InRange(timing.RefreshPeriod, Period(hz) * 0.995, Period(hz) * 1.005); Assert.InRange(timing.LastVBlank - last, -0.1 * TicksPerMs, 0.2 * TicksPerMs); }"
"F06927"	"tests/PhotoReview.Core.Tests/Abstractions/VBlankEstimatorTests.cs"	"53"	"65"	"MethodDeclaration"	"VBlankEstimatorTests.[Fact] public void FewerThanTheMinimumSamples_GiveNoTiming()"	"STATIC-ONLY"	"Asserts null one sample before threshold, non-null at threshold, then null after reset; guards threshold and reset state. Mutation checks not run. BODY: [Fact] public void FewerThanTheMinimumSamples_GiveNoTiming() { var estimator = new VBlankEstimator(); for (var i = 0; i < VBlankEstimator.MinSamples - 1; i++) estimator.Add(1000 + i * 166_667L); Assert.Null(estimator.Current); estimator.Add(1000 + (VBlankEstimator.MinSamples - 1) * 166_667L); Assert.NotNull(estimator.Current); estimator.Reset(); Assert.Null(estimator.Current); }"
"F06928"	"tests/PhotoReview.Core.Tests/Abstractions/VBlankEstimatorTests.cs"	"67"	"89"	"MethodDeclaration"	"VBlankEstimatorTests.[Theory] [InlineData(60.0, 75.0)] [InlineData(75.0, 60.0)] [InlineData(144.0, 240.0)] public void ARefreshRateChange_IsFollowedWithinAFewRefreshes(double before, double after)"	"STATIC-ONLY"	"Seeds old capacity then eight new samples and verifies new period plus latest phase; protects adaptation across listed rates. Mutation checks not run. BODY: [Theory] [InlineData(60.0, 75.0)] [InlineData(75.0, 60.0)] [InlineData(144.0, 240.0)] public void ARefreshRateChange_IsFollowedWithinAFewRefreshes(double before, double after) { var estimator = new VBlankEstimator(); var t = 0.0; for (var i = 0; i < VBlankEstimator.Capacity; i++) { t += Period(before); estimator.Add((long)t); } for (var i = 0; i < 8; i++) { t += Period(after); estimator.Add((long)t); } var timing = Assert.NotNull(estimator.Current); Assert.InRange(timing.RefreshPeriod, Period(after) * 0.99, Period(after) * 1.01); Assert.Equal(t, timing.LastVBlank, 10.0); }"
"F06929"	"tests/PhotoReview.Core.Tests/Abstractions/VBlankEstimatorTests.cs"	"95"	"104"	"MethodDeclaration"	"VBlankEstimatorTests.[Fact] public void AnIntegerRatioRateChange_IsFollowedWithinTheSampleWindow()"	"STATIC-ONLY"	"240 to60 integer-ratio change over capacity detects mistaking missed pulses for permanently unchanged refresh. Mutation checks not run. BODY: [Fact] public void AnIntegerRatioRateChange_IsFollowedWithinTheSampleWindow() { var estimator = new VBlankEstimator(); var t = 0.0; for (var i = 0; i < VBlankEstimator.Capacity; i++) estimator.Add((long)(t += Period(240))); for (var i = 0; i < VBlankEstimator.Capacity; i++) estimator.Add((long)(t += Period(60))); Assert.InRange(Assert.NotNull(estimator.Current).RefreshPeriod, Period(60) * 0.99, Period(60) * 1.01); }"
"F06930"	"tests/PhotoReview.Core.Tests/Abstractions/VBlankEstimatorTests.cs"	"106"	"115"	"MethodDeclaration"	"VBlankEstimatorTests.[Fact] public void NonIncreasingTimestamps_AreIgnored()"	"STATIC-ONLY"	"Count and period after backwards sample guard dropping nonincreasing observations, rather than only estimator survival. Mutation checks not run. BODY: [Fact] public void NonIncreasingTimestamps_AreIgnored() { var estimator = new VBlankEstimator(); for (var i = 1; i <= 6; i++) estimator.Add(i * 100_000L); estimator.Add(300_000); Assert.Equal(6, estimator.Count); Assert.Equal(100_000, Assert.NotNull(estimator.Current).RefreshPeriod); }"
