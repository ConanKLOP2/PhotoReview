"F09937"	"tests/PhotoReview.Core.Tests/Settings/AppSettingsPocoTests.cs"	"9"	"26"	"MethodDeclaration"	"AppSettingsPocoTests.[Fact(DisplayName = ""Core AppSettings defaults match requirements"")] public void AppSettingsDefaults()"	"STATIC-ONLY"	"Literal schema/language/mode/RAW defaults checked; action list only nonempty rather than full shortcut contract. Mutation checks not run. BODY: [Fact(DisplayName = ""Core AppSettings defaults match requirements"")] public void AppSettingsDefaults() { var s = new AppSettings(); Assert.Equal(3, s.ConfigVersion); Assert.Equal(""auto"", s.UiLanguage); Assert.Equal(InitialViewMode.Fit, s.InitialViewMode); Assert.Equal(LoadingMode.Preview, s.LoadingMode); Assert.False(s.LoggingEnabled); Assert.Equal(ImageSortMode.Default, s.ImageSortMode); Assert.True(s.CompareHashEnabled); Assert.True(s.CompareSizeEnabled); Assert.NotEmpty(s.Actions); Assert.NotNull(s.Shortcuts); Assert.True(s.RawSupportEnabled); Assert.Equal(RawFullDecode.Never, s.RawFullDecode); Assert.Equal(RawPairMode.Separate, s.RawPairMode); }"
