"F09174"	"tests/PhotoReview.Core.Tests/IO/FileSystemCollisionContractTests.cs"	"43"	"57"	"MethodDeclaration"	"FileSystemCollisionContractTests.[Theory(DisplayName = ""Move onto a name differing only by case is a collision (Windows names are case-insensitive)"")] [MemberData(nameof(Kinds))] public void Move_DestinationDiffersByCaseOnly_IsACollision(string kind)"	"STATIC-ONLY"	"Physical/fake case-only collision checks destination bytes and source existence after failure; Windows filesystem-specific identity, temp fixture. Mutation checks not run. BODY: [Theory(DisplayName = ""Move onto a name differing only by case is a collision (Windows names are case-insensitive)"")] [MemberData(nameof(Kinds))] public void Move_DestinationDiffersByCaseOnly_IsACollision(string kind) { var (fs, dir) = Make(kind); var source = Path.Combine(dir, ""a.txt""); fs.WriteAllTextAtomic(source, ""source-bytes""); fs.WriteAllTextAtomic(Path.Combine(dir, ""Photo.JPG""), ""existing""); Assert.True(fs.FileExists(Path.Combine(dir, ""photo.jpg""))); Assert.ThrowsAny<IOException>(() => fs.Move(source, Path.Combine(dir, ""photo.jpg""))); Assert.Equal(""existing"", fs.ReadAllText(Path.Combine(dir, ""Photo.JPG""))); Assert.True(fs.FileExists(source)); }"
