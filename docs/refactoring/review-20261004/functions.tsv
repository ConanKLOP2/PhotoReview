"F10305"	"tests/PhotoReview.Core.Tests/Settings/ViewerQuickSettingsTests.cs"	"76"	"97"	"MethodDeclaration"	"ViewerQuickSettingsTests.[Fact] public void Load_OldConfigWithoutNewKeys_GetsDefaults()"	"STATIC-ONLY"	"Version3 partial config keeps logging and supplies specified overlays/optional keys; tests backward compatibility without legacy-version migration. Mutation checks not run. BODY: [Fact] public void Load_OldConfigWithoutNewKeys_GetsDefaults() { _fileSystem.WriteAllTextAtomic(_appPaths.ConfigFile, """""" { ""ConfigVersion"": 3, ""LoggingEnabled"": true, ""Shortcuts"": { ""Next"": ""Right"", ""Previous"": ""Left"" }, ""Actions"": [ { ""Name"": ""Keep"", ""Shortcut"": ""Enter"", ""Operation"": ""Move"", ""Destination"": ""Keep"" } ] } """"""); var loaded = NewStore().Load(); Assert.True(loaded.LoggingEnabled); Assert.True(loaded.ShowInfoOverlay); Assert.True(loaded.ShowFileInfo); Assert.False(loaded.ShowFolderInfo); Assert.Equal(""End"", loaded.Shortcuts.LastImage); Assert.Equal(""D1"", loaded.Shortcuts.ZoomActualSize); Assert.Equal(""I"", loaded.Shortcuts.ToggleInfoOverlay); }"
