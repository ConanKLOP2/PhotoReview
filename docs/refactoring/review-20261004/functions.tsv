"F06556"	"tests/PhotoReview.App.Tests/ViewModels/StatusFormatterTests.cs"	"8"	"21"	"MethodDeclaration"	"StatusFormatterTests.[Theory] [InlineData(0, ""0 byte"")] [InlineData(-100, ""0 byte"")] [InlineData(512, ""512 byte"")] [InlineData(1024, ""1 KB"")] [InlineData(1536, ""1.5 KB"")] [InlineData(1048576, ""1 MB"")] [InlineData(2500000, ""2.38 MB"")] [InlineData(1073741824L, ""1 GB"")] [InlineData(5368709120L, ""5 GB"")] public void FormatFileSize_FormatsAccurately(long bytes, string expected)"	"STATIC-ONLY"	"StatusFormatterTests.[Theory] [InlineData(0, ""0 byte"")] [InlineData(-100, ""0 byte"")] [InlineData(512, ""512 byte"")] [InlineData(1024, ""1 KB"")] [InlineData(1536, ""1.5 KB"")] [InlineData(1048576, ""1 MB"")] [InlineData(2500000, ""2.38 MB"")] [InlineData(1073741824L, ""1 GB"")] [InlineData(5368709120L, ""5 GB"")] public void FormatFileSize_FormatsAccurately(long bytes, string expected): Exact strings/size thresholds and negative-byte clamp guard Vietnamese formatting. NoSupportedImagesButSubfolders(1) self-equality assertion is tautological; subsequent inequality only guards count variation, not one-count wording. No alternate-culture test; ambient default localization dependency. Static reading only; no reviewer-run mutation proof. Body oracle: Assert.Equal(expected, StatusFormatter.FormatFileSize(bytes));"
"F06557"	"tests/PhotoReview.App.Tests/ViewModels/StatusFormatterTests.cs"	"23"	"34"	"MethodDeclaration"	"StatusFormatterTests.[Fact] public void ImageStatusMessages_MatchExactOriginalStrings()"	"STATIC-ONLY"	"StatusFormatterTests.[Fact] public void ImageStatusMessages_MatchExactOriginalStrings(): Exact strings/size thresholds and negative-byte clamp guard Vietnamese formatting. NoSupportedImagesButSubfolders(1) self-equality assertion is tautological; subsequent inequality only guards count variation, not one-count wording. No alternate-culture test; ambient default localization dependency. Static reading only; no reviewer-run mutation proof. Body oracle: Assert.Equal(""1/10"", StatusFormatter.IndexOnly(0, 10)); Assert.Equal(""1/10 · 1.5 MB · Đang tải"", StatusFormatter.Loading(0, 10, 1572864)); Assert.Equal(""1/10 · 1.5 MB · Đang tải độ phân giải đầy đủ"", StatusFormatter.LoadingFullRes(0, 10, 1572864)); Assert.Equal(""1/10 · 1.5 MB · photo.jpg"", StatusFormatter.Ready(0, 10, 1572864, ""photo.jpg"")); Assert.Equal(""1/10 · 1.5 MB · 1920×1080 · photo.jpg"", StatusFormatter.WithDimensions(0, 10, 1572864, 1920, 1080, ""photo.jpg"")); Assert.Equal(""1/10 | So sánh | left.jpg (1 MB) ↔ right.jpg (1 MB) [same hash] | nhấn để chọn"", Assert.Equal(""Lỗi ảnh: photo.jpg — File hỏng"", StatusFormatter.ImageError(""photo.jpg"", ""File hỏng""));"
"F06558"	"tests/PhotoReview.App.Tests/ViewModels/StatusFormatterTests.cs"	"36"	"56"	"MethodDeclaration"	"StatusFormatterTests.[Fact] public void FolderAndActionMessages_MatchExactOriginalStrings()"	"STATIC-ONLY"	"StatusFormatterTests.[Fact] public void FolderAndActionMessages_MatchExactOriginalStrings(): Exact strings/size thresholds and negative-byte clamp guard Vietnamese formatting. NoSupportedImagesButSubfolders(1) self-equality assertion is tautological; subsequent inequality only guards count variation, not one-count wording. No alternate-culture test; ambient default localization dependency. Static reading only; no reviewer-run mutation proof. Body oracle: Assert.Equal(""Không tìm thấy ảnh được hỗ trợ trong thư mục này."", StatusFormatter.NoSupportedImages()); Assert.Equal(StatusFormatter.NoSupportedImagesButSubfolders(1), StatusFormatter.NoSupportedImagesButSubfolders(1)); Assert.NotEqual(StatusFormatter.NoSupportedImages(), StatusFormatter.NoSupportedImagesButSubfolders(2)); Assert.NotEqual(StatusFormatter.NoSupportedImagesButSubfolders(1), StatusFormatter.NoSupportedImagesButSubfolders(2)); Assert.Equal(""Không mở được thư mục: Quyền truy cập bị từ chối"", StatusFormatter.FolderOpenFailed(""Quyền truy cập bị từ chối"")); Assert.Equal(""Không còn ảnh trong thư mục"", StatusFormatter.NoImagesRemaining()); Assert.Equal(""Đã xử lý hết ảnh trong thư mục."", StatusFormatter.AllImagesProcessed()); Assert.Equal(""Đã xóa cache ảnh xem trước."", StatusFormatter.CacheCleared()); Assert.Equal(""Đã hủy: thư mục đã thay đổi trong lúc kiểm tra trùng lặp."", StatusFormatter.DuplicateCheckCanceledFolderChanged()); Assert.Equal(""Không có bản trùng lặp nào cùng hash phù hợp."", StatusFormatter.NoDuplicatesFound()); Assert.Equal(""Đã hủy xử lý hàng loạt."", StatusFormatter.BatchCanceled()); Assert.Equal(""Xử lý hàng loạt hoàn tất: 5 thành công, 0 lỗi."", StatusFormatter.BatchDone(5, 0)); Assert.Equal(""Đã ở thư mục cuối cùng cùng cấp."", StatusFormatter.SiblingFolderBoundary(1)); Assert.Equal(""Đã ở thư mục đầu tiên cùng cấp."", StatusFormatter.SiblingFolderBoundary(-1)); Assert.Equal(""Đã thực hiện: Move to Keep"", StatusFormatter.ActionCompleted(""Move to Keep"")); Assert.Equal(""Không thực hiện được Move to Keep: thao tác không hợp lệ."", StatusFormatter.ActionInvalidOperation(""Move to Keep"")); Assert.Equal(""Không thực hiện được Move to Keep: Disk full"", StatusFormatter.ActionFailed(""Move to Keep"", ""Disk full""));"
"F06559"	"tests/PhotoReview.App.Tests/ViewModels/StatusTextEnglishTests.cs"	"16"	"27"	"MethodDeclaration"	"StatusTextEnglishTests.[Fact] public void ImageStatusMessages_RenderInEnglish()"	"ISSUE"	"StatusTextEnglishTests.[Fact] public void ImageStatusMessages_RenderInEnglish(): GlobalState localization tests cover English index/loading/full-res/dimensions/error, folder/action status and compare hash/size/status formatting through real CompareViewModel. No actual view binding/UI; numeric values follow CurrentCulture independently of Localizer, see APP-T06. Oracle read in context; no reviewer-run test. APP-T06 (locale-sensitive oracle): English Localizer does not change CultureInfo.CurrentCulture, while StatusFormatter formats sizes using CurrentCulture. Hard-coded 1.5 MB and 1,048,576 B expectations can fail under locales that use decimal comma/group dot; pin or derive the display culture."
