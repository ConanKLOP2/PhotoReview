"F07171"	"tests/PhotoReview.Core.Tests/Catalog/NaturalKeyReference.cs"	"12"	"23"	"MethodDeclaration"	"NaturalKeyReference.public static int Compare(string? x, string? y)"	"STATIC-ONLY"	"Independent original allocation-heavy reference compares keys ignorecase, then text ignorecase, then ordinal; preserves null ordering and deterministic ties for optimized comparer oracle. Mutation checks not run. BODY: public static int Compare(string? x, string? y) { if (ReferenceEquals(x, y)) return 0; if (x is null) return -1; if (y is null) return 1; var cmp = string.Compare(BuildNaturalKey(x), BuildNaturalKey(y), StringComparison.OrdinalIgnoreCase); if (cmp != 0) return cmp; var caseInsensitiveCmp = string.Compare(x, y, StringComparison.OrdinalIgnoreCase); if (caseInsensitiveCmp != 0) return caseInsensitiveCmp; return string.Compare(x, y, StringComparison.Ordinal); }"
"F07172"	"tests/PhotoReview.Core.Tests/Catalog/NaturalKeyReference.cs"	"25"	"50"	"MethodDeclaration"	"NaturalKeyReference.public static string BuildNaturalKey(string name)"	"STATIC-ONLY"	"Reference numeric runs use D10 length + trimmed digits + NUL, nonnumeric invariant lower; broad char.IsDigit includes non-ASCII whose digits remain unchanged. Compatibility oracle, not universal numeric-locale semantics. Mutation checks not run. BODY: public static string BuildNaturalKey(string name) { if (string.IsNullOrEmpty(name)) return string.Empty; var sb = new StringBuilder(name.Length + 16); for (var i = 0; i < name.Length;) { if (char.IsDigit(name[i])) { var start = i; while (i < name.Length && char.IsDigit(name[i])) i++; var digits = name.Substring(start, i - start).TrimStart('0'); sb.Append(digits.Length.ToString(""D10"", CultureInfo.InvariantCulture)); sb.Append(digits); sb.Append('\0'); } else { sb.Append(char.ToLowerInvariant(name[i])); i++; } } return sb.ToString(); }"
