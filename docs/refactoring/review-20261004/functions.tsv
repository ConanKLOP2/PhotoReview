"F08633"	"tests/PhotoReview.Core.Tests/IO/FileSystemCollisionContractTests.cs"	"75"	"89"	"MethodDeclaration"	"FileSystemCollisionContractTests.[Theory(DisplayName = ""TryCopyNew onto an existing file returns false and touches nothing"")] [MemberData(nameof(Kinds))] public void TryCopyNew_DestinationExists_ReturnsFalseAndKeepsBoth(string kind)"	"STATIC-ONLY"	"False return and both exact bytes protect classified collision contract; source intact, so no CORE-01 source-error/foreign-arrival combination. Mutation checks not run. BODY: [Theory(DisplayName = ""TryCopyNew onto an existing file returns false and touches nothing"")] [MemberData(nameof(Kinds))] public void TryCopyNew_DestinationExists_ReturnsFalseAndKeepsBoth(string kind) { var (fs, dir) = Make(kind); var source = Path.Combine(dir, ""a.txt""); var destination = Path.Combine(dir, ""b.txt""); fs.WriteAllTextAtomic(source, ""source-bytes""); fs.WriteAllTextAtomic(destination, ""other-bytes""); Assert.False(fs.TryCopyNew(source, destination)); Assert.Equal(""other-bytes"", fs.ReadAllText(destination)); Assert.Equal(""source-bytes"", fs.ReadAllText(source)); }"
"F08634"	"tests/PhotoReview.Core.Tests/IO/FileSystemCollisionContractTests.cs"	"91"	"104"	"MethodDeclaration"	"FileSystemCollisionContractTests.[Theory(DisplayName = ""TryCopyNew onto a free path copies and returns true"")] [MemberData(nameof(Kinds))] public void TryCopyNew_DestinationFree_CopiesAndReturnsTrue(string kind)"	"STATIC-ONLY"	"Successful true plus identical source/destination bytes tests create-new semantics on both adapters. Mutation checks not run. BODY: [Theory(DisplayName = ""TryCopyNew onto a free path copies and returns true"")] [MemberData(nameof(Kinds))] public void TryCopyNew_DestinationFree_CopiesAndReturnsTrue(string kind) { var (fs, dir) = Make(kind); var source = Path.Combine(dir, ""a.txt""); var destination = Path.Combine(dir, ""b.txt""); fs.WriteAllTextAtomic(source, ""source-bytes""); Assert.True(fs.TryCopyNew(source, destination)); Assert.Equal(""source-bytes"", fs.ReadAllText(destination)); Assert.Equal(""source-bytes"", fs.ReadAllText(source)); }"
"F08635"	"tests/PhotoReview.Core.Tests/IO/FileSystemCollisionContractTests.cs"	"106"	"117"	"MethodDeclaration"	"FileSystemCollisionContractTests.[Theory(DisplayName = ""Move into a missing folder throws DirectoryNotFound and keeps the source"")] [MemberData(nameof(Kinds))] public void Move_MissingDestinationFolder_KeepsSource(string kind)"	"STATIC-ONLY"	"Exact DirectoryNotFoundException and source bytes retained detect unsafe pre-delete or wrong exception classification. Mutation checks not run. BODY: [Theory(DisplayName = ""Move into a missing folder throws DirectoryNotFound and keeps the source"")] [MemberData(nameof(Kinds))] public void Move_MissingDestinationFolder_KeepsSource(string kind) { var (fs, dir) = Make(kind); var source = Path.Combine(dir, ""a.txt""); fs.WriteAllTextAtomic(source, ""source-bytes""); Assert.Throws<DirectoryNotFoundException>(() => fs.Move(source, Path.Combine(dir, ""nope"", ""a.txt""))); Assert.Equal(""source-bytes"", fs.ReadAllText(source)); }"
