"F06769"	"tests/PhotoReview.Core.Tests/Catalog/GenerationClockTests.cs"	"106"	"123"	"MethodDeclaration"	"GenerationClockTests.[Fact] public void ConcurrentStopForAction_IncrementsAllCountersWithoutLoss()"	"STATIC-ONLY"	"Parallel5000 StopForAction calls exact final three counts detects loss; no intermediate consistency assertion. Mutation checks not run. BODY: [Fact] public void ConcurrentStopForAction_IncrementsAllCountersWithoutLoss() { var clock = new GenerationClock(); const int iterations = 5_000; Parallel.For(0, iterations, _ => { clock.StopForAction(); }); Assert.Equal(iterations, clock.CurrentNavigation); Assert.Equal(iterations, clock.CurrentFolder); Assert.Equal(iterations, clock.CurrentInteraction); Assert.True(clock.IsNavigationCurrent(iterations)); Assert.True(clock.IsFolderCurrent(iterations)); Assert.True(clock.IsInteractionCurrent(iterations)); }"
