"F06680"	"tests/PhotoReview.Core.Tests/Catalog/ComparePairServiceTests.cs"	"61"	"88"	"MethodDeclaration"	"ComparePairServiceTests.[Fact(DisplayName = ""BuildIndex matches Find for every path in the catalog"")] public void BuildIndexMatchesFindForEveryPath()"	"STATIC-ONLY"	"Bulk index equals Find for originals/variants/unpaired/subfolder/PNG; shared oracle can retain shared defects, literal pair tests complement. Mutation checks not run. BODY: [Fact(DisplayName = ""BuildIndex matches Find for every path in the catalog"")] public void BuildIndexMatchesFindForEveryPath() { var files = new List<string> { @""C:\Photos\DSC0001.JPG"", @""C:\Photos\DSC0001 (1).JPG"", @""C:\Photos\DSC0001 (2).JPG"", @""C:\Photos\DSC0002.JPG"", @""C:\Photos\Other\DSC0001.JPG"", @""C:\Photos\DSC0003.PNG"", @""C:\Photos\DSC0003 (1).PNG"" }; var index = ComparePairService.BuildIndex(files); foreach (var path in files) { var expected = ComparePairService.Find(files, path); var found = index.TryGetValue(path, out var pair); Assert.Equal(expected is not null, found); if (expected is not null) { Assert.Equal(expected.Value.Left, pair.Left); Assert.Equal(expected.Value.Right, pair.Right); } } }"
"F06681"	"tests/PhotoReview.Core.Tests/Catalog/ComparePairServiceTests.cs"	"90"	"108"	"MethodDeclaration"	"ComparePairServiceTests.[Fact(DisplayName = ""BuildIndex pairs the original with the smallest-numbered variant"")] public void BuildIndexPairsOriginalWithSmallestNumbered()"	"STATIC-ONLY"	"Variants listed2 before1 still original pairs1; variant2 keeps own pair with original, exact literals guard numeric ordering. Mutation checks not run. BODY: [Fact(DisplayName = ""BuildIndex pairs the original with the smallest-numbered variant"")] public void BuildIndexPairsOriginalWithSmallestNumbered() { var files = new List<string> { @""C:\Photos\DSC0001.JPG"", @""C:\Photos\DSC0001 (2).JPG"", @""C:\Photos\DSC0001 (1).JPG"" }; var index = ComparePairService.BuildIndex(files); Assert.True(index.TryGetValue(@""C:\Photos\DSC0001.JPG"", out var fromOriginal)); Assert.Equal(@""C:\Photos\DSC0001 (1).JPG"", fromOriginal.Right); Assert.True(index.TryGetValue(@""C:\Photos\DSC0001 (2).JPG"", out var fromNumbered)); Assert.Equal(@""C:\Photos\DSC0001.JPG"", fromNumbered.Left); Assert.Equal(@""C:\Photos\DSC0001 (2).JPG"", fromNumbered.Right); }"
"F06682"	"tests/PhotoReview.Core.Tests/Catalog/ComparePairServiceTests.cs"	"110"	"115"	"MethodDeclaration"	"ComparePairServiceTests.[Fact(DisplayName = ""BuildIndex omits a lone original with no numbered variant"")] public void BuildIndexOmitsUnpairedOriginal()"	"STATIC-ONLY"	"Two unpaired stems produce empty index; guards spuriously self-indexing originals. Mutation checks not run. BODY: [Fact(DisplayName = ""BuildIndex omits a lone original with no numbered variant"")] public void BuildIndexOmitsUnpairedOriginal() { var index = ComparePairService.BuildIndex([@""C:\Photos\DSC0001.JPG"", @""C:\Photos\DSC0002.JPG""]); Assert.Empty(index); }"
"F06683"	"tests/PhotoReview.Core.Tests/Catalog/ComparePairServiceTests.cs"	"120"	"134"	"MethodDeclaration"	"ComparePairServiceTests.[Theory(DisplayName = ""BuildIndex matches Find when extension or folder case differs across entries"")] [InlineData(@""C:\Photos\DSC0001.JPG"", @""C:\Photos\DSC0001 (1).jpg"")] [InlineData(@""C:\Photos\DSC0001.JPG"", @""c:\photos\DSC0001 (1).JPG"")] public void BuildIndexMatchesFindWithMixedCase(string original, string variant)"	"STATIC-ONLY"	"Case variation in extension/folder yields nonnull Find and index same pair; verifies normalization agreement, literal files remain independent fixture. Mutation checks not run. BODY: [Theory(DisplayName = ""BuildIndex matches Find when extension or folder case differs across entries"")] [InlineData(@""C:\Photos\DSC0001.JPG"", @""C:\Photos\DSC0001 (1).jpg"")] [InlineData(@""C:\Photos\DSC0001.JPG"", @""c:\photos\DSC0001 (1).JPG"")] public void BuildIndexMatchesFindWithMixedCase(string original, string variant) { var files = new List<string> { original, variant }; var expected = ComparePairService.Find(files, original); Assert.NotNull(expected); var index = ComparePairService.BuildIndex(files); Assert.True(index.TryGetValue(original, out var pair)); Assert.Equal(expected.Value.Left, pair.Left); Assert.Equal(expected.Value.Right, pair.Right); }"
"F06684"	"tests/PhotoReview.Core.Tests/Catalog/DragDropInputServiceTests.cs"	"8"	"17"	"MethodDeclaration"	"DragDropInputServiceTests.[Fact] public void ParseEmptyOrNullReturnsInvalid()"	"STATIC-ONLY"	"Null/empty collection invalid, nullkind explicitlyInvalid; protects empty input guard. Mutation checks not run. BODY: [Fact] public void ParseEmptyOrNullReturnsInvalid() { var resultNull = DragDropInputService.Parse(null); Assert.False(resultNull.IsValid); Assert.Equal(DragDropInputKind.Invalid, resultNull.Kind); var resultEmpty = DragDropInputService.Parse([]); Assert.False(resultEmpty.IsValid); }"
"F06685"	"tests/PhotoReview.Core.Tests/Catalog/DragDropInputServiceTests.cs"	"19"	"28"	"MethodDeclaration"	"DragDropInputServiceTests.[Fact] public void ParseExistingDirectoryReturnsFolderKind()"	"STATIC-ONLY"	"Realtemp directory exactnormalizedfolder with validFolder; environmentfixture, not injected existence contract. Mutation checks not run. BODY: [Fact] public void ParseExistingDirectoryReturnsFolderKind() { var tempDir = Path.GetTempPath(); var result = DragDropInputService.Parse([tempDir]); Assert.True(result.IsValid); Assert.Equal(DragDropInputKind.Folder, result.Kind); Assert.Equal(Path.GetFullPath(tempDir), result.FolderPath); }"
"F06686"	"tests/PhotoReview.Core.Tests/Catalog/DragDropInputServiceTests.cs"	"30"	"42"	"MethodDeclaration"	"DragDropInputServiceTests.[Fact(DisplayName = ""Drag-drop image selects initial image"")] public void ParseImageFileReturnsImageKindWithInitialImage()"	"STATIC-ONLY"	"Existing tempJPG selects exactfolder/image and Imagekind; not image-content decodevalidation. Mutation checks not run. BODY: [Fact(DisplayName = ""Drag-drop image selects initial image"")] public void ParseImageFileReturnsImageKindWithInitialImage() { using var root = new TempRoot(""dragdrop""); var folder = root.Dir(""drag-folder""); var image = root.File(Path.Combine(""drag-folder"", ""first.JPG""), 1); var parsed = DragDropInputService.Parse([image]); Assert.Equal(DragDropInputKind.Image, parsed.Kind); Assert.Equal(folder, parsed.FolderPath); Assert.Equal(image, parsed.InitialImagePath); }"
"F06687"	"tests/PhotoReview.Core.Tests/Catalog/DragDropInputServiceTests.cs"	"44"	"50"	"MethodDeclaration"	"DragDropInputServiceTests.[Fact(DisplayName = ""Drag-drop rejects unsupported input"")] public void ParseUnsupportedFileIsInvalid()"	"STATIC-ONLY"	"notes.txt is nevercreated, so nonexistent-file guard can satisfy assertion even with broken unsupportedextensionfilter; needs existingunsupported fixture for that guard. Mutation checks not run. BODY: [Fact(DisplayName = ""Drag-drop rejects unsupported input"")] public void ParseUnsupportedFileIsInvalid() { using var root = new TempRoot(""dragdrop""); Assert.False(DragDropInputService.Parse([root.Combine(""notes.txt"")]).IsValid); }"
