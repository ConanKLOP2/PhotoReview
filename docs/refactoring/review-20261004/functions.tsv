"F06958"	"tests/PhotoReview.Core.Tests/Catalog/SortAndPairMutationGapTests.cs"	"56"	"67"	"MethodDeclaration"	"SortAndPairMutationGapTests.[Fact] public void Compare_NamesDifferingOnlyInCaseAndLeadingZeros_OrderByTheCaseInsensitiveTextBeforeTheOrdinalTie()"	"STATIC-ONLY"	"Literal a01/A1 and A1/a1 signs protect normalized numeric-key ties using case-insensitive text then ordinal, not simplistic equal-numeric values. Mutation checks not run. BODY: [Fact] public void Compare_NamesDifferingOnlyInCaseAndLeadingZeros_OrderByTheCaseInsensitiveTextBeforeTheOrdinalTie() { var comparer = ManagedNaturalComparer.Instance; Assert.True(comparer.Compare(""a01"", ""A1"") < 0); Assert.True(comparer.Compare(""A1"", ""a01"") > 0); Assert.True(comparer.Compare(""A1"", ""a1"") < 0); Assert.Equal(0, comparer.Compare(""a1"", ""a1"")); }"
