"F09178"	"tests/PhotoReview.Core.Tests/IO/FileSystemCollisionContractTests.cs"	"119"	"130"	"MethodDeclaration"	"FileSystemCollisionContractTests.[Theory(DisplayName = ""WriteAllTextAtomic replaces an existing file completely"")] [MemberData(nameof(Kinds))] public void WriteAllTextAtomic_Overwrite_ReplacesWholeContent(string kind)"	"STATIC-ONLY"	"Long then short replacement checks exactshort, detecting stale tail append/in-place incomplete truncate; not interrupted power-loss atomicity. Mutation checks not run. BODY: [Theory(DisplayName = ""WriteAllTextAtomic replaces an existing file completely"")] [MemberData(nameof(Kinds))] public void WriteAllTextAtomic_Overwrite_ReplacesWholeContent(string kind) { var (fs, dir) = Make(kind); var path = Path.Combine(dir, ""s.json""); fs.WriteAllTextAtomic(path, new string('x', 5000)); fs.WriteAllTextAtomic(path, ""short""); Assert.Equal(""short"", fs.ReadAllText(path)); }"
"F09179"	"tests/PhotoReview.Core.Tests/IO/FileSystemCollisionContractTests.cs"	"132"	"149"	"MethodDeclaration"	"FileSystemCollisionContractTests.[Fact(DisplayName = ""A path longer than 260 characters can be written, copied, moved, stat-ed and deleted"")] public void LongPath_FullLifecycle()"	"STATIC-ONLY"	"Over300 chars explicit assertion and write/copy/move/stat/delete cover temp realFS longpath operations; no NAS or directory symlink topology proof. Mutation checks not run. BODY: [Fact(DisplayName = ""A path longer than 260 characters can be written, copied, moved, stat-ed and deleted"")] public void LongPath_FullLifecycle() { var fs = new PhysicalFileSystem(); var deep = _root.Combine(string.Join(Path.DirectorySeparatorChar, Enumerable.Repeat(new string('d', 40), 8))); fs.CreateDirectory(deep); var file = Path.Combine(deep, new string('f', 60) + "".jpg""); Assert.True(file.Length > 300); fs.WriteAllTextAtomic(file, ""long""); fs.Copy(file, Path.Combine(deep, ""copy.jpg"")); fs.Move(file, Path.Combine(deep, ""moved.jpg"")); Assert.Equal(4, fs.GetFileStat(Path.Combine(deep, ""moved.jpg""))!.Length); Assert.False(fs.FileExists(file)); fs.Delete(Path.Combine(deep, ""copy.jpg"")); Assert.False(fs.FileExists(Path.Combine(deep, ""copy.jpg""))); }"
"F09180"	"tests/PhotoReview.Core.Tests/IO/FileSystemCollisionContractTests.cs"	"151"	"163"	"MethodDeclaration"	"FileSystemCollisionContractTests.[Fact(DisplayName = ""Copy onto a destination another process holds open fails and the source stays intact"")] public void Copy_DestinationLocked_FailsAndKeepsSource()"	"STATIC-ONLY"	"Exclusive destination handle with IOException and source length3 checks failure preservation; does not assert destinationbytes9 after unlock. Mutation checks not run. BODY: [Fact(DisplayName = ""Copy onto a destination another process holds open fails and the source stays intact"")] public void Copy_DestinationLocked_FailsAndKeepsSource() { var fs = new PhysicalFileSystem(); var source = _root.File(""a.txt"", 1, 2, 3); var destination = Path.Combine(_root.Path, ""b.txt""); File.WriteAllBytes(destination, [9]); using var lockHandle = new FileStream(destination, FileMode.Open, FileAccess.ReadWrite, FileShare.None); Assert.ThrowsAny<IOException>(() => fs.Copy(source, destination)); Assert.Equal(3, fs.GetFileStat(source)!.Length); }"
