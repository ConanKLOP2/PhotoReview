"F06561"	"tests/PhotoReview.Core.Tests/Abstractions/ImmediateUiSchedulerTests.cs"	"8"	"20"	"MethodDeclaration"	"ImmediateUiSchedulerTests.[Fact(DisplayName = ""RV-S07: InvokeAsync whose action throws returns a faulted task instead of throwing synchronously"")] public async Task InvokeAsync_ActionThrows_ReturnsFaultedTask()"	"STATIC-ONLY"	"Records synchronous call separately, then asserts IsFaulted and same original exception after await; would catch synchronous-throw or swallowed exception mutation. Mutation checks not run. BODY: [Fact(DisplayName = ""RV-S07: InvokeAsync whose action throws returns a faulted task instead of throwing synchronously"")] public async Task InvokeAsync_ActionThrows_ReturnsFaultedTask() { var failure = new InvalidOperationException(""boom""); Task? task = null; var syncException = Record.Exception(() => { task = ImmediateUiScheduler.Instance.InvokeAsync(() => throw failure); }); Assert.Null(syncException); Assert.NotNull(task); Assert.True(task!.IsFaulted); Assert.Same(failure, await Assert.ThrowsAsync<InvalidOperationException>(() => task)); }"
"F06562"	"tests/PhotoReview.Core.Tests/Abstractions/ImmediateUiSchedulerTests.cs"	"14"	"14"	"ParenthesizedLambdaExpression"	"ImmediateUiSchedulerTests.lambda in InvokeAsync_ActionThrows_ReturnsFaultedTask"	"STATIC-ONLY"	"Records synchronous call separately, then asserts IsFaulted and same original exception after await; would catch synchronous-throw or swallowed exception mutation. Mutation checks not run. BODY: var syncException = Record.Exception(() => { task = ImmediateUiScheduler.Instance.InvokeAsync(() => throw failure); });"
