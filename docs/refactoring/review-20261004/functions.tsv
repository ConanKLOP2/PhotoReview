"F06565"	"tests/PhotoReview.Core.Tests/Abstractions/ImmediateUiSchedulerTests.cs"	"22"	"32"	"MethodDeclaration"	"ImmediateUiSchedulerTests.[Fact(DisplayName = ""RV-S07: InvokeAsync still runs the action inline and completes"")] public async Task InvokeAsync_ActionSucceeds_RunsInlineAndCompletes()"	"STATIC-ONLY"	"Asserts action ran before awaiting and task already successful; would catch queued rather than inline scheduler change. Mutation checks not run. BODY: [Fact(DisplayName = ""RV-S07: InvokeAsync still runs the action inline and completes"")] public async Task InvokeAsync_ActionSucceeds_RunsInlineAndCompletes() { var ran = false; var task = ImmediateUiScheduler.Instance.InvokeAsync(() => ran = true); Assert.True(ran); Assert.True(task.IsCompletedSuccessfully); await task; }"
