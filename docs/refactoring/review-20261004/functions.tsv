"F07316"	"tests/PhotoReview.Core.Tests/Catalog/SortAndPairMutationGapTests.cs"	"56"	"67"	"MethodDeclaration"	"SortAndPairMutationGapTests.[Fact] public void Compare_NamesDifferingOnlyInCaseAndLeadingZeros_OrderByTheCaseInsensitiveTextBeforeTheOrdinalTie()"	"STATIC-ONLY"	"Literal a01/A1 and A1/a1 signs protect normalized numeric-key ties using case-insensitive text then ordinal, not simplistic equal-numeric values. Mutation checks not run. BODY: [Fact] public void Compare_NamesDifferingOnlyInCaseAndLeadingZeros_OrderByTheCaseInsensitiveTextBeforeTheOrdinalTie() { var comparer = ManagedNaturalComparer.Instance; Assert.True(comparer.Compare(""a01"", ""A1"") < 0); Assert.True(comparer.Compare(""A1"", ""a01"") > 0); Assert.True(comparer.Compare(""A1"", ""a1"") < 0); Assert.Equal(0, comparer.Compare(""a1"", ""a1"")); }"
"F07317"	"tests/PhotoReview.Core.Tests/Catalog/SortAndPairMutationGapTests.cs"	"69"	"74"	"MethodDeclaration"	"SortAndPairMutationGapTests.[Fact] public void BuildNaturalKey_NullOrEmpty_IsEmpty()"	"STATIC-ONLY"	"Null/empty exact empty key protects boundary without throwing. Mutation checks not run. BODY: [Fact] public void BuildNaturalKey_NullOrEmpty_IsEmpty() { Assert.Equal("""", ManagedNaturalComparer.BuildNaturalKey(null!)); Assert.Equal("""", ManagedNaturalComparer.BuildNaturalKey("""")); }"
"F07318"	"tests/PhotoReview.Core.Tests/Catalog/SortAndPairMutationGapTests.cs"	"76"	"86"	"MethodDeclaration"	"SortAndPairMutationGapTests.[Fact] public void BuildIndex_NumberedVariantsInPathOrderDifferentFromNumericOrder_PicksTheLowestNumber()"	"STATIC-ONLY"	"Listed10,2,3 variants must select literal2 despite lexical order; shared Find equivalence supplemented by independent exactpair. Mutation checks not run. BODY: [Fact] public void BuildIndex_NumberedVariantsInPathOrderDifferentFromNumericOrder_PicksTheLowestNumber() { var files = new[] { @""C:\p\a.jpg"", @""C:\p\a (10).jpg"", @""C:\p\a (2).jpg"", @""C:\p\a (3).jpg"" }; var index = ComparePairService.BuildIndex(files); var found = ComparePairService.Find(files, @""C:\p\a.jpg""); Assert.Equal((@""C:\p\a.jpg"", @""C:\p\a (2).jpg""), index[@""C:\p\a.jpg""]); Assert.Equal(found, index[@""C:\p\a.jpg""]); }"
"F07319"	"tests/PhotoReview.Core.Tests/Catalog/SortAndPairMutationGapTests.cs"	"88"	"97"	"MethodDeclaration"	"SortAndPairMutationGapTests.[Fact] public void BuildIndex_VariantsWithTheSameNumber_KeepTheirPathOrder()"	"STATIC-ONLY"	"a(01) exact selection over a(1) tests text/path tie policy, despite 1 appearing first in input; does not assert preserving input order. Mutation checks not run. BODY: [Fact] public void BuildIndex_VariantsWithTheSameNumber_KeepTheirPathOrder() { var files = new[] { @""C:\p\a.jpg"", @""C:\p\a (1).jpg"", @""C:\p\a (01).jpg"" }; var index = ComparePairService.BuildIndex(files); Assert.Equal(@""C:\p\a (01).jpg"", index[@""C:\p\a.jpg""].Right); Assert.Equal(ComparePairService.Find(files, @""C:\p\a.jpg""), index[@""C:\p\a.jpg""]); }"
