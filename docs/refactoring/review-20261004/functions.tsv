"F08729"	"tests/PhotoReview.Core.Tests/IO/PhysicalFileSystemTryCopyNewTests.cs"	"15"	"26"	"MethodDeclaration"	"PhysicalFileSystemTryCopyNewTests.[Fact] public void TryCopyNew_DestinationIsADirectory_ThrowsInsteadOfReportingFalse()"	"STATIC-ONLY"	"Destinationdirectory and source bytes retained; ThrowsAnyException does not prove specific access/directory classification, but false-return mutation fails. Mutation checks not run. BODY: [Fact] public void TryCopyNew_DestinationIsADirectory_ThrowsInsteadOfReportingFalse() { using var root = new TempRoot(""trycopynew-dir""); var source = root.File(""a.txt"", 1, 2, 3); var destination = root.Dir(""b.txt""); // a directory where the file would go Assert.ThrowsAny<Exception>(() => new PhysicalFileSystem().TryCopyNew(source, destination)); Assert.True(Directory.Exists(destination)); // untouched Assert.Equal([1, 2, 3], File.ReadAllBytes(source)); }"
