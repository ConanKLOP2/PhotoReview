"F09478"	"tests/PhotoReview.Core.Tests/Settings/SettingsNormalizerMutationGapTests.cs"	"82"	"91"	"MethodDeclaration"	"SettingsNormalizerMutationGapTests.[Fact] public void Normalize_UndefinedRawPairMode_IsResetToItsDefault()"	"STATIC-ONLY"	"Invalid pair enum reset and repair included; shares default source but verifies undefined values cannot persist. Mutation checks not run. BODY: [Fact] public void Normalize_UndefinedRawPairMode_IsResetToItsDefault() { var settings = new AppSettings { RawPairMode = (RawPairMode)99 }; var repaired = SettingsNormalizer.Normalize(settings); Assert.Contains(nameof(AppSettings.RawPairMode), repaired); Assert.Equal(new AppSettings().RawPairMode, settings.RawPairMode); }"
"F09479"	"tests/PhotoReview.Core.Tests/Settings/SettingsNormalizerMutationGapTests.cs"	"93"	"104"	"MethodDeclaration"	"SettingsNormalizerMutationGapTests.[Fact] public void Normalize_ActionWithUndefinedOperation_BecomesMoveAndIsReported()"	"STATIC-ONLY"	"Single invalid action becomes explicit Move with Actions repair name; no physical action executed. Mutation checks not run. BODY: [Fact] public void Normalize_ActionWithUndefinedOperation_BecomesMoveAndIsReported() { var settings = new AppSettings(); settings.Actions.Clear(); settings.Actions.Add(new ReviewAction { Name = ""A"", Shortcut = ""J"", Destination = @""C:\x"", Operation = (FileOperationType)99 }); var repaired = SettingsNormalizer.Normalize(settings); Assert.Contains(nameof(AppSettings.Actions), repaired); Assert.Equal(FileOperationType.Move, Assert.Single(settings.Actions).Operation); }"
"F09480"	"tests/PhotoReview.Core.Tests/Settings/SettingsNormalizerMutationGapTests.cs"	"106"	"117"	"MethodDeclaration"	"SettingsNormalizerMutationGapTests.[Fact] public void Normalize_ValidActions_AreNotReported()"	"STATIC-ONLY"	"Valid Copy action retains operation and absent Actions repair; complements invalid-op test to prevent overrepair. Mutation checks not run. BODY: [Fact] public void Normalize_ValidActions_AreNotReported() { var settings = new AppSettings(); settings.Actions.Clear(); settings.Actions.Add(new ReviewAction { Name = ""A"", Shortcut = ""J"", Destination = @""C:\x"", Operation = FileOperationType.Copy }); var repaired = SettingsNormalizer.Normalize(settings); Assert.DoesNotContain(nameof(AppSettings.Actions), repaired); Assert.Equal(FileOperationType.Copy, Assert.Single(settings.Actions).Operation); }"
