"F10309"	"tests/PhotoReview.Core.Tests/Settings/ViewerQuickSettingsTests.cs"	"76"	"97"	"MethodDeclaration"	"ViewerQuickSettingsTests.[Fact] public void Load_OldConfigWithoutNewKeys_GetsDefaults()"	"STATIC-ONLY"	"Version3 partial config keeps logging and supplies specified overlays/optional keys; tests backward compatibility without legacy-version migration. Mutation checks not run. BODY: [Fact] public void Load_OldConfigWithoutNewKeys_GetsDefaults() { _fileSystem.WriteAllTextAtomic(_appPaths.ConfigFile, """""" { ""ConfigVersion"": 3, ""LoggingEnabled"": true, ""Shortcuts"": { ""Next"": ""Right"", ""Previous"": ""Left"" }, ""Actions"": [ { ""Name"": ""Keep"", ""Shortcut"": ""Enter"", ""Operation"": ""Move"", ""Destination"": ""Keep"" } ] } """"""); var loaded = NewStore().Load(); Assert.True(loaded.LoggingEnabled); Assert.True(loaded.ShowInfoOverlay); Assert.True(loaded.ShowFileInfo); Assert.False(loaded.ShowFolderInfo); Assert.Equal(""End"", loaded.Shortcuts.LastImage); Assert.Equal(""D1"", loaded.Shortcuts.ZoomActualSize); Assert.Equal(""I"", loaded.Shortcuts.ToggleInfoOverlay); }"
"F10310"	"tests/PhotoReview.Core.Tests/Settings/ViewerQuickSettingsTests.cs"	"99"	"117"	"MethodDeclaration"	"ViewerQuickSettingsTests.[Fact] public void Load_OldConfigWhoseActionAlreadyUsesANewDefaultKey_DisablesOnlyThatOptionalShortcut()"	"STATIC-ONLY"	"D1 action retained, ZoomActualSize cleared, other optional keys retained and validator succeeds; protects action priority during new defaults. Mutation checks not run. BODY: [Fact] public void Load_OldConfigWhoseActionAlreadyUsesANewDefaultKey_DisablesOnlyThatOptionalShortcut() { _fileSystem.WriteAllTextAtomic(_appPaths.ConfigFile, """""" { ""ConfigVersion"": 3, ""Actions"": [ { ""Name"": ""Best"", ""Shortcut"": ""D1"", ""Operation"": ""Move"", ""Destination"": ""Best"" } ] } """"""); var loaded = NewStore().Load(); Assert.Equal("""", loaded.Shortcuts.ZoomActualSize); Assert.Equal(""End"", loaded.Shortcuts.LastImage); Assert.Equal(""I"", loaded.Shortcuts.ToggleInfoOverlay); Assert.Equal(""D1"", loaded.Actions[0].Shortcut); Assert.Null(new SettingsValidator(new AllKeysValid()).ValidateShortcuts(loaded)); }"
"F10311"	"tests/PhotoReview.Core.Tests/Settings/ViewerQuickSettingsTests.cs"	"119"	"136"	"MethodDeclaration"	"ViewerQuickSettingsTests.[Fact] public void Load_OldConfigWhoseActionAlreadyUsesClickZoomsNewDefaultKey_DisablesOnlyClickZoom()"	"STATIC-ONLY"	"D2 action wins over ClickZoom, D1 retained and validator succeeds; explicit collision resolution checked. Mutation checks not run. BODY: [Fact] public void Load_OldConfigWhoseActionAlreadyUsesClickZoomsNewDefaultKey_DisablesOnlyClickZoom() { _fileSystem.WriteAllTextAtomic(_appPaths.ConfigFile, """""" { ""ConfigVersion"": 3, ""Actions"": [ { ""Name"": ""Best"", ""Shortcut"": ""D2"", ""Operation"": ""Move"", ""Destination"": ""Best"" } ] } """"""); var loaded = NewStore().Load(); Assert.Equal("""", loaded.Shortcuts.ClickZoom); Assert.Equal(""D1"", loaded.Shortcuts.ZoomActualSize); Assert.Equal(""D2"", loaded.Actions[0].Shortcut); Assert.Null(new SettingsValidator(new AllKeysValid()).ValidateShortcuts(loaded)); }"
"F10312"	"tests/PhotoReview.Core.Tests/Settings/ViewerQuickSettingsTests.cs"	"138"	"148"	"MethodDeclaration"	"ViewerQuickSettingsTests.[Fact] public void DisableConflictingOptionalShortcuts_ConflictWithBuiltInShortcut_DisablesIt()"	"STATIC-ONLY"	"Lowercase c collides with uppercase mandatory Compare, exact one-name disabled list and cleared key protect ordinal-insensitive binding identity. Mutation checks not run. BODY: [Fact] public void DisableConflictingOptionalShortcuts_ConflictWithBuiltInShortcut_DisablesIt() { var settings = new AppSettings(); settings.Shortcuts.ToggleInfoOverlay = ""c""; // Compare is ""C"" (keys compare case-insensitively) var disabled = SettingsNormalizer.DisableConflictingOptionalShortcuts(settings); Assert.Equal(new[] { nameof(ShortcutMappings.ToggleInfoOverlay) }, disabled); Assert.Equal("""", settings.Shortcuts.ToggleInfoOverlay); }"
