"F08107"	"tests/PhotoReview.Core.Tests/FileActions/PermanentDeleteTests.cs"	"92"	"103"	"MethodDeclaration"	"PermanentDeleteTests.[Fact(DisplayName = ""No Recycle Bin and permanent delete not allowed: refused, file kept, nothing journaled"")] public async Task Recycle_NoRecycleBinNotAllowed_RefusesAndKeepsFile()"	"STATIC-ONLY"	"Permission omitted with unsupported booleanfalse checks exact error, source presence, zero mutation calls and empty journal; protects default deny. Mutation checks not run. BODY: [Fact(DisplayName = ""No Recycle Bin and permanent delete not allowed: refused, file kept, nothing journaled"")] public async Task Recycle_NoRecycleBinNotAllowed_RefusesAndKeepsFile() { var result = await _service.ExecuteAsync(new FileActionRequest(Photo, FileOperationType.Recycle)); Assert.False(result.Succeeded); Assert.Equal(Tr.CoreRecycleUnsupportedDrive(""a.jpg""), result.Error); Assert.True(_fs.FileExists(Photo)); Assert.Empty(_bin.Permanent); Assert.Empty(_bin.Recycled); Assert.Empty(JournalEntries()); }"
"F08108"	"tests/PhotoReview.Core.Tests/FileActions/PermanentDeleteTests.cs"	"105"	"118"	"MethodDeclaration"	"PermanentDeleteTests.[Fact(DisplayName = ""No Recycle Bin and allowed: deletes permanently; Prepared and Committed entries are marked Permanent"")] public async Task Recycle_NoRecycleBinAllowed_DeletesPermanentlyAndJournalsTruthfully()"	"STATIC-ONLY"	"Explicit permission and false eligibility checks file absent, exact permanent call, Prepared/Committed sequence and Permanent flags; no classifier unknown case. Mutation checks not run. BODY: [Fact(DisplayName = ""No Recycle Bin and allowed: deletes permanently; Prepared and Committed entries are marked Permanent"")] public async Task Recycle_NoRecycleBinAllowed_DeletesPermanentlyAndJournalsTruthfully() { var result = await _service.ExecuteAsync(new FileActionRequest(Photo, FileOperationType.Recycle, AllowPermanentDelete: true)); Assert.True(result.Succeeded, result.Error); Assert.True(result.PermanentlyDeleted); Assert.False(_fs.FileExists(Photo)); Assert.Equal(Photo, Assert.Single(_bin.Permanent)); Assert.Empty(_bin.Recycled); var entries = JournalEntries(); Assert.Equal([JournalState.Prepared, JournalState.Committed], entries.Select(e => e.State)); Assert.All(entries, e => Assert.True(e.Permanent)); }"
"F08109"	"tests/PhotoReview.Core.Tests/FileActions/PermanentDeleteTests.cs"	"116"	"116"	"SimpleLambdaExpression"	"PermanentDeleteTests.lambda in Recycle_NoRecycleBinAllowed_DeletesPermanentlyAndJournalsTruthfully"	"STATIC-ONLY"	"Explicit permission and false eligibility checks file absent, exact permanent call, Prepared/Committed sequence and Permanent flags; no classifier unknown case. Mutation checks not run. BODY: Assert.Equal([JournalState.Prepared, JournalState.Committed], entries.Select(e => e.State));"
"F08110"	"tests/PhotoReview.Core.Tests/FileActions/PermanentDeleteTests.cs"	"117"	"117"	"SimpleLambdaExpression"	"PermanentDeleteTests.lambda in Recycle_NoRecycleBinAllowed_DeletesPermanentlyAndJournalsTruthfully"	"STATIC-ONLY"	"Explicit permission and false eligibility checks file absent, exact permanent call, Prepared/Committed sequence and Permanent flags; no classifier unknown case. Mutation checks not run. BODY: Assert.All(entries, e => Assert.True(e.Permanent));"
"F08111"	"tests/PhotoReview.Core.Tests/FileActions/PermanentDeleteTests.cs"	"120"	"133"	"MethodDeclaration"	"PermanentDeleteTests.[Fact(DisplayName = ""Fixed drive (has a Recycle Bin): unchanged, recycled, entry not marked Permanent, flag ignored"")] public async Task Recycle_FixedDrive_UnchangedEvenWithFlag()"	"STATIC-ONLY"	"Eligibilitytrue plus permission still recycles, no permanent calls and null/omitted Permanent; permission must not bypass known fixed-drive safety. Mutation checks not run. BODY: [Fact(DisplayName = ""Fixed drive (has a Recycle Bin): unchanged, recycled, entry not marked Permanent, flag ignored"")] public async Task Recycle_FixedDrive_UnchangedEvenWithFlag() { _bin.HasRecycleBin = true; var result = await _service.ExecuteAsync(new FileActionRequest(Photo, FileOperationType.Recycle, AllowPermanentDelete: true)); Assert.True(result.Succeeded, result.Error); Assert.False(result.PermanentlyDeleted); Assert.Equal(Photo, Assert.Single(_bin.Recycled)); Assert.Empty(_bin.Permanent); Assert.All(JournalEntries(), e => Assert.Null(e.Permanent)); Assert.DoesNotContain(""Permanent"", _fs.ReadAllText(Journal), StringComparison.Ordinal); // omitted when null: old shape kept }"
"F08112"	"tests/PhotoReview.Core.Tests/FileActions/PermanentDeleteTests.cs"	"131"	"131"	"SimpleLambdaExpression"	"PermanentDeleteTests.lambda in Recycle_FixedDrive_UnchangedEvenWithFlag"	"STATIC-ONLY"	"Eligibilitytrue plus permission still recycles, no permanent calls and null/omitted Permanent; permission must not bypass known fixed-drive safety. Mutation checks not run. BODY: Assert.All(JournalEntries(), e => Assert.Null(e.Permanent));"
"F08113"	"tests/PhotoReview.Core.Tests/FileActions/PermanentDeleteTests.cs"	"135"	"152"	"MethodDeclaration"	"PermanentDeleteTests.[Theory(DisplayName = ""F-WIN-2: bin turned off or too small on a fixed drive: refused, file kept, nothing journaled, never deleted permanently"")] [InlineData(false)] [InlineData(true)] public async Task Recycle_BinCannotHoldFile_RefusesBeforeJournal(bool allowPermanentDelete)"	"STATIC-ONLY"	"Capacityfalse on eligibilitytrue rejects for both permission values, checks source/no calls/no journal; prevents overflow fallback to permanent. Mutation checks not run. BODY: [Theory(DisplayName = ""F-WIN-2: bin turned off or too small on a fixed drive: refused, file kept, nothing journaled, never deleted permanently"")] [InlineData(false)] [InlineData(true)] public async Task Recycle_BinCannotHoldFile_RefusesBeforeJournal(bool allowPermanentDelete) { _bin.HasRecycleBin = true; _bin.BinFits = false; var result = await _service.ExecuteAsync(new FileActionRequest(Photo, FileOperationType.Recycle, AllowPermanentDelete: allowPermanentDelete)); Assert.False(result.Succeeded); Assert.False(result.PermanentlyDeleted); Assert.Equal(Tr.CoreRecycleBinCannotHold(""a.jpg""), result.Error); Assert.True(_fs.FileExists(Photo)); Assert.Empty(_bin.Recycled); Assert.Empty(_bin.Permanent); Assert.Empty(JournalEntries()); }"
"F08114"	"tests/PhotoReview.Core.Tests/FileActions/PermanentDeleteTests.cs"	"154"	"165"	"MethodDeclaration"	"PermanentDeleteTests.[Fact(DisplayName = ""F-WIN-2: the capacity check gets the already-known file size and a fitting file is recycled as before"")] public async Task Recycle_BinFits_PassesStatSizeAndRecycles()"	"STATIC-ONLY"	"Capacity queried once exactPhoto,10 bytes, recycle once and Prepared/Committed verify stat reuse and successful transaction. Mutation checks not run. BODY: [Fact(DisplayName = ""F-WIN-2: the capacity check gets the already-known file size and a fitting file is recycled as before"")] public async Task Recycle_BinFits_PassesStatSizeAndRecycles() { _bin.HasRecycleBin = true; var result = await _service.ExecuteAsync(new FileActionRequest(Photo, FileOperationType.Recycle)); Assert.True(result.Succeeded, result.Error); Assert.Equal((Photo, 10L), Assert.Single(_bin.FitsQueries)); Assert.Equal(Photo, Assert.Single(_bin.Recycled)); Assert.Equal([JournalState.Prepared, JournalState.Committed], JournalEntries().Select(e => e.State)); }"
"F08115"	"tests/PhotoReview.Core.Tests/FileActions/PermanentDeleteTests.cs"	"164"	"164"	"SimpleLambdaExpression"	"PermanentDeleteTests.lambda in Recycle_BinFits_PassesStatSizeAndRecycles"	"STATIC-ONLY"	"Capacity queried once exactPhoto,10 bytes, recycle once and Prepared/Committed verify stat reuse and successful transaction. Mutation checks not run. BODY: Assert.Equal([JournalState.Prepared, JournalState.Committed], JournalEntries().Select(e => e.State));"
"F08116"	"tests/PhotoReview.Core.Tests/FileActions/PermanentDeleteTests.cs"	"167"	"177"	"MethodDeclaration"	"PermanentDeleteTests.[Fact(DisplayName = ""F-WIN-2: a drive without a Recycle Bin never asks the capacity check (permanent-delete path unchanged)"")] public async Task Recycle_NoRecycleBin_DoesNotAskCapacity()"	"STATIC-ONLY"	"Eligibilityfalse goes permanent without capacity query; fake cannot distinguish unknown drive classifier, potential Windows root gap survives. Mutation checks not run. BODY: [Fact(DisplayName = ""F-WIN-2: a drive without a Recycle Bin never asks the capacity check (permanent-delete path unchanged)"")] public async Task Recycle_NoRecycleBin_DoesNotAskCapacity() { _bin.BinFits = false; var result = await _service.ExecuteAsync(new FileActionRequest(Photo, FileOperationType.Recycle, AllowPermanentDelete: true)); Assert.True(result.Succeeded, result.Error); Assert.True(result.PermanentlyDeleted); Assert.Empty(_bin.FitsQueries); }"
"F08117"	"tests/PhotoReview.Core.Tests/FileActions/PermanentDeleteTests.cs"	"179"	"190"	"MethodDeclaration"	"PermanentDeleteTests.[Fact(DisplayName = ""Undo after a permanent delete reports it cannot restore and never asks the Recycle Bin"")] public async Task Undo_AfterPermanentDelete_SaysCannotRestore()"	"STATIC-ONLY"	"Registered permanent action yields exact cannot-restore error and zero bin restore calls; no bogus undo success offered. Mutation checks not run. BODY: [Fact(DisplayName = ""Undo after a permanent delete reports it cannot restore and never asks the Recycle Bin"")] public async Task Undo_AfterPermanentDelete_SaysCannotRestore() { var result = await _service.ExecuteAsync(new FileActionRequest(Photo, FileOperationType.Recycle, AllowPermanentDelete: true)); _undo.Register(result); var undo = await _undo.UndoLastAsync(); Assert.False(undo.Succeeded); Assert.Equal(Tr.CoreUndoPermanentlyDeleted(""a.jpg""), undo.ErrorMessage); Assert.Equal(0, _bin.RestoreCalls); }"
"F08118"	"tests/PhotoReview.Core.Tests/FileActions/PermanentDeleteTests.cs"	"192"	"203"	"MethodDeclaration"	"PermanentDeleteTests.[Fact(DisplayName = ""Undo after a normal recycle still restores through the Recycle Bin"")] public async Task Undo_AfterNormalRecycle_StillRestores()"	"STATIC-ONLY"	"Asserts success and one restore invocation; fake TryRestore returns true without recreating file, so physical restoration not verified. Mutation checks not run. BODY: [Fact(DisplayName = ""Undo after a normal recycle still restores through the Recycle Bin"")] public async Task Undo_AfterNormalRecycle_StillRestores() { _bin.HasRecycleBin = true; var result = await _service.ExecuteAsync(new FileActionRequest(Photo, FileOperationType.Recycle)); _undo.Register(result); var undo = await _undo.UndoLastAsync(); Assert.True(undo.Succeeded); Assert.Equal(1, _bin.RestoreCalls); }"
"F08119"	"tests/PhotoReview.Core.Tests/FileActions/PermanentDeleteTests.cs"	"205"	"216"	"MethodDeclaration"	"PermanentDeleteTests.[Theory(DisplayName = ""Recovery verdict for a Recycle entry: permanent + source missing = PermanentlyDeleted"")] [InlineData(true, false, RecoveryVerdict.PermanentlyDeleted)] [InlineData(null, false, RecoveryVerdict.RecycleUnverifiable)] [InlineData(true, true, RecoveryVerdict.NotRecycled)] public void Recovery_PermanentRecycle_VerdictReflectsPermanence(bool? permanent, bool sourcePresent, RecoveryVerdict expected)"	"STATIC-ONLY"	"Three metadata/source-existence combinations assert exact recovery verdict; no bin-content proof implied. Mutation checks not run. BODY: [Theory(DisplayName = ""Recovery verdict for a Recycle entry: permanent + source missing = PermanentlyDeleted"")] [InlineData(true, false, RecoveryVerdict.PermanentlyDeleted)] [InlineData(null, false, RecoveryVerdict.RecycleUnverifiable)] [InlineData(true, true, RecoveryVerdict.NotRecycled)] public void Recovery_PermanentRecycle_VerdictReflectsPermanence(bool? permanent, bool sourcePresent, RecoveryVerdict expected) { var fs = new InMemoryFileSystem(); if (sourcePresent) fs.AddFile(Photo, new byte[10], Stamp); var entry = new JournalEntry(""id"", FileOperationType.Recycle, JournalState.Committed, Photo, null, 10, Stamp, Stamp, Permanent: permanent); Assert.Equal(expected, new RecoveryFileCheck(fs).Check(entry).Verdict); }"
"F08120"	"tests/PhotoReview.Core.Tests/FileActions/PermanentDeleteTests.cs"	"218"	"234"	"MethodDeclaration"	"PermanentDeleteTests.[Fact(DisplayName = ""Setting defaults to off, round-trips through SettingsStore and an absent key loads as off"")] public void Setting_DefaultsOff_RoundTrips()"	"STATIC-ONLY"	"Literal defaultfalse, absent config keyfalse, persisted true and no normalizer repair protect intentional permission persistence. Mutation checks not run. BODY: [Fact(DisplayName = ""Setting defaults to off, round-trips through SettingsStore and an absent key loads as off"")] public void Setting_DefaultsOff_RoundTrips() { var fs = new InMemoryFileSystem(); var paths = new AppPaths(@""C:\Users\test\AppData\Local""); var store = new SettingsStore(paths, fs, PhotoReview.Core.Diagnostics.NullLog.Instance, (_, _) => { }); Assert.False(new AppSettings().AllowPermanentDeleteWithoutRecycleBin); fs.WriteAllTextAtomic(paths.ConfigFile, ""{ \""LoggingEnabled\"": true }""); Assert.False(store.Load().AllowPermanentDeleteWithoutRecycleBin); var on = new AppSettings { AllowPermanentDeleteWithoutRecycleBin = true }; store.Save(on); var reloaded = new SettingsStore(paths, fs, PhotoReview.Core.Diagnostics.NullLog.Instance, (_, _) => { }).Load(); Assert.True(reloaded.AllowPermanentDeleteWithoutRecycleBin); Assert.Empty(SettingsNormalizer.Normalize(reloaded)); }"
