new file mode 100644
index 00000000..554690e8
--- /dev/null
+++ b/src/PhotoReview.Shell.Rendering/StallKnobs.cs
@@ -0,0 +1,43 @@
+namespace PhotoReview.Shell.Rendering;
+
+/// <summary>
+/// WP21-STALL: các công tắc THÍ NGHIỆM (biến môi trường <c>PHOTOREVIEW_STALL_*</c>) để xác định nguyên nhân khung đơn lẻ bị
+/// <c>EndDraw</c> chặn 200-450 ms sau khoảng nghỉ. Đọc một lần khi tiến trình khởi động; mặc định = hành vi cũ.
+/// </summary>
+internal static class StallKnobs
+{
+    private static string? Get(string name) => Environment.GetEnvironmentVariable("PHOTOREVIEW_STALL_" + name);
+
+    private static int Int(string name, int fallback) => int.TryParse(Get(name), out var v) ? v : fallback;
+
+    /// <summary>"sequential" = FLIP_SEQUENTIAL; còn lại FLIP_DISCARD.</summary>
+    public static readonly string Swap = Get("SWAP") ?? "discard";
+
+    public static readonly int Buffers = Int("BUFFERS", 2);
+
+    /// <summary>0 = không đổi (dùng RenderSurfaceOptions); khác = ép MaximumFrameLatency.</summary>
+    public static readonly int Latency = Int("LATENCY", 0);
+
+    /// <summary>"after" | "before": ID3D11DeviceContext::Flush quanh Present.</summary>
+    public static readonly string Flush = Get("FLUSH") ?? string.Empty;
+
+    public static readonly bool D2dMultiThreaded = Get("D2DMT") == "1";
+
+    public static readonly bool D3dSingleThreaded = Get("D3DST") == "1";
+
+    /// <summary>"intel" | "nvidia" | "warp" | số thứ tự adapter DXGI; rỗng = mặc định.</summary>
+    public static readonly string Adapter = Get("ADAPTER") ?? string.Empty;
+
+    public static readonly bool DoNotWait = Get("DNW") == "1";
+
+    public static readonly bool Tearing = Get("TEARING") == "1";
+
+    /// <summary>"micro" (BeginDraw/Clear/EndDraw không Present) | "frame" (vẽ + Present lại) | rỗng.</summary>
+    public static readonly string Warm = Get("WARM") ?? string.Empty;
+
+    public static readonly int WarmForMs = Int("WARM_FOR", 600);
+
+    public static readonly int WarmEveryMs = Int("WARM_EVERY", 16);
+
+    public static readonly string? Log = Get("LOG");
+}
