diff --git a/src/PhotoReview.Shell.Rendering/GpuKeepAlive.cs b/src/PhotoReview.Shell.Rendering/GpuKeepAlive.cs
new file mode 100644
index 00000000..22ecea41
--- /dev/null
+++ b/src/PhotoReview.Shell.Rendering/GpuKeepAlive.cs
@@ -0,0 +1,141 @@
+using System.Diagnostics;
+using PhotoReview.Shell.Interop.Graphics;
+
+namespace PhotoReview.Shell.Rendering;
+
+/// <summary>
+/// WP21-STALL: giữ GPU "thức" bằng một luồng nền tiêu lệnh vẽ tí hon (thiết bị D3D/D2D riêng, đích offscreen 16x16, Flush) cách
+/// <c>intervalMs</c> trong khoảng <see cref="Activate"/> còn hiệu lực. Nguyên nhân gốc đã đo: sau khoảng nghỉ GPU (Intel UHD 630) lần
+/// nộp việc đầu tiên bị chặn ~0,47 s ở ~40 % số lần; nộp việc liên tục từ luồng khác thì luồng UI không bao giờ là luồng gặp
+/// lần nộp đó (và GPU không kịp nghỉ). Không có GPU thật (WARP) = không chạy. Mọi lỗi = tự tắt, không bao giờ ném ra ngoài.
+/// </summary>
+internal sealed class GpuKeepAlive : IDisposable
+{
+    private readonly int _intervalMs;
+    private readonly bool _preferWarp;
+    private readonly AutoResetEvent _wake = new(false);
+    private readonly object _gate = new();
+    private Thread? _thread;
+    private long _untilTimestamp;
+    private volatile bool _stop;
+    private volatile bool _failed;
+
+    public GpuKeepAlive(int intervalMs, bool preferWarp)
+    {
+        _intervalMs = Math.Clamp(intervalMs, 1, 1000);
+        _preferWarp = preferWarp;
+    }
+
+    /// <summary>Số lệnh tí hon đã nộp (chẩn đoán/test).</summary>
+    public long Ticks { get; private set; }
+
+    /// <summary>Đã tự tắt vì lỗi hoặc vì không có GPU thật.</summary>
+    public bool IsDisabled => _failed;
+
+    /// <summary>Kéo dài khoảng giữ ấm tới <paramref name="untilTimestamp"/> (Stopwatch ticks); khởi động luồng lần đầu.</summary>
+    public void Activate(long untilTimestamp)
+    {
+        if (_stop || _failed || _preferWarp)
+        {
+            return;
+        }
+
+        lock (_gate)
+        {
+            if (untilTimestamp > _untilTimestamp)
+            {
+                _untilTimestamp = untilTimestamp;
+            }
+
+            if (_thread is null)
+            {
+                _thread = new Thread(Run) { IsBackground = true, Name = "GpuKeepAlive", Priority = ThreadPriority.BelowNormal };
+                _thread.Start();
+            }
+        }
+
+        _wake.Set();
+    }
+
+    public void Dispose()
+    {
+        _stop = true;
+        _wake.Set();
+        Thread? thread;
+        lock (_gate)
+        {
+            thread = _thread;
+        }
+
+        thread?.Join(2000);
+        _wake.Dispose();
+    }
+
+    private unsafe void SleepAccurately(nint timer)
+    {
+        if (timer == 0)
+        {
+            Thread.Sleep(_intervalMs);
+            return;
+        }
+
+        long due = -(long)_intervalMs * 10_000; // 100 ns, âm = tương đối
+        if (GraphicsKernel32.SetWaitableTimer(timer, &due, 0, 0, 0, resume: false))
+        {
+            GraphicsKernel32.WaitForSingleObjectEx(timer, (uint)_intervalMs + 50, alertable: false);
+        }
+        else
+        {
+            Thread.Sleep(_intervalMs);
+        }
+    }
+
+    private void Run()
+    {
+        DeviceResources? resources = null;
+        try
+        {
+            resources = DeviceResources.CreateOffscreen(16, 16, 1.0, preferWarp: false);
+            if (resources.IsWarp)
+            {
+                _failed = true;
+                return;
+            }
+
+            nint timer = GraphicsKernel32.CreateWaitableTimerEx(0, 0, GraphicsKernel32.CreateWaitableTimerHighResolution, GraphicsKernel32.TimerAllAccess);
+            if (timer == 0)
+            {
+                timer = GraphicsKernel32.CreateWaitableTimerEx(0, 0, 0, GraphicsKernel32.TimerAllAccess);
+            }
+
+            try
+            {
+                while (!_stop)
+                {
+                    _wake.WaitOne();
+                    while (!_stop && Stopwatch.GetTimestamp() < Volatile.Read(ref _untilTimestamp))
+                    {
+                        resources.TouchGpu();
+                        Ticks++;
+                        SleepAccurately(timer);
+                    }
+                }
+            }
+            finally
+            {
+                if (timer != 0)
+                {
+                    GraphicsKernel32.CloseHandle(timer);
+                }
+            }
+        }
+        catch (Exception)
+        {
+            _failed = true; // thiết bị mất/không tạo được: giữ ấm là tối ưu, không phải chức năng
+        }
+        finally
+        {
+            resources?.Dispose();
+        }
+    }
+}
