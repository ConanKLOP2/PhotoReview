     /// <summary>CreateDXGIFactory2(flags, riid, void**). <paramref name="flags"/> 0, hoáº·c 1 = DEBUG.</summary>
     [LibraryImport("dxgi.dll", EntryPoint = "CreateDXGIFactory2")]
     public static partial int CreateDxgiFactory2(uint flags, in Guid riid, out nint factory);
+
+    /// <summary>
+    /// WP21-STALL: liệt kê adapter (IDXGIFactory1::EnumAdapters1). Trả con trỏ IDXGIAdapter thô (đã AddRef: người gọi
+    /// <see cref="System.Runtime.InteropServices.Marshal.Release"/>), tên, VendorId.
+    /// </summary>
+    public static unsafe List<(nint Adapter, string Name, uint Vendor)> EnumerateAdapters()
+    {
+        var list = new List<(nint, string, uint)>();
+        byte* desc = stackalloc byte[512];
+        Guid iid = typeof(IDxgiFactory1).GUID;
+        if (CreateDxgiFactory2(0, iid, out nint factoryRaw) < 0 || factoryRaw == 0)
+        {
+            return list;
+        }
+
+        IDxgiFactory1 factory = ComInterop.Wrap<IDxgiFactory1>(factoryRaw);
+        try
+        {
+            for (uint i = 0; factory.Reserved12EnumAdapters1(i, out nint adapterRaw) >= 0 && adapterRaw != 0; i++)
+            {
+                IDxgiAdapter adapter = ComInterop.Wrap<IDxgiAdapter>(adapterRaw);
+                string name = "?";
+                uint vendor = 0;
+                if (adapter.Reserved08GetDesc((nint)desc) >= 0)
+                {
+                    name = new string((char*)desc);
+                    vendor = *(uint*)(desc + 256);
+                }
+
+                // Giữ một ref thô cho người gọi, rồi trả wrapper (không Release ref của nó ở đây: Wrap sở hữu ref gốc).
+                nint raw = 0;
+                if (System.Runtime.InteropServices.ComWrappers.TryGetComInstance(adapter, out nint unknown))
+                {
+                    raw = ComInterop.QueryInterface(unknown, typeof(IDxgiAdapter).GUID);
+                    System.Runtime.InteropServices.Marshal.Release(unknown);
+                }
+
+                list.Add((raw, name, vendor));
+                ComInterop.Release(adapter);
+            }
+        }
+        finally
+        {
+            ComInterop.Release(factory);
+        }
+
+        return list;
+    }
 }
