root = true

[*]
indent_style = space
end_of_line = crlf
charset = utf-8
insert_final_newline = true

[*.cs]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
dotnet_style_prefer_collection_expression = true:suggestion

[*.xaml]
indent_size = 4

# CA1707 (identifiers should not contain underscores): scope to public API surface only.
# Test projects name methods `Method_Scenario_ExpectedResult` by deliberate convention
# (see AGENTS.md > Coding Conventions #2) — this keeps that pattern from being flagged
# for internal/test-only members while still catching underscores in real public APIs.
dotnet_code_quality.CA1707.api_surface = public

[tests/**.cs]
# Test methods are not public API consumed outside the assembly; the underscore
# naming convention (Method_Scenario_ExpectedResult) is intentional (AGENTS.md #2).
dotnet_diagnostic.CA1707.severity = none

[*.{csproj,props,slnx,json,yml}]
indent_size = 2

# ADR 0005 rule 2: Core/Imaging/Platform never resume on a captured context (review 2026-09-25, CORE-01)
[src/PhotoReview.{Core,Imaging,Imaging.TurboJpeg,Platform.Windows}/**.cs]
dotnet_diagnostic.CA2007.severity = error
